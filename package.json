{
  "name": "kreativ-auto",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Astro site for used-car inspection records and evidence-backed ownership guides.",
  "license": "MIT",
  "homepage": "https://kreativauto.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aolaru/kreativ-auto.git"
  },
  "bugs": {
    "url": "https://github.com/aolaru/kreativ-auto/issues"
  },
  "type": "module",
  "overrides": {
    "vite": "^7.1.12"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/promote-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "autopilot:add-next-car": "node scripts/autopilot/add-next-car.mjs",
    "autopilot:add-next-car:dry": "node scripts/autopilot/add-next-car.mjs --dry-run",
    "autopilot:daily-maintenance": "node scripts/autopilot/daily-maintenance.mjs",
    "autopilot:daily-maintenance:dry": "node scripts/autopilot/daily-maintenance.mjs --dry-run",
    "audit:commercial": "node scripts/audit-commercial-pages.mjs",
    "repo:health": "node scripts/check-repo-health.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
