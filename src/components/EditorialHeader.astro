---
interface Props {
  summary?: string;
  byline: string;
  reviewedLabel?: string;
  badges?: string[];
}

const { summary, byline, reviewedLabel, badges = [] } = Astro.props;
---

<div class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Editorial review</p>
      {summary && <p class="mt-3 text-sm leading-7 text-ink">{summary}</p>}
    </div>
    <div class="flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-steel">
      <span class="rounded-full bg-white px-3 py-2">{byline}</span>
      {reviewedLabel && <span class="rounded-full bg-white px-3 py-2">{reviewedLabel}</span>}
    </div>
  </div>

  {
    badges.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-3">
        {badges.map((badge) => <span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-steel">{badge}</span>)}
      </div>
    )
  }
</div>
