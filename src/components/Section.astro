---
interface Props {
  title: string;
  intro?: string;
  id?: string;
}

const { title, intro, id } = Astro.props;
---

<section id={id} class="surface p-6 sm:p-8">
  <div class="max-w-3xl">
    <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
    {intro && <p class="mt-3 text-base leading-7 text-steel">{intro}</p>}
  </div>
  <div class="mt-6">
    <slot />
  </div>
</section>
