---
interface Props {
  title?: string;
  summary: string;
  byline: string;
  checkedLabel?: string;
  points?: string[];
}

const { title = "Why trust this page", summary, byline, checkedLabel, points = [] } = Astro.props;
---

<aside class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">{title}</p>
      <p class="mt-3 text-base leading-7 text-ink">{summary}</p>
    </div>
    <div class="flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-steel">
      <span class="rounded-full bg-white px-3 py-2">{byline}</span>
      {checkedLabel && <span class="rounded-full bg-white px-3 py-2">{checkedLabel}</span>}
    </div>
  </div>

  {
    points.length > 0 && (
      <ul class="mt-5 grid gap-3 text-sm leading-6 text-steel md:grid-cols-3">
        {points.map((point) => <li class="rounded-2xl bg-white px-4 py-3">{point}</li>)}
      </ul>
    )
  }
</aside>
