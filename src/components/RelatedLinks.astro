---
interface LinkItem {
  href: string;
  title: string;
  description?: string;
  eyebrow?: string;
}

interface Props {
  title: string;
  intro?: string;
  items: LinkItem[];
}

const { title, intro, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
        {intro && <p class="mt-3 text-base leading-7 text-steel">{intro}</p>}
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          items.map((item) => (
            <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-accent/40 hover:bg-white" href={item.href}>
              {item.eyebrow && <p class="eyebrow">{item.eyebrow}</p>}
              <h3 class="mt-2 text-lg font-semibold text-ink">{item.title}</h3>
              {item.description && <p class="mt-2 text-sm leading-6 text-steel">{item.description}</p>}
            </a>
          ))
        }
      </div>
    </section>
  )
}
