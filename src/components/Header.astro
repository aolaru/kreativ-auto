---
import { getCollection } from "astro:content";
import { comparisonGuides } from "../data/comparison-guides";
import { ownershipGuides } from "../data/ownership-guides";
import { ownershipTasks } from "../data/ownership-tasks";
import { getGenerationLabel, getGenerationSlug, slugify } from "../utils/taxonomy";

const navItems = ownershipTasks.map((task) => ({
  href: task.href,
  label: task.label
}));

const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const getEntryPath = (entry: { id: string; slug?: string }) => entry.slug ?? entry.id.replace(/\.(md|mdx)$/i, "");
const uniqueByHref = <T extends { href: string }>(items: T[]) => {
  const seen = new Set<string>();

  return items.filter((item) => {
    if (seen.has(item.href)) return false;
    seen.add(item.href);
    return true;
  });
};
const brands = [...new Set(cars.map((entry) => entry.data.brand))].sort((a, b) => a.localeCompare(b));
const models = [...new Set(cars.map((entry) => `${entry.data.brand} ${entry.data.model}`))].sort((a, b) => a.localeCompare(b));
const generations = uniqueByHref(
  cars.map((entry) => ({
    title: getGenerationLabel(entry.data),
    href: `/generations/${getGenerationSlug(entry.data)}/`,
    description: `${entry.data.generationYears} ${entry.data.brand} ${entry.data.model} generation notes.`,
    type: "Generation",
    keywords: `${entry.data.brand} ${entry.data.model} ${entry.data.generation} ${entry.data.generationCode ?? ""} ${entry.data.generationYears}`,
    priority: 65
  }))
);
const categories = [...new Set(bestPages.map((entry) => entry.data.category))]
  .sort((a, b) => a.localeCompare(b))
  .map((category) => ({
    title: `${category} guides`,
    href: `/categories/${slugify(category)}/`,
    description: `Compare ${category.toLowerCase()} by vehicle and symptom.`,
    type: "Part category",
    keywords: category,
    priority: 58
  }));

const searchIndex = [
  ...cars.map((entry) => ({
    title: entry.data.title,
    href: `/cars/${getEntryPath(entry)}/`,
    description: entry.data.metaDescription,
    type: "Car",
    keywords: `${entry.data.brand} ${entry.data.model} ${entry.data.year} ${entry.data.generation} ${entry.data.generationCode ?? ""} ${entry.data.generationYears}`,
    priority: 100
  })),
  ...problems.map((entry) => ({
    title: entry.data.title,
    href: `/problems/${getEntryPath(entry)}/`,
    description: entry.data.metaDescription,
    type: "Problem guide",
    keywords: `${entry.data.symptoms.join(" ")} ${entry.data.causes.join(" ")} ${entry.data.relatedCars.join(" ")}`,
    priority: 75
  })),
  ...bestPages.map((entry) => ({
    title: entry.data.title,
    href: `/best/${getEntryPath(entry)}/`,
    description: entry.data.metaDescription,
    type: "Best parts",
    keywords: `${entry.data.car_model} ${entry.data.category} ${entry.data.relatedCars.join(" ")}`,
    priority: 50
  })),
  ...ownershipGuides.map((guide) => ({
    title: guide.title,
    href: guide.href,
    description: guide.description,
    type: guide.eyebrow,
    keywords: `${guide.eyebrow} ${guide.relatedCars?.join(" ") ?? ""} ${guide.relatedModels?.join(" ") ?? ""}`,
    priority: 85
  })),
  ...comparisonGuides.map((guide) => ({
    title: guide.title,
    href: guide.href,
    description: guide.description,
    type: guide.eyebrow,
    keywords: `${guide.eyebrow} ${guide.relatedCars?.join(" ") ?? ""} ${guide.relatedModels?.join(" ") ?? ""}`,
    priority: 70
  })),
  ...ownershipTasks.map((task) => ({
    title: task.title,
    href: task.href,
    description: task.description,
    type: "Ownership task",
    keywords: task.label,
    priority: 80
  })),
  ...brands.map((brand) => ({
    title: `${brand} cars`,
    href: `/brands/${slugify(brand)}/`,
    description: `Browse ${brand} cars, guides, problems, and parts comparisons.`,
    type: "Brand",
    keywords: brand,
    priority: 60
  })),
  ...models.map((model) => ({
    title: `${model} guides`,
    href: `/models/${slugify(model)}/`,
    description: `Open ${model} model-year and ownership pages.`,
    type: "Model",
    keywords: model,
    priority: 90
  })),
  ...generations,
  ...categories,
  {
    title: "Browse",
    href: "/browse/",
    description: "Browse by car, brand, model, generation, or parts category.",
    type: "Navigation",
    keywords: "cars brands models generations categories",
    priority: 45
  }
].filter((entry) => entry.title && entry.href);
---

<header class="relative z-40 border-b border-black/5 bg-white/85 backdrop-blur">
  <div class="container-shell py-4">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex min-w-0 items-center gap-3 text-ink">
        <a href="/" class="flex min-w-0 items-center gap-3 text-ink" data-ka-event="brand_click" data-ka-label="Kreativ Auto" data-ka-section="header">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-2xl ring-1 ring-black/6 shadow-[0_10px_24px_rgba(15,23,42,0.12)]">
            <img src="/images/logo-mark.svg" alt="Kreativ Auto" class="h-full w-full" width="44" height="44" />
          </span>
          <span class="min-w-0">
            <span class="block text-lg font-semibold">Kreativ Auto</span>
            <span class="block truncate text-sm text-steel">Diagnostics, ownership guides, and parts that fit the job</span>
          </span>
        </a>
      </div>

      <div class="flex flex-col gap-4 lg:min-w-[42rem] lg:flex-1 lg:items-end">
        <div class="header-search w-full lg:max-w-xl">
          <label class="sr-only" for="site-search">Search Kreativ Auto</label>
          <div class="header-search-shell">
            <svg
              aria-hidden="true"
              class="header-search-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              id="site-search"
              class="header-search-input"
              type="search"
              placeholder="Search by car, symptom, or part"
              autocomplete="off"
              spellcheck="false"
            />
            <button class="header-search-clear" type="button" aria-label="Clear search" hidden>Clear</button>
          </div>
          <div class="header-search-results" hidden>
            <p class="header-search-empty" hidden>No matching results found.</p>
            <ul class="header-search-list"></ul>
          </div>
          <script id="site-search-index" type="application/json" set:html={JSON.stringify(searchIndex)}></script>
        </div>

        <nav aria-label="Primary" class="hidden md:block">
          <ul class="flex flex-wrap items-center justify-end gap-6 text-sm font-medium text-steel">
            {
              navItems.map((item) => (
                <li>
                  <a class="transition hover:text-accent" href={item.href} data-ka-event="nav_click" data-ka-label={item.label} data-ka-section="header">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Mobile primary" class="md:hidden">
          <ul class="grid grid-cols-2 gap-2 text-sm font-semibold text-ink">
            {
              navItems.map((item) => (
                <li>
                  <a
                    class="block rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center transition hover:border-accent/40 hover:text-accent"
                    href={item.href}
                    data-ka-event="mobile_nav_click"
                    data-ka-label={item.label}
                    data-ka-section="header"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const searchIndexNode = document.getElementById("site-search-index");
  const searchInput = document.getElementById("site-search");
  const searchRoot = searchInput?.closest(".header-search");
  const searchResults = searchRoot?.querySelector(".header-search-results");
  const searchList = searchRoot?.querySelector(".header-search-list");
  const searchEmpty = searchRoot?.querySelector(".header-search-empty");
  const clearButton = searchRoot?.querySelector(".header-search-clear");

  if (searchIndexNode && searchInput && searchRoot && searchResults && searchList && searchEmpty && clearButton) {
    const entries = JSON.parse(searchIndexNode.textContent || "[]");
    let activeIndex = -1;
    let searchStartTracked = false;

    const scoreEntry = (entry, query) => {
      const haystackTitle = entry.title.toLowerCase();
      const haystackDescription = (entry.description || "").toLowerCase();
      const haystackType = entry.type.toLowerCase();
      const haystackKeywords = (entry.keywords || "").toLowerCase();
      const haystackHref = entry.href.toLowerCase().replaceAll("-", " ");
      const basePriority = Number(entry.priority || 0);

      if (haystackTitle === query) return 220 + basePriority;
      if (haystackTitle.startsWith(query)) return 180 + basePriority;
      if (haystackKeywords.split(/\s+/).includes(query)) return 155 + basePriority;
      if (haystackTitle.includes(query)) return 135 + basePriority;
      if (haystackHref.includes(query)) return 115 + basePriority;
      if (haystackKeywords.includes(query)) return 105 + basePriority;
      if (haystackType.includes(query)) return 55 + basePriority;
      if (haystackDescription.includes(query)) return 35 + basePriority;
      return -1;
    };

    const getMatches = (value) => {
      const query = value.trim().toLowerCase();
      if (!query) return [];

      return entries
        .map((entry) => ({ entry, score: scoreEntry(entry, query) }))
        .filter((item) => item.score >= 0)
        .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title))
        .slice(0, 8)
        .map((item) => item.entry);
    };

    const closeResults = () => {
      activeIndex = -1;
      searchResults.hidden = true;
      searchEmpty.hidden = true;
      searchList.innerHTML = "";
      searchRoot.classList.remove("is-open");
    };

    const renderResults = (matches) => {
      searchList.replaceChildren();

      let previousGroup = "";

      for (const [index, match] of matches.entries()) {
        const groupName = match.type.includes("parts")
          ? "Parts"
          : match.type.includes("guide") || match.type.includes("Comparison") || match.type.includes("Reliability") || match.type.includes("Maintenance")
            ? "Guides"
            : match.type.includes("Car") || match.type.includes("Model") || match.type.includes("Generation") || match.type.includes("Brand")
              ? "Vehicles"
              : "Other";

        if (groupName !== previousGroup) {
          const groupItem = document.createElement("li");
          groupItem.className = "header-search-group";
          groupItem.textContent = groupName;
          searchList.append(groupItem);
          previousGroup = groupName;
        }

        const item = document.createElement("li");
        const link = document.createElement("a");
        const type = document.createElement("span");
        const title = document.createElement("span");
        const description = document.createElement("span");

        link.className = "header-search-link";
        link.href = match.href;
        link.dataset.index = `${index}`;
        link.dataset.kaEvent = "search_result_click";
        link.dataset.kaLabel = match.title;
        link.dataset.kaSection = "header_search";

        type.className = "header-search-type";
        type.textContent = match.type;
        title.className = "header-search-title";
        title.textContent = match.title;
        description.className = "header-search-description";
        description.textContent = match.description || "";

        link.append(type, title, description);
        item.append(link);
        searchList.append(item);
      }
    };

    const updateActiveState = () => {
      const links = [...searchList.querySelectorAll(".header-search-link")];
      links.forEach((link, index) => {
        link.classList.toggle("is-active", index === activeIndex);
      });
    };

    const updateSearch = () => {
      const value = searchInput.value.trim();
      clearButton.hidden = !value;

      if (!value) {
        closeResults();
        return;
      }

      const matches = getMatches(value);
      activeIndex = matches.length ? 0 : -1;
      renderResults(matches);
      searchResults.hidden = false;
      searchRoot.classList.add("is-open");
      searchEmpty.hidden = matches.length > 0;
      updateActiveState();
    };

    searchInput.addEventListener("input", updateSearch);

    searchInput.addEventListener(
      "input",
      () => {
        if (!searchStartTracked && searchInput.value.trim().length >= 2) {
          searchStartTracked = true;
          window.kaTrackEvent?.("search_start", {
            event_label: "header search",
            search_length: searchInput.value.trim().length,
            section: "header_search"
          });
        }
      }
    );

    searchInput.addEventListener("keydown", (event) => {
      const links = [...searchList.querySelectorAll(".header-search-link")];
      if (!links.length && event.key !== "Escape") return;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        activeIndex = activeIndex < links.length - 1 ? activeIndex + 1 : 0;
        updateActiveState();
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();
        activeIndex = activeIndex > 0 ? activeIndex - 1 : links.length - 1;
        updateActiveState();
      }

      if (event.key === "Enter") {
        const activeLink = links[activeIndex] || links[0];
        if (activeLink) {
          event.preventDefault();
          const href = activeLink.getAttribute("href");
          if (href) {
            window.kaTrackEvent?.("search_result_click", {
              event_label: activeLink.querySelector(".header-search-title")?.textContent?.trim(),
              link_url: href,
              section: "header_search_keyboard"
            });
            window.location.href = href;
          }
        }
      }

      if (event.key === "Escape") {
        closeResults();
        searchInput.blur();
      }
    });

    clearButton.addEventListener("click", () => {
      searchInput.value = "";
      clearButton.hidden = true;
      closeResults();
      searchInput.focus();
    });

    document.addEventListener("click", (event) => {
      if (!searchRoot.contains(event.target)) {
        closeResults();
      }
    });

    searchInput.addEventListener("focus", () => {
      if (searchInput.value.trim()) {
        updateSearch();
      }
    });
  }
</script>
