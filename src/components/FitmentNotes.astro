---
interface FitmentNotes {
  appliesTo?: string[];
  doesNotApplyTo?: string[];
  phaseDifferences?: string[];
  powertrainDifferences?: string[];
}

interface Props {
  fitment: FitmentNotes;
}

const { fitment } = Astro.props;

const sections = [
  { title: "Which trims this applies to", items: fitment.appliesTo ?? [] },
  { title: "When this does not apply", items: fitment.doesNotApplyTo ?? [] },
  { title: "Pre-facelift vs facelift differences", items: fitment.phaseDifferences ?? [] },
  { title: "Hybrid vs gas differences", items: fitment.powertrainDifferences ?? [] }
].filter((section) => section.items.length > 0);
---

<div class="grid gap-4 lg:grid-cols-2">
  {
    sections.map((section) => (
      <div class="rounded-3xl bg-slate-50 p-5">
        <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-ink">{section.title}</h3>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {section.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))
  }
</div>
