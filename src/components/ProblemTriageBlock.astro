---
interface Props {
  canYouDrive?: string;
  quickVerdict?: string;
  estimatedCost?: string;
  firstCheck?: string;
  confusedWith?: string[];
  diyDifficulty?: string;
  stopDrivingIf?: string[];
}

const {
  canYouDrive,
  quickVerdict,
  estimatedCost,
  firstCheck,
  confusedWith = [],
  diyDifficulty,
  stopDrivingIf = []
} = Astro.props;

const decisionCards = [
  { label: "Quick verdict", value: quickVerdict, tone: "strong" },
  { label: "First thing to check", value: firstCheck, tone: "strong" },
  { label: "Can you drive it?", value: canYouDrive, tone: "muted" },
  { label: "Typical cost range", value: estimatedCost, tone: "muted" },
  { label: "DIY difficulty", value: diyDifficulty, tone: "muted" }
].filter((item) => item.value);

const hasContent = Boolean(decisionCards.length || confusedWith.length || stopDrivingIf.length);
---

{
  hasContent && (
    <div class="grid gap-4 lg:grid-cols-2">
      {decisionCards.map((item) => (
        <div
          class:list={[
            "rounded-3xl border p-6",
            item.tone === "strong" ? "border-orange-200/70 bg-orange-50/60" : "border-slate-200 bg-slate-50"
          ]}
        >
          <p class="eyebrow">{item.label}</p>
          <p class="mt-3 text-sm leading-6 text-ink">{item.value}</p>
        </div>
      ))}
      {
        confusedWith.length > 0 && (
          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <p class="eyebrow">Often confused with</p>
            <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
              {confusedWith.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )
      }
      {
        stopDrivingIf.length > 0 && (
          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <p class="eyebrow">Stop driving if</p>
            <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
              {stopDrivingIf.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )
      }
    </div>
  )
}
