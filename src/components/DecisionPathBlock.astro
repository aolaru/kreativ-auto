---
interface DecisionStep {
  trigger: string;
  check: string;
  nextStep: string;
}

interface Props {
  title?: string;
  intro?: string;
  steps: DecisionStep[];
}

const {
  title = "Decision path",
  intro = "Move from the symptom or shopping question to the next practical check before spending money.",
  steps
} = Astro.props;
---

{
  steps.length > 0 && (
    <section class="surface p-6 sm:p-8" id="decision-path">
      <div class="max-w-3xl">
        <p class="eyebrow">Decision path</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
        <p class="mt-3 text-base leading-7 text-steel">{intro}</p>
      </div>

      <div class="mt-6 grid gap-4">
        {steps.map((step, index) => (
          <article class="grid gap-4 rounded-3xl border border-slate-200 bg-white p-5 lg:grid-cols-[0.18fr_1fr_1fr_1fr]">
            <div>
              <p class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white">{index + 1}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel">If you see</p>
              <p class="mt-2 text-sm leading-6 text-ink">{step.trigger}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel">Check first</p>
              <p class="mt-2 text-sm leading-6 text-ink">{step.check}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-steel">Then decide</p>
              <p class="mt-2 text-sm leading-6 text-ink">{step.nextStep}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
