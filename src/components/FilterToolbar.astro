---
interface FilterOption {
  value: string;
  label: string;
}

interface FilterDefinition {
  name: string;
  label: string;
  options: FilterOption[];
}

interface Props {
  filters: FilterDefinition[];
  searchPlaceholder?: string;
}

const { filters, searchPlaceholder = "Search this section" } = Astro.props;
---

<div class="filter-toolbar" data-filter-controls>
  <label class="filter-field filter-field-search">
    <span class="filter-label">Search</span>
    <input
      class="filter-search-input"
      type="search"
      placeholder={searchPlaceholder}
      autocomplete="off"
      spellcheck="false"
      data-filter-search
    />
  </label>
  {filters.map((filter) => (
    <label class="filter-field">
      <span class="filter-label">{filter.label}</span>
      <select class="filter-select" data-filter-name={filter.name}>
        <option value="">All</option>
        {filter.options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </label>
  ))}
</div>

<script is:inline>
  const roots = Array.from(document.querySelectorAll("[data-filter-root]"));

  for (const root of roots) {
    if (root.dataset.filterInitialized === "true") continue;
    root.dataset.filterInitialized = "true";

    const controls = Array.from(root.querySelectorAll("[data-filter-name]"));
    const searchControl = root.querySelector("[data-filter-search]");
    const items = Array.from(root.querySelectorAll("[data-filter-item]"));
    const count = root.querySelector("[data-filter-count]");
    const emptyState = root.querySelector("[data-empty-state]");

    const applyFilters = () => {
      let visible = 0;
      const query = searchControl?.value.trim().toLowerCase() ?? "";

      for (const item of items) {
        const matchesSelects = controls.every((control) => {
          const name = control.getAttribute("data-filter-name");
          const activeValue = control.value;

          if (!name || !activeValue) return true;

          const raw = item.getAttribute(`data-filter-${name}`) ?? "";
          const values = raw
            .split("|")
            .map((value) => value.trim())
            .filter(Boolean);

          return values.includes(activeValue);
        });

        const searchHaystack = (item.getAttribute("data-filter-search-text") ?? "").toLowerCase();
        const matchesSearch = !query || searchHaystack.includes(query);
        const matches = matchesSelects && matchesSearch;

        item.hidden = !matches;

        if (matches) visible += 1;
      }

      if (count) {
        count.textContent = `${visible}`;
      }

      if (emptyState) {
        emptyState.hidden = visible > 0;
      }
    };

    for (const control of controls) {
      control.addEventListener("change", applyFilters);
    }

    searchControl?.addEventListener("input", applyFilters);

    applyFilters();
  }
</script>
