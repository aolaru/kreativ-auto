---
import { withAffiliateTag } from "../utils/affiliate";

interface Product {
  name: string;
  price: string;
  rating: number;
  affiliate_url: string;
  summary?: string;
  image?: string;
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const productUrl = withAffiliateTag(product.affiliate_url);
---

<article class="surface flex h-full flex-col p-6">
  {
    product.image && (
      <div class="mb-5 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
        <img
          src={product.image}
          alt={product.name}
          class="h-48 w-full object-cover"
          loading="lazy"
          width="720"
          height="480"
        />
      </div>
    )
  }

  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-semibold text-ink">{product.name}</h3>
      {product.summary && <p class="mt-2 text-sm leading-6 text-steel">{product.summary}</p>}
    </div>
    <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-700">
      {product.rating.toFixed(1)} / 5
    </span>
  </div>

  <div class="mt-6 flex items-center justify-between gap-4 border-t border-slate-200 pt-4">
    <p class="text-base font-semibold text-ink">{product.price}</p>
    <a
      class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent"
      href={productUrl}
      rel="nofollow sponsored"
      target="_blank"
      data-ka-event="product_click"
      data-ka-section="product_card"
      data-ka-label={product.name}
    >
      View product
    </a>
  </div>
</article>
