---
interface Props {
  quickVerdict?: string;
  bestFor?: string[];
  avoidIf?: string[];
  buyingTiers?: Array<{
    label: string;
    product: string;
    reason: string;
  }>;
}

const {
  quickVerdict,
  bestFor = [],
  avoidIf = [],
  buyingTiers = []
} = Astro.props;

const hasContent = Boolean(quickVerdict || bestFor.length || avoidIf.length || buyingTiers.length);
---

{
  hasContent && (
    <div class="space-y-4">
      <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr_0.9fr]">
        {
          quickVerdict && (
            <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
              <p class="eyebrow">Quick verdict</p>
              <p class="mt-3 text-sm leading-6 text-ink">{quickVerdict}</p>
            </div>
          )
        }
        {
          bestFor.length > 0 && (
            <div class="rounded-3xl border border-slate-200 bg-white p-6">
              <p class="eyebrow">Best for</p>
              <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
                {bestFor.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )
        }
        {
          avoidIf.length > 0 && (
            <div class="rounded-3xl border border-slate-200 bg-white p-6">
              <p class="eyebrow">Avoid if</p>
              <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
                {avoidIf.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )
        }
      </div>

      {
        buyingTiers.length > 0 && (
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {buyingTiers.map((tier) => (
              <div class="rounded-3xl border border-slate-200 bg-white p-6">
                <p class="eyebrow">{tier.label}</p>
                <p class="mt-3 text-base font-semibold text-ink">{tier.product}</p>
                <p class="mt-2 text-sm leading-6 text-steel">{tier.reason}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  )
}
