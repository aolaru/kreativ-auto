---
interface Props {
  quickVerdict?: string;
  bestFor?: string[];
  avoidIf?: string[];
}

const {
  quickVerdict,
  bestFor = [],
  avoidIf = []
} = Astro.props;

const hasContent = Boolean(quickVerdict || bestFor.length || avoidIf.length);
---

{
  hasContent && (
    <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr_0.9fr]">
      {
        quickVerdict && (
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
            <p class="eyebrow">Quick verdict</p>
            <p class="mt-3 text-sm leading-6 text-ink">{quickVerdict}</p>
          </div>
        )
      }
      {
        bestFor.length > 0 && (
          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <p class="eyebrow">Best for</p>
            <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
              {bestFor.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )
      }
      {
        avoidIf.length > 0 && (
          <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <p class="eyebrow">Avoid if</p>
            <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
              {avoidIf.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )
      }
    </div>
  )
}
