---
interface Props {
  quickVerdict?: string;
  bestFor?: string[];
  avoidIf?: string[];
  buyingTiers?: Array<{
    label: string;
    product: string;
    reason: string;
  }>;
  products?: Array<{
    name: string;
    price: string;
    rating?: number;
    summary?: string;
  }>;
  fitmentCaveat?: string;
  showPrice?: boolean;
}

const {
  quickVerdict,
  bestFor = [],
  avoidIf = [],
  buyingTiers = [],
  products = [],
  fitmentCaveat,
  showPrice = true
} = Astro.props;

const productByName = new Map(products.map((product) => [product.name, product]));
const highlightedTiers = buyingTiers.slice(0, 4).map((tier) => ({
  ...tier,
  match: productByName.get(tier.product)
}));
const hasContent = Boolean(quickVerdict || bestFor.length || avoidIf.length || buyingTiers.length || fitmentCaveat);
---

{
  hasContent && (
    <div class="space-y-4">
      <div class="grid gap-4 xl:grid-cols-[1.15fr_0.85fr]">
        <div class="editorial-card-accent p-6">
          <p class="eyebrow">Quick verdict</p>
          {quickVerdict && <p class="mt-3 text-sm leading-6 text-ink">{quickVerdict}</p>}
          {
            fitmentCaveat && (
              <div class="mt-5 rounded-2xl border border-orange-200/80 bg-white/80 px-4 py-3">
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">Fitment caveat</p>
                <p class="mt-2 text-sm leading-6 text-steel">{fitmentCaveat}</p>
              </div>
            )
          }
          {
            highlightedTiers.length > 0 && (
              <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                <div class="grid grid-cols-[1.05fr_1.2fr_0.45fr_0.45fr] gap-3 border-b border-slate-200 px-4 py-3 text-[11px] font-semibold uppercase tracking-[0.18em] text-steel">
                  <span>Pick</span>
                  <span>Product</span>
                  <span>Price status</span>
                  <span>Rating</span>
                </div>
                {
                  highlightedTiers.map((tier) => (
                    <div class="grid grid-cols-[1.05fr_1.2fr_0.45fr_0.45fr] gap-3 border-b border-slate-100 px-4 py-4 last:border-b-0">
                      <div>
                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">{tier.label}</p>
                        <p class="mt-2 text-xs leading-5 text-steel">{tier.reason}</p>
                      </div>
                      <div class="text-sm font-semibold text-ink">{tier.product}</div>
                      <div class="text-sm text-steel">{showPrice ? tier.match?.price ?? "—" : "Check retailer"}</div>
                      <div class="text-sm text-steel">{tier.match?.rating ? tier.match.rating.toFixed(1) : "—"}</div>
                    </div>
                  ))
                }
              </div>
            )
          }
        </div>

        <div class="grid gap-4">
          {
            bestFor.length > 0 && (
              <div class="editorial-card p-6">
                <p class="eyebrow">Best for</p>
                <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
                  {bestFor.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )
          }
          {
            avoidIf.length > 0 && (
              <div class="rounded-3xl border border-orange-200/80 bg-white p-6">
                <p class="eyebrow">Do not buy this route if</p>
                <ul class="mt-3 space-y-3 text-sm leading-6 text-steel">
                  {avoidIf.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
  )
}
