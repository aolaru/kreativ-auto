---
import ConsentBanner from "../components/ConsentBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StructuredData from "../components/StructuredData.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  enableAds?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image = "/og-default.svg",
  noindex = false,
  enableAds = true,
  publishedTime,
  modifiedTime,
  schemas = []
} = Astro.props;
// Canonicals must stay on the configured HTTPS origin, regardless of the request URL.
const resolvedCanonical = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();
const pageTitle = `${title} | Kreativ Auto`;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const rawAdsenseClient = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT ?? "ca-pub-4706844277814411";
const adsenseClient = rawAdsenseClient.startsWith("pub-") ? `ca-${rawAdsenseClient}` : rawAdsenseClient;
const shouldExposeAdsenseAccount = !noindex && Boolean(adsenseClient);
// Keep ad delivery disabled until a certified CMP is configured for applicable regions.
const shouldLoadAdsense = false;
const gaMeasurementId = "G-4NXQLN1J2R";
const cloudflareAnalyticsToken = "0b8eb436f3d9413c9241f9ba54d11cec";
const shouldLoadCloudflareAnalytics = !noindex && Boolean(cloudflareAnalyticsToken);
const pageSection = Astro.url.pathname.split("/").filter(Boolean)[0] ?? "home";
const baseSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Kreativ Auto",
    url: new URL("/", Astro.site).toString(),
    logo: new URL("/images/logo-mark.svg", Astro.site).toString(),
    email: "info@kreativauto.com"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Kreativ Auto",
    url: new URL("/", Astro.site).toString(),
    publisher: {
      "@type": "Organization",
      name: "Kreativ Auto"
    }
  }
];
const schemaItems = [...baseSchemas, ...schemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=6eaeeb8" />
    <link rel="icon" href="/favicon.svg?v=6eaeeb8" />
    <link rel="apple-touch-icon" href="/images/logo-mark.svg?v=6eaeeb8" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#111827" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={resolvedCanonical} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}
    {shouldExposeAdsenseAccount && <meta name="google-adsense-account" content={adsenseClient} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <StructuredData items={schemaItems} />
    {
      shouldLoadAdsense && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        ></script>
      )
    }
    <script
      is:inline
      set:html={`
        (() => {
          const consentStorageKey = "ka-analytics-consent";
          const measurementId = ${JSON.stringify(gaMeasurementId)};
          const cloudflareToken = ${JSON.stringify(cloudflareAnalyticsToken)};
          const allowCloudflareAnalytics = ${JSON.stringify(shouldLoadCloudflareAnalytics)};
          const pageSection = ${JSON.stringify(pageSection)};

          const readConsent = () => {
            try {
              return window.localStorage.getItem(consentStorageKey);
            } catch {
              return null;
            }
          };

          const loadGoogleAnalytics = () => {
            if (!measurementId || document.querySelector("script[data-ka-google-tag]")) return;

            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
            window.gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied"
            });
            window.gtag("consent", "update", { analytics_storage: "granted" });
            window.gtag("js", new Date());
            window.gtag("config", measurementId, { anonymize_ip: true });

            const script = document.createElement("script");
            script.async = true;
            script.dataset.kaGoogleTag = "true";
            script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(measurementId);
            document.head.append(script);
          };

          const loadCloudflareAnalytics = () => {
            if (!allowCloudflareAnalytics || !cloudflareToken || document.querySelector("script[data-ka-cloudflare-analytics]")) return;

            const script = document.createElement("script");
            script.type = "module";
            script.dataset.kaCloudflareAnalytics = "true";
            script.src = "https://static.cloudflareinsights.com/beacon.min.js";
            script.dataset.cfBeacon = JSON.stringify({ token: cloudflareToken });
            document.head.append(script);
          };

          window.kaSetAnalyticsConsent = (value) => {
            if (value !== "granted") return;
            loadGoogleAnalytics();
            loadCloudflareAnalytics();
          };

          window.kaTrackEvent = (eventName, params) => {
            if (typeof window.gtag !== "function") return;
            window.gtag("event", eventName, {
              event_category: "site_interaction",
              page_section: pageSection,
              page_path: window.location.pathname,
              ...params
            });
          };

          if (readConsent() === "granted") window.kaSetAnalyticsConsent("granted");

          const scrollMilestones = new Set([50, 90]);
          const recordScrollDepth = () => {
            const documentHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (documentHeight <= 0) return;
            const scrollPercent = Math.round((window.scrollY / documentHeight) * 100);

            for (const milestone of [...scrollMilestones]) {
              if (scrollPercent >= milestone) {
                scrollMilestones.delete(milestone);
                window.kaTrackEvent("scroll_depth", {
                  event_label: milestone + "%",
                  percent_scrolled: milestone,
                  section: "page_engagement"
                });
              }
            }

            if (!scrollMilestones.size) window.removeEventListener("scroll", recordScrollDepth);
          };

          window.addEventListener("scroll", recordScrollDepth, { passive: true });

          document.addEventListener("click", (event) => {
            const target = event.target instanceof Element ? event.target.closest("[data-ka-event]") : null;
            const mailtoLink = event.target instanceof Element ? event.target.closest("a[href^='mailto:']") : null;

            if (!target) {
              if (mailtoLink) window.kaTrackEvent("contact_click", { event_label: "email", section: "contact" });
              return;
            }

            const eventName = target.getAttribute("data-ka-event");
            if (!eventName) return;

            window.kaTrackEvent(eventName, {
              event_label: target.getAttribute("data-ka-label") || target.textContent?.trim() || undefined,
              link_url: target.getAttribute("href") || undefined,
              section: target.getAttribute("data-ka-section") || undefined,
              result_position: Number(target.getAttribute("data-ka-result-position")) || undefined,
              result_type: target.getAttribute("data-ka-result-type") || undefined
            });
          });
        })();
      `}
    />
  </head>
  <body class="min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <ConsentBanner />
    <Footer />
  </body>
</html>
