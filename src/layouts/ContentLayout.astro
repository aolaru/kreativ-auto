---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FAQBlock from "../components/FAQBlock.astro";

interface FAQItem {
  question: string;
  answer: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  intro: string;
  faqs?: FAQItem[];
  image?: string;
  modifiedTime?: Date;
  breadcrumbs?: BreadcrumbItem[];
  schemas?: Record<string, unknown>[];
}

const { title, description, intro, faqs = [], image, modifiedTime, breadcrumbs = [], schemas = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} modifiedTime={modifiedTime} schemas={schemas}>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <div class="surface overflow-hidden p-8 sm:p-10">
      <p class="eyebrow">Kreativ Auto</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        {title}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-steel">{intro}</p>
      {
        modifiedTime && (
          <p class="mt-5 text-sm text-steel">
            Last updated {modifiedTime.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </p>
        )
      }
    </div>

    <div class="mt-10 space-y-8">
      <slot />
      <FAQBlock items={faqs} />
    </div>
  </div>
</BaseLayout>
