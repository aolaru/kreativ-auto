---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FAQBlock from "../components/FAQBlock.astro";
import EditorialHeader from "../components/EditorialHeader.astro";
import ArticleReviewEvidence from "../components/ArticleReviewEvidence.astro";
import { isReviewReadyComparison, isReviewReadyGuide } from "../data/review-readiness";

interface FAQItem {
  question: string;
  answer: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  intro: string;
  faqs?: FAQItem[];
  image?: string;
  modifiedTime?: Date;
  breadcrumbs?: BreadcrumbItem[];
  schemas?: Record<string, unknown>[];
  enableAds?: boolean;
  noindex?: boolean;
  editorialSummary?: string;
  editorialByline?: string;
  editorialReviewedLabel?: string;
  editorialBadges?: string[];
}

const {
  title,
  description,
  intro,
  faqs = [],
  image,
  modifiedTime,
  breadcrumbs = [],
  schemas = [],
  enableAds = true,
  noindex = false,
  editorialSummary,
  editorialByline,
  editorialReviewedLabel,
  editorialBadges = []
} = Astro.props;

const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const articleSection = pathParts[0];
const articleSlug = pathParts[1];
const hasReviewRestriction =
  (articleSection === "guides" && Boolean(articleSlug) && !isReviewReadyGuide(articleSlug)) ||
  (articleSection === "comparisons" && Boolean(articleSlug) && !isReviewReadyComparison(articleSlug));
const resolvedNoindex = noindex || hasReviewRestriction;
const resolvedEnableAds = enableAds && !resolvedNoindex;
---

<BaseLayout title={title} description={description} image={image} modifiedTime={modifiedTime} schemas={schemas} enableAds={resolvedEnableAds} noindex={resolvedNoindex}>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <div class="surface hero-frame overflow-hidden p-8 sm:p-10">
      <div class:list={["grid gap-8 lg:items-start", image ? "lg:grid-cols-[1.05fr_0.95fr]" : ""]}>
        <div>
          <p class="eyebrow">Kreativ Auto</p>
          <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
            {title}
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-steel">{intro}</p>
          {
            editorialByline && (
              <EditorialHeader
                summary={editorialSummary}
                byline={editorialByline}
                reviewedLabel={editorialReviewedLabel}
                badges={editorialBadges}
              />
            )
          }
          {
            modifiedTime && !editorialByline && (
              <p class="mt-5 text-sm text-steel">
                Last updated {modifiedTime.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </p>
            )
          }
        </div>

        {
          image && (
            <div class="image-frame image-frame-hero rounded-[2rem] shadow-xl">
              <img
                src={image}
                alt={title}
                width="1200"
                height="800"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          )
        }
      </div>
    </div>

    <div class="mt-10 space-y-8">
      <ArticleReviewEvidence />
      <slot />
      <FAQBlock items={faqs} />
    </div>
  </div>
</BaseLayout>
