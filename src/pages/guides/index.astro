---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterToolbar from "../../components/FilterToolbar.astro";
import { ownershipGuides } from "../../data/ownership-guides";
import { comparisonGuides } from "../../data/comparison-guides";
import { toThumbnail } from "../../utils/images";
import { getGuideCluster } from "../../utils/relationships";

const commonProblemGuides = ownershipGuides.filter((guide) => guide.title.toLowerCase().includes("common problems"));
const usedBuyerGuides = ownershipGuides.filter((guide) => guide.eyebrow === "Used buyer guide");
const reliabilityGuides = ownershipGuides.filter((guide) => guide.eyebrow === "Reliability guide");
const maintenanceGuides = ownershipGuides.filter((guide) => guide.title.toLowerCase().includes("maintenance costs and weak points"));
const serviceGuides = ownershipGuides.filter((guide) => guide.eyebrow === "Service guide");
const buyingGuides = ownershipGuides.filter((guide) => guide.title.toLowerCase().includes("what to check before buying"));
const trimGuides = ownershipGuides.filter((guide) => guide.eyebrow === "Trim guide");
const avoidGuides = ownershipGuides.filter((guide) => guide.eyebrow === "Avoid guide");

const getGuideType = (guide: { eyebrow: string }) => {
  if (guide.eyebrow === "Ownership guide") return "common-problems";
  if (guide.eyebrow === "Used buyer guide") return "used-buyer";
  if (guide.eyebrow === "Reliability guide") return "reliability";
  if (guide.eyebrow === "Maintenance guide") return "maintenance";
  if (guide.eyebrow === "Service guide") return "service";
  if (guide.eyebrow === "Buying guide") return "pre-purchase";
  if (guide.eyebrow === "Trim guide") return "trim-choice";
  if (guide.eyebrow === "Avoid guide") return "what-to-avoid";
  return "comparison";
};

const allGuides = [
  ...ownershipGuides.map((guide) => ({
    ...guide,
    type: getGuideType(guide),
    cluster: getGuideCluster(guide)
  })),
  ...comparisonGuides.map((guide) => ({
    ...guide,
    type: "comparison",
    cluster: getGuideCluster(guide)
  }))
];

const guideFilters = [
  {
    name: "cluster",
    label: "Cluster",
    options: [
      { value: "civic", label: "Honda Civic" },
      { value: "rav4", label: "Toyota RAV4" },
      { value: "tiguan", label: "VW Tiguan" },
      { value: "other", label: "Other vehicles" }
    ]
  },
  {
    name: "type",
    label: "Guide type",
    options: [
      { value: "common-problems", label: "Common problems" },
      { value: "used-buyer", label: "Should you buy it used?" },
      { value: "reliability", label: "Reliability scorecards" },
      { value: "maintenance", label: "Maintenance" },
      { value: "service", label: "Service intervals" },
      { value: "pre-purchase", label: "Pre-purchase" },
      { value: "trim-choice", label: "Trim choice" },
      { value: "what-to-avoid", label: "What to avoid" },
      { value: "comparison", label: "Comparison" }
    ]
  }
];
---

<BaseLayout enableAds={false} title="Guides" description="Cornerstone ownership, maintenance, buying, and comparison guides for the strongest vehicle clusters on the site.">
  <div class="container-shell py-12 sm:py-16">
    <div class="surface hero-frame p-8 sm:p-10">
      <div class="grid gap-8 xl:grid-cols-[1.15fr_0.85fr]">
        <div>
          <p class="eyebrow">Guides</p>
          <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Cornerstone guides that go beyond one symptom or one part</h1>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
            These are the strongest editorial entry points on the site. Use them when you want the broader ownership picture first, then drop into the linked problem pages, best-parts guides, and comparisons once the diagnosis gets narrower.
          </p>
        </div>
        <div class="accent-panel p-6">
          <p class="eyebrow">Guide mix</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <a class="snapshot-card p-4" href="#common-problems-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Common problems">
              <p class="text-2xl font-semibold text-ink">{commonProblemGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Common problems</p>
            </a>
            <a class="snapshot-card p-4" href="#used-buyer-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Used-buyer verdicts">
              <p class="text-2xl font-semibold text-ink">{usedBuyerGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Used-buyer verdicts</p>
            </a>
            <a class="snapshot-card p-4" href="#reliability-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Reliability">
              <p class="text-2xl font-semibold text-ink">{reliabilityGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Reliability</p>
            </a>
            <a class="snapshot-card p-4" href="#maintenance-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Maintenance">
              <p class="text-2xl font-semibold text-ink">{maintenanceGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Maintenance</p>
            </a>
            <a class="snapshot-card p-4" href="#service-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Service guides">
              <p class="text-2xl font-semibold text-ink">{serviceGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Service guides</p>
            </a>
            <a class="snapshot-card p-4" href="#buying-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Buying">
              <p class="text-2xl font-semibold text-ink">{buyingGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Buying</p>
            </a>
            <a class="snapshot-card p-4" href="/comparisons/" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Comparisons">
              <p class="text-2xl font-semibold text-ink">{comparisonGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Comparisons</p>
            </a>
            <a class="snapshot-card p-4 sm:col-span-2" href="#trim-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Trim guides">
              <p class="text-2xl font-semibold text-ink">{trimGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Trim guides</p>
            </a>
            <a class="snapshot-card p-4 sm:col-span-2" href="#avoid-guides" data-ka-event="guides_mix_click" data-ka-section="guide_mix" data-ka-label="Avoid guides">
              <p class="text-2xl font-semibold text-ink">{avoidGuides.length}</p>
              <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Avoid guides</p>
            </a>
          </div>
        </div>
      </div>
    </div>

    <section class="mt-10 surface hero-frame p-6 sm:p-8">
      <p class="eyebrow">Start Here</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Most useful flagship guides</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        {commonProblemGuides.slice(0, 1).map((guide) => (
          <a class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-50 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href}>
            {guide.image && (
              <div class="image-frame image-frame-feature">
                <img
                  src={toThumbnail(guide.image)}
                  alt={guide.title}
                  loading="lazy"
                  decoding="async"
                  width="960"
                  height="640"
                />
              </div>
            )}
            <div class="p-5">
              <p class="eyebrow">{guide.eyebrow}</p>
              <h3 class="mt-2 text-2xl font-semibold text-ink">{guide.title}</h3>
              <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
            </div>
          </a>
        ))}
        <div class="grid gap-4">
          {ownershipGuides.slice(1, 5).map((guide) => (
            <a class="mesh-card overflow-hidden p-0 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href} data-ka-event="guide_card_click" data-ka-section="start_here" data-ka-label={guide.title}>
              {guide.image && (
                <div class="image-frame image-frame-card">
                  <img
                    src={toThumbnail(guide.image)}
                    alt={guide.title}
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )}
              <div class="p-5">
                <p class="eyebrow">{guide.eyebrow}</p>
                <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
                <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="common-problems-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Common Problems</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Flagship ownership problem guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {commonProblemGuides.map((guide) => (
          <a class="mesh-card overflow-hidden p-0 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href} data-ka-event="guide_card_click" data-ka-section="common_problems" data-ka-label={guide.title}>
            {guide.image && (
              <div class="image-frame image-frame-card">
                <img
                  src={toThumbnail(guide.image)}
                  alt={guide.title}
                  loading="lazy"
                  decoding="async"
                  width="960"
                  height="640"
                />
              </div>
            )}
            <div class="p-5">
              <p class="eyebrow">{guide.eyebrow}</p>
              <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
              <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="used-buyer-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Should you buy it used?</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Final used-buyer verdicts</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {usedBuyerGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="reliability-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Reliability scorecards</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Used-buyer reliability summaries</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {reliabilityGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="maintenance-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Maintenance</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Ownership cost and weak-point guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {maintenanceGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="service-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Service schedule</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Service interval and maintenance timing guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {serviceGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="buying-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Before Buying</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Pre-purchase check guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {buyingGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="trim-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Trim choice</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Which trim to buy guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {trimGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="avoid-guides" class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">What to avoid</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Ownership red flags and regret guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {avoidGuides.map((guide) => (
          <a class="mesh-card overflow-hidden p-0 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href} data-ka-event="guide_card_click" data-ka-section="avoid_guides" data-ka-label={guide.title}>
            {guide.image && (
              <div class="image-frame image-frame-card">
                <img
                  src={toThumbnail(guide.image)}
                  alt={guide.title}
                  loading="lazy"
                  decoding="async"
                  width="960"
                  height="640"
                />
              </div>
            )}
            <div class="p-5">
              <p class="eyebrow">{guide.eyebrow}</p>
              <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
              <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Comparisons</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Version and powertrain guides</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {comparisonGuides.map((guide) => (
          <a class="mesh-card p-5 transition hover:-translate-y-0.5" href={guide.href}>
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10 surface p-6 sm:p-8" data-filter-root>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Browse all</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Filter every guide in one place</h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-steel">
            Use the filters when you already know the cluster and the kind of ownership question you want to answer.
          </p>
        </div>
        <p class="text-sm text-steel">
          <span class="font-semibold text-ink" data-filter-count></span> guides
        </p>
      </div>

      <div class="mt-6">
        <FilterToolbar filters={guideFilters} searchPlaceholder="Search guides by title, vehicle, or topic" />
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {allGuides.map((guide) => (
          <a
            class="mesh-card p-5 transition hover:-translate-y-0.5 hover:bg-white"
            href={guide.href}
            data-filter-item
            data-filter-cluster={guide.cluster}
            data-filter-type={guide.type}
            data-filter-search-text={`${guide.title} ${guide.description} ${guide.eyebrow}`}
            data-ka-event="guide_card_click"
            data-ka-section="browse_all_guides"
            data-ka-label={guide.title}
          >
            {
              guide.image && (
                <div class="image-frame image-frame-card mb-4">
                  <img
                    src={toThumbnail(guide.image)}
                    alt={guide.title}
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="eyebrow">{guide.eyebrow}</p>
            <h3 class="mt-2 text-xl font-semibold text-ink">{guide.title}</h3>
            <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
          </a>
        ))}
      </div>

      <div class="mt-6 rounded-2xl border border-dashed border-slate-300 px-4 py-5 text-sm leading-6 text-steel" data-empty-state hidden>
        No guides match the current filters.
      </div>
    </section>
  </div>
</BaseLayout>
