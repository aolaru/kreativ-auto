---
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import DecisionPathBlock from "../../components/DecisionPathBlock.astro";
import EvidenceLimitsBlock from "../../components/EvidenceLimitsBlock.astro";
import { hondaCivicGuideQuality } from "../../data/honda-civic-quality";

const title = "Honda Civic 10th gen facelift what to check before buying";
const quality = hondaCivicGuideQuality["honda-civic-10th-gen-facelift-what-to-check-before-buying"];
const description = "What to inspect on a Honda Civic 10th gen facelift before buying, which weak points deserve the closest look, and what should not scare you too fast.";
const intro = "A facelift Civic can still be one of the easiest used daily drivers to buy, but only if the inspection stays practical. The useful checks are idle A/C performance, battery reserve, brake noise, front-end rattles, and whether the seller is mixing 1.5T and 2.0 advice like it all means the same thing. Keep the purchase decision grounded in the specific car, not the Civic badge.";
const modifiedTime = new Date("2026-08-25");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Guides", href: "/guides/honda-civic-10th-gen-facelift-what-to-check-before-buying/" },
  { label: title }
];

const relatedProblems = [
  { href: "/problems/air-conditioner-blows-warm-at-idle/", title: "Air conditioner blows warm at idle", description: "Open this if the climate story already feels weak on the viewing or test drive.", eyebrow: "Problem guide" },
  { href: "/problems/battery-light-flickers-at-idle/", title: "Battery light flickers at idle", description: "Useful when the charging story feels vague or the battery behavior looks tired.", eyebrow: "Problem guide" },
  { href: "/problems/front-suspension-rattles-over-small-bumps/", title: "Front suspension rattles over small bumps", description: "The right next read if the front end already sounds looser than it should.", eyebrow: "Problem guide" }
];

const relatedBest = [
  { href: "/best/best-ac-condensers-for-honda-civic-2019/", title: "Best A/C condensers for Honda Civic 2019", description: "Best if the car still looks worth buying but the A/C story needs a real plan.", eyebrow: "A/C Condensers" },
  { href: "/best/best-front-brake-pads-for-honda-civic-2019/", title: "Best front brake pads for Honda Civic 2019", description: "Worth opening if the brakes feel tired or noisy but not deal-breaking.", eyebrow: "Front Brake Pads" }
];

const relatedComparisons = [
  { href: "/comparisons/honda-civic-1-5t-vs-2-0/", title: "Honda Civic 1.5T vs 2.0", description: "Best when the purchase decision depends on engine choice, not just model year.", eyebrow: "Powertrain guide" }
];

const inspectionResources = [
  {
    href: "/checklists/used-car-viewing/",
    title: "Printable used-car viewing worksheet",
    description: "Record documents, idle A/C behavior, road-test notes, and the specific facelift Civic checks before negotiating.",
    eyebrow: "Inspection worksheet"
  }
];
---

<ContentLayout
  title={title}
  description={description}
  intro={intro}
  image="/images/photos/cars/honda-civic-2019.webp"
  modifiedTime={modifiedTime}
  breadcrumbs={breadcrumbs}
>
  <EvidenceLimitsBlock {...quality.evidence} />
  <DecisionPathBlock title="Viewing decision path" intro="Keep the listing review or test drive grounded before reputation starts doing too much work." steps={quality.decisionPath} />

  <Section title="The short version" intro="If you only need the fast read, these are the checks that matter most.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Check idle A/C performance, battery reserve, and front-end refinement before the Civic’s usual strong reputation does the whole job for you.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Listen for brake noise and small front-end rattles, because those are the issues most likely to age the car early.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Keep engine-specific advice separate. The 1.5T and 2.0 do not turn every ownership question into the same answer.</li>
    </ul>
  </Section>

  <Section title="What to inspect first" intro="These checks are worth doing before the viewing turns into generic used-Civic small talk.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Idle A/C performance in realistic conditions, not just during a short cool blast on a moving car.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Battery behavior and charging confidence on a commuter-use car that may not have ideal daily duty.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Brake refinement at low speed, not only one hard stop that hides the squeal story.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Front-end rattles over small bumps, rough pavement, and slower parking-lot movement.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Whether the seller is describing 1.5T and 2.0 maintenance or drivability like they are interchangeable.</li>
    </ul>
  </Section>

  <Section title="What should lower confidence quickly" intro="These are the things that should change the price or make you move on.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">A/C weakness at idle with no clear repair history and a vague explanation.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Battery or charging complaints that the seller treats as random and not worth investigating.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Clear front-end rattle plus no recent wear-item work despite the car already sounding tired.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">An engine-specific question that gets answered with broad Civic generalities instead of real trim or powertrain detail.</li>
    </ul>
  </Section>

  <Section title="What should not scare you too fast" intro="These issues deserve a discount or repair plan, but not instant panic if the rest of the car is strong.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">A battery approaching replacement age on a commuter-used Civic.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Brake squeal that still sounds like a pad and refinement problem instead of bigger braking weakness.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Light front-end rattle where the rest of the car still feels fundamentally tight and honest.</li>
    </ul>
  </Section>

  <RelatedLinks title="Related problem guides" intro="Open these if the viewing or test drive already points at a repeat complaint." items={relatedProblems} />
  <RelatedLinks title="Related best-parts guides" intro="Use these when the car is still worth buying but the weak point needs a realistic repair plan." items={relatedBest} />
  <RelatedLinks title="Related comparison guides" intro="Use these when the buying advice changes with the engine." items={relatedComparisons} />
  <RelatedLinks title="Bring this to the viewing" intro="Use one record for the listing, inspection, test drive, and price discussion." items={inspectionResources} />
</ContentLayout>
