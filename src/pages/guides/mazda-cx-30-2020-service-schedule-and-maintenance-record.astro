---
import ContentLayout from "../../layouts/ContentLayout.astro";
import DecisionPathBlock from "../../components/DecisionPathBlock.astro";
import EvidenceLimitsBlock from "../../components/EvidenceLimitsBlock.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import { editorialTeam } from "../../data/editorial";
import { cx30GuideQuality } from "../../data/mazda-cx30-quality";

const title = "2020 Mazda CX-30 service schedule and maintenance record";
const description = "Use Mazda's scheduled-maintenance guidance to organise a 2020 CX-30 service record, distinguish normal and severe use, and prepare the next workshop visit.";
const image = "/images/photos/cars/mazda-cx-30-2020.webp";
const modifiedTime = new Date("2026-09-01");
const quality = cx30GuideQuality["mazda-cx-30-2020-service-schedule-and-maintenance-record"];
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Guides", href: "/guides/" }, { label: title }];
const related = [
  { href: "/checklists/maintenance-record/", title: "Printable maintenance record", description: "Bring a compact record of completed work, observations, and the next questions for the workshop.", eyebrow: "Worksheet" },
  { href: "/guides/mazda-cx-30-2020-maintenance-cost-framework/", title: "CX-30 maintenance-cost framework", description: "Turn confirmed service needs into a complete, itemized budget.", eyebrow: "Ownership planning" },
  { href: "/problems/front-end-clunk-over-bumps-mazda-cx-30-2020/", title: "CX-30 front rattle diagnosis", description: "Use a symptom path when maintenance records alone cannot explain a front noise.", eyebrow: "Diagnosis" }
];
---

<ContentLayout title={title} description={description} intro="The service record should show the operating conditions, the work completed, and the reason it was due. Use Mazda's schedule as the baseline, then record confirmed condition checks beside mileage and date." image={image} modifiedTime={modifiedTime} breadcrumbs={breadcrumbs} editorialSummary="A service-record guide based on Mazda's published 2020 CX-30 maintenance schedule and owner-maintenance precautions, without substituting a generic interval for the vehicle status monitor." editorialByline={`By ${editorialTeam.name}`} editorialReviewedLabel="Reviewed September 1, 2026" editorialBadges={["Maintenance guide", "US-market scope", "Record-focused"]}>
  <EvidenceLimitsBlock {...quality.evidence} />
  <DecisionPathBlock title="Use the correct schedule" intro="Confirm market, operating conditions, mileage, and warnings before recording work as due." steps={quality.decisionPath} />

  <Section title="Use Mazda's schedule as the source of record" intro="The published schedule distinguishes normal driving from severe conditions and sets the maximum interval for the vehicle status monitor.">
    <p>For US-market 2020 CX-30s, Mazda says the vehicle status monitor warns before the maximum normal interval of 10,000 miles or 12 months. Severe operating conditions include extended idling or low-speed use, dust, regular short trips or cold use, high temperatures, and sustained mountainous driving; Mazda specifies engine-oil and filter replacement every 5,000 miles or six months in that severe schedule. Confirm the exact vehicle and market with the <a class="font-semibold text-accent hover:underline" href="https://www.mazdausa.com/static/manuals/2020/cx-30/contents/07020601.html" rel="noopener" target="_blank">official 2020 CX-30 schedule</a> before treating a number here as applicable.</p>
  </Section>

  <Section title="Record these routine items" intro="Write the date, mileage, provider, part or fluid specification, and any observation that changes the next decision.">
    <div class="grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="eyebrow">Every service visit</p><p class="mt-3 text-sm leading-6 text-steel">Oil and filter status, warning messages, fluid levels, tire pressure and wear, brake observations, and any stored diagnostic result supplied by the workshop.</p></article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="eyebrow">Scheduled wear checks</p><p class="mt-3 text-sm leading-6 text-steel">Tire rotation, steering and linkage inspection, suspension and wheel-bearing checks, brake condition, driveshaft boots, chassis fasteners, and exhaust or heat-shield condition as the schedule calls for them.</p></article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="eyebrow">Time-and-mileage items</p><p class="mt-3 text-sm leading-6 text-steel">Cabin filter, air filter, spark plugs, coolant, and brake-fluid work should retain the invoice and exact service interval rather than being recalled from memory.</p></article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5"><p class="eyebrow">Condition evidence</p><p class="mt-3 text-sm leading-6 text-steel">Tire tread and date code, battery test result, alignment history, brake measurements, leaks, and any symptom reproduction details make the record useful for a buyer or the next workshop.</p></article>
    </div>
  </Section>

  <Section title="Owner checks and workshop boundaries" intro="Mazda's owner guidance separates simple observations from work that needs appropriate experience, tools, and safety procedures.">
    <p>Mazda lists fluid levels at refuelling and tire pressure at least monthly among owner checks. Its owner-maintenance precautions also state that incomplete or improper service can create problems and direct owners without the knowledge, tools, or experience to a qualified technician. Record what you observed, then let the workshop diagnose brake, steering, suspension, warning-light, or fluid-leak concerns.</p>
  </Section>

  <RelatedLinks title="Use the record" intro="Keep the record with the vehicle, then use it to prepare a service visit, sale, or used-car inspection." items={related} />
</ContentLayout>
