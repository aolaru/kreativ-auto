---
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { editorialTeam, carTrustPoints } from "../../data/editorial";

const title = "Mazda CX-5 2020 common problems and what to check first";
const description =
  "The 2020 Mazda CX-5 problems worth checking first, including brake noise, front-end clunks, road hum, and the best next pages once the symptom is clear.";
const intro =
  "The 2020 CX-5 feels more polished than many compact SUVs, which is exactly why small brake, suspension, and road-noise complaints stand out. This guide keeps the first checks practical so owners do not turn normal wear items into an expensive guessing game.";
const modifiedTime = new Date("2026-05-01");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Guides", href: "/guides/" },
  { label: title }
];
const faqs = [
  {
    question: "Is the 2020 Mazda CX-5 reliable?",
    answer:
      "Generally yes. The repeat complaints are usually brake refinement, small front-end noises, tire or hub noise, and normal wear items rather than major platform failures."
  },
  {
    question: "What usually makes a CX-5 feel older than it is?",
    answer:
      "Brake squeal, front-end clunks, and changing road noise are the complaints that most quickly cut into the CX-5's refined feel."
  },
  {
    question: "What should I check before buying parts?",
    answer:
      "Match the part to the symptom: brake hardware for squeal, sway bar links for clunks, and tire condition before assuming road-speed hum is a wheel bearing."
  }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    mainEntityOfPage: Astro.url.href,
    dateModified: modifiedTime.toISOString(),
    author: { "@type": "Organization", name: editorialTeam.name },
    publisher: { "@type": "Organization", name: editorialTeam.publisher }
  }
];

const relatedProblems = [
  {
    href: "/problems/front-end-clunk-over-bumps-mazda-cx-5-2020/",
    title: "Front-end clunk over bumps on Mazda CX-5 2020",
    description: "Use this when the front of the SUV sounds loose over small bumps or rough pavement.",
    eyebrow: "Problem guide"
  },
  {
    href: "/problems/front-brakes-squeal-at-low-speed-mazda-cx-5-2020/",
    title: "Front brakes squeal at low speed on Mazda CX-5 2020",
    description: "Start here when the complaint is brake noise and refinement rather than a clear loss of stopping power.",
    eyebrow: "Problem guide"
  },
  {
    href: "/problems/humming-noise-that-gets-louder-with-speed/",
    title: "Humming noise that gets louder with speed",
    description: "Open this when tire noise and wheel-bearing suspicion start getting mixed together.",
    eyebrow: "Problem guide"
  }
];

const relatedBest = [
  {
    href: "/best/best-front-sway-bar-links-for-mazda-cx-5-2020/",
    title: "Best front sway bar links for Mazda CX-5 2020",
    description: "The useful parts page once the clunk pattern points at normal link wear.",
    eyebrow: "Front Sway Bar Links"
  },
  {
    href: "/best/best-brake-pads-for-mazda-cx-5-2020/",
    title: "Best brake pads for Mazda CX-5 2020",
    description: "Use this when the goal is preserving quiet, everyday brake feel on a refined SUV.",
    eyebrow: "Brake Pads"
  }
];
---

<ContentLayout
  title={title}
  description={description}
  intro={intro}
  image="/images/photos/cars/mazda-cx-5-2020.webp"
  modifiedTime={modifiedTime}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  schemas={schemas}
  editorialSummary="This guide gives the CX-5 cluster a broad ownership entry point and links the existing problem and best-parts pages into one practical path."
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={`Reviewed ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
  editorialBadges={["Ownership guide", "Model-year specific", "Related pages reviewed"]}
>
  <TrustBlock
    title="How to use this guide"
    summary="Use this page when a 2020 CX-5 feels mostly right, but brake noise, front-end clunks, or road hum are starting to reduce the polished feel."
    byline={`By ${editorialTeam.name}`}
    checkedLabel={`Checked ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
    points={carTrustPoints}
  />

  <section class="surface surface-dark hero-frame p-6 sm:p-8">
    <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="editorial-kicker">At a glance</p>
        <h2 class="mt-4 text-3xl font-semibold text-ink">The short version</h2>
        <ul class="mt-6 grid gap-3 text-sm leading-6 text-steel">
          <li class="stat-tile">The 2020 CX-5 is not a high-drama ownership story, but it is sensitive to brake noise, tire quality, and small front-end wear because the baseline refinement is high.</li>
          <li class="stat-tile">The expensive mistake is replacing parts by category instead of matching the symptom to the first likely wear point.</li>
          <li class="stat-tile">Most useful fixes start with brake hardware, sway bar links, tire condition, or a clean road-speed noise diagnosis.</li>
        </ul>
      </div>
      <div class="accent-panel p-6">
        <p class="eyebrow">Ownership pattern</p>
        <div class="mt-4 grid gap-4">
          <div class="soft-panel p-4">
            <p class="text-2xl font-semibold text-ink">3</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Main weak spots</p>
          </div>
          <div class="soft-panel p-4">
            <p class="text-sm leading-6 text-steel">A CX-5 can still be reliable while feeling worn if brake and suspension refinement are ignored.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Section title="The trouble areas worth knowing" intro="These are the checks that keep the CX-5 diagnosis grounded.">
    <div class="grid gap-6 lg:grid-cols-3">
      <article class="mesh-card p-6">
        <p class="eyebrow">1. Brake noise</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">A quiet SUV makes squeal feel more serious</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Start with pad compound, rotor surface, and hardware service before treating light squeal like a complete brake-system failure.</p>
      </article>
      <article class="mesh-card p-6">
        <p class="eyebrow">2. Front clunks</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Small links can age the whole front end</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Sway bar links and small suspension wear points are the right first suspects when the noise appears over small bumps.</p>
      </article>
      <article class="mesh-card p-6">
        <p class="eyebrow">3. Road hum</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Tires should lose before wheel bearings</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Road-speed hum needs a tire, rotation, and surface check before a hub or bearing becomes the main suspect.</p>
      </article>
    </div>
  </Section>

  <Section title="What to check first" intro="This order keeps the CX-5 from becoming a parts-guessing exercise.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">If the brakes squeal, inspect pad condition, rotor finish, and hardware contact points before buying pads alone.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">If the front end clunks, check sway bar links and visible front suspension wear before assuming the whole strut or control-arm story.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">If road hum changes with speed, rotate and inspect tires before diagnosing a wheel bearing by sound alone.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">If the SUV feels less refined overall, solve the brake, tire, and front-end basics before chasing vague ride-quality theories.</li>
    </ul>
  </Section>

  <Section title="Best next reads" intro="Open these once the CX-5 symptom is narrowed.">
    <div class="grid gap-6 lg:grid-cols-3">
      <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href="/generations/mazda-cx-5-kf-2017-2021/">
        <p class="eyebrow">Generation hub</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Mazda CX-5 KF 2017-2021</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Use the generation hub when you want the wider CX-5 ownership picture first.</p>
      </a>
      <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href="/cars/mazda-cx-5-2020/">
        <p class="eyebrow">Car hub</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Mazda CX-5 2020</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Use the model-year page for the car overview and the existing linked repair pages.</p>
      </a>
      <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href="/best/best-front-sway-bar-links-for-mazda-cx-5-2020/">
        <p class="eyebrow">Parts path</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Front sway bar links</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The practical next page when the main symptom is a small front-end clunk.</p>
      </a>
    </div>
  </Section>

  <RelatedLinks title="Problem guides linked from this page" intro="These pages narrow the CX-5 complaint after the broad ownership pattern is clear." items={relatedProblems} />
  <RelatedLinks title="Best-parts guides linked from this page" intro="These are the parts pages worth opening after the diagnosis points at the right repair area." items={relatedBest} />
</ContentLayout>
