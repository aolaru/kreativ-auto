---
import ContentLayout from "../../layouts/ContentLayout.astro";
import GuideAtAGlance from "../../components/GuideAtAGlance.astro";
import GuideChecklist from "../../components/GuideChecklist.astro";
import GuideIssueGrid from "../../components/GuideIssueGrid.astro";
import GuideNextReads from "../../components/GuideNextReads.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { editorialTeam, carTrustPoints } from "../../data/editorial";

const title = "Mazda CX-5 2020 common problems and what to check first";
const description =
  "The 2020 Mazda CX-5 problems worth checking first, including brake noise, front-end clunks, road hum, and the best next pages once the symptom is clear.";
const intro =
  "The 2020 CX-5 feels more polished than many compact SUVs, which is exactly why small brake, suspension, and road-noise complaints stand out. Practical first checks keep normal wear items from turning into an expensive guessing game.";
const modifiedTime = new Date("2026-05-01");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Guides", href: "/guides/" },
  { label: title }
];
const faqs = [
  {
    question: "Is the 2020 Mazda CX-5 reliable?",
    answer:
      "Generally yes. The repeat complaints are usually brake refinement, small front-end noises, tire or hub noise, and normal wear items rather than major platform failures."
  },
  {
    question: "What usually makes a CX-5 feel older than it is?",
    answer:
      "Brake squeal, front-end clunks, and changing road noise are the complaints that most quickly cut into the CX-5's refined feel."
  },
  {
    question: "What should I check before buying parts?",
    answer:
      "Match the part to the symptom: brake hardware for squeal, sway bar links for clunks, and tire condition before assuming road-speed hum is a wheel bearing."
  }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    mainEntityOfPage: Astro.url.href,
    dateModified: modifiedTime.toISOString(),
    author: { "@type": "Organization", name: editorialTeam.name },
    publisher: { "@type": "Organization", name: editorialTeam.publisher }
  }
];

const relatedProblems = [
  {
    href: "/problems/front-end-clunk-over-bumps-mazda-cx-5-2020/",
    title: "Front-end clunk over bumps on Mazda CX-5 2020",
    description: "Best when the front of the SUV sounds loose over small bumps or rough pavement.",
    eyebrow: "Problem guide"
  },
  {
    href: "/problems/front-brakes-squeal-at-low-speed-mazda-cx-5-2020/",
    title: "Front brakes squeal at low speed on Mazda CX-5 2020",
    description: "Start here when the complaint is brake noise and refinement rather than a clear loss of stopping power.",
    eyebrow: "Problem guide"
  },
  {
    href: "/problems/humming-noise-that-gets-louder-with-speed/",
    title: "Humming noise that gets louder with speed",
    description: "Open this when tire noise and wheel-bearing suspicion start getting mixed together.",
    eyebrow: "Problem guide"
  }
];

const relatedBest = [
  {
    href: "/best/best-front-sway-bar-links-for-mazda-cx-5-2020/",
    title: "Best front sway bar links for Mazda CX-5 2020",
    description: "The useful parts page once the clunk pattern points at normal link wear.",
    eyebrow: "Front Sway Bar Links"
  },
  {
    href: "/best/best-brake-pads-for-mazda-cx-5-2020/",
    title: "Best brake pads for Mazda CX-5 2020",
    description: "Best when the goal is preserving quiet, everyday brake feel on a refined SUV.",
    eyebrow: "Brake Pads"
  }
];

const atAGlancePoints = [
  "The 2020 CX-5 is not a high-drama ownership story, but it is sensitive to brake noise, tire quality, and small front-end wear because the baseline refinement is high.",
  "The expensive mistake is replacing parts by category instead of matching the symptom to the first likely wear point.",
  "Most useful fixes start with brake hardware, sway bar links, tire condition, or a clean road-speed noise diagnosis."
];

const troubleAreas = [
  {
    eyebrow: "1. Brake noise",
    title: "A quiet SUV makes squeal feel more serious",
    description:
      "Start with pad compound, rotor surface, and hardware service before treating light squeal like a complete brake-system failure."
  },
  {
    eyebrow: "2. Front clunks",
    title: "Small links can age the whole front end",
    description:
      "Sway bar links and small suspension wear points are the right first suspects when the noise appears over small bumps."
  },
  {
    eyebrow: "3. Road hum",
    title: "Tires should be ruled out before wheel bearings",
    description:
      "Road-speed hum needs a tire, rotation, and surface check before a hub or bearing becomes the main suspect."
  }
];

const firstChecks = [
  "If the brakes squeal, inspect pad condition, rotor finish, and hardware contact points before buying pads alone.",
  "If the front end clunks, check sway bar links and visible front suspension wear before assuming the whole strut or control-arm story.",
  "If road hum changes with speed, rotate and inspect tires before diagnosing a wheel bearing by sound alone.",
  "If the SUV feels less refined overall, solve the brake, tire, and front-end basics before chasing vague ride-quality theories.",
  "If two symptoms appear together, check whether one worn tire, loose link, or brake hardware issue is making the whole SUV feel older."
];

const nextReads = [
  {
    href: "/generations/mazda-cx-5-kf-2017-2021/",
    eyebrow: "Generation",
    title: "Mazda CX-5 KF 2017-2021",
    description: "Use the generation view when you want the wider CX-5 ownership picture first."
  },
  {
    href: "/cars/mazda-cx-5-2020/",
    eyebrow: "Car",
    title: "Mazda CX-5 2020",
    description: "Use the model-year guide for the car overview and the existing linked repair pages."
  },
  {
    href: "/best/best-front-sway-bar-links-for-mazda-cx-5-2020/",
    eyebrow: "Parts path",
    title: "Front sway bar links",
    description: "The practical next page when the main symptom is a small front-end clunk."
  }
];
---

<ContentLayout
  title={title}
  description={description}
  intro={intro}
  image="/images/photos/cars/mazda-cx-5-2020.webp"
  modifiedTime={modifiedTime}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  schemas={schemas}
  editorialSummary="A first-check path for 2020 CX-5 brake noise, front-end clunks, road hum, and related parts decisions."
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={`Reviewed ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
  editorialBadges={["Ownership guide", "Model-year specific", "Related checks reviewed"]}
>
  <TrustBlock
    title="Best starting point"
    summary="Start here when a 2020 CX-5 feels mostly right, but brake noise, front-end clunks, or road hum are starting to reduce the polished feel."
    byline={`By ${editorialTeam.name}`}
    checkedLabel={`Checked ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
    points={carTrustPoints}
  />

  <GuideAtAGlance
    points={atAGlancePoints}
    statValue="3"
    statLabel="Main weak spots"
    statHref="#first-checks"
    statText="A CX-5 can still be reliable while feeling worn if brake and suspension refinement are ignored."
  />

  <GuideIssueGrid
    title="The trouble areas worth knowing"
    intro="These are the checks that keep the CX-5 diagnosis grounded."
    issues={troubleAreas}
    columns={3}
  />

  <GuideChecklist
    id="first-checks"
    title="What to check first"
    intro="This order keeps the CX-5 from becoming a parts-guessing exercise."
    items={firstChecks}
  />

  <GuideNextReads
    title="Best next reads"
    intro="Open these once the CX-5 symptom is narrowed."
    items={nextReads}
  />

  <RelatedLinks title="Related problem guides" intro="These guides narrow the CX-5 complaint after the broad ownership pattern is clear." items={relatedProblems} />
  <RelatedLinks title="Related best-parts guides" intro="These are the parts guides worth opening after the diagnosis points at the right repair area." items={relatedBest} />
</ContentLayout>
