---
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { editorialTeam, carTrustPoints } from "../../data/editorial";

const title = "VW Tiguan II facelift maintenance costs and weak points";
const description =
  "What it usually costs to keep a VW Tiguan II facelift sorted, which weak points matter most, and where owners tend to overspend.";
const intro =
  "The facelift Tiguan is not ruinous to own, but it stops feeling affordable fast when owners diagnose it loosely. The real cost pattern comes from brake cleanup done twice, coolant drift ignored too long, ignition-side drivability parts bought in the wrong order, and battery complaints on short-trip cars. The goal is to separate normal running costs from the forum horror-story version.";
const modifiedTime = new Date("2026-04-11");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Guides", href: "/guides/vw-tiguan-ii-facelift-maintenance-costs-and-weak-points/" },
  { label: title }
];
const faqs = [
  {
    question: "Is the facelift Tiguan expensive to maintain?",
    answer:
      "It sits in the middle. It gets expensive mainly when repeat issues are ignored or when owners keep paying for partial brake, cooling, or drivability fixes instead of finishing the repair properly."
  },
  {
    question: "What usually costs money first on a late Mk2 Tiguan?",
    answer:
      "Front brake cleanup, coolant-related work, batteries on short-trip cars, and ignition-side drivability fixes are the most common early money buckets."
  },
  {
    question: "What is the biggest money mistake on this Tiguan?",
    answer:
      "Treating every warning light or small noise like a mystery fault instead of checking the known repeat areas first."
  }
];

const relatedProblems = [
  { href: "/problems/car-shakes-when-braking/", title: "Car shakes when braking", description: "Open this before turning brake vibration into a steering or chassis theory.", eyebrow: "Problem guide" },
  { href: "/problems/coolant-level-drops-with-no-visible-leak/", title: "Coolant level drops with no visible leak", description: "Useful when slow coolant loss is turning into repeated top-ups instead of a real repair.", eyebrow: "Problem guide" },
  { href: "/problems/battery-struggles-after-short-trips/", title: "Battery struggles after short trips", description: "The right next read if the ownership cost story is shifting toward battery reserve and use pattern.", eyebrow: "Problem guide" }
];

const relatedBest = [
  { href: "/best/best-brake-pads-for-vw-tiguan-2020/", title: "Best brake pads for VW Tiguan 2020", description: "Use this when the maintenance story is really about finishing the brake job once instead of repeating it cheaply.", eyebrow: "Brake Pads" },
  { href: "/best/best-brake-rotors-for-vw-tiguan-2020/", title: "Best brake rotors for VW Tiguan 2020", description: "Useful when the front brake budget needs to be realistic instead of optimistic.", eyebrow: "Brake Rotors" },
  { href: "/best/best-coolant-for-vw-tiguan-2020/", title: "Best coolant for VW Tiguan 2020", description: "Open this when coolant cost is less important than avoiding the wrong spec and a second repair.", eyebrow: "Coolant" },
  { href: "/best/best-batteries-for-vw-tiguan-2020/", title: "Best batteries for VW Tiguan 2020", description: "Worth opening when the cost question is really about buying the right reserve once.", eyebrow: "Batteries" }
];

const relatedComparisons = [
  { href: "/comparisons/vw-tiguan-pre-facelift-vs-facelift/", title: "VW Tiguan pre-facelift vs facelift", description: "Use this when maintenance or parts assumptions are getting blurred across the whole Mk2 run.", eyebrow: "Generation guide" },
  { href: "/comparisons/vw-tiguan-fwd-vs-4motion/", title: "VW Tiguan FWD vs 4MOTION", description: "Open this when the running-cost question depends on drivetrain, not just the model year.", eyebrow: "Drivetrain guide" }
];
---

<ContentLayout
  title={title}
  description={description}
  intro={intro}
  image="/images/photos/cars/vw-tiguan-2020.webp"
  modifiedTime={modifiedTime}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  editorialSummary="A maintenance and running-cost overview for the facelift Tiguan, focusing on the weak points that shape ownership cost first."
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={`Reviewed ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
  editorialBadges={["Maintenance guide", "Generation-specific", "Cost-focused"]}
>
  <TrustBlock
    title="How to use this guide"
    summary="Use this guide when the question is not just what breaks, but what usually costs money first and where owners waste that money by repairing the wrong thing."
    byline={`By ${editorialTeam.name}`}
    checkedLabel={`Checked ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
    points={carTrustPoints}
  />

  <Section title="The short version" intro="If you only need the fast read, this is the facelift Tiguan running-cost pattern in plain language.">
    <ul class="grid gap-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Routine maintenance is manageable, but the cost jumps when brake, coolant, and drivability issues are repaired partially instead of cleanly.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">The most common early money buckets are front brakes, small coolant-loss work, batteries on short-trip cars, and spark-side drivability cleanup.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">The worst spending pattern is not one big failure. It is a series of loosely targeted repairs that never fully solve the complaint.</li>
    </ul>
  </Section>

  <Section title="Where the money usually goes first" intro="These are the repair buckets most likely to shape the early ownership-cost story.">
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="eyebrow">Brake system</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Front brake jobs that get repeated</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The first real cost wave often starts here. Cheap pads, weak rotor choices, and incomplete hardware service can turn one job into two.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="eyebrow">Cooling system</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Small coolant-loss repairs that owners postpone</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The drift is often small enough to ignore, which is exactly why it becomes more expensive than it needed to be.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="eyebrow">Electrical reserve</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Battery replacements on short-trip cars</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The battery story is not dramatic, but it becomes annoying enough to cost money earlier on cars that do mostly local use.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="eyebrow">Drivability</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Spark-side diagnosis done in the wrong order</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The expensive part is usually not the first coil or plug. It is replacing parts loosely before the fault path is confirmed.</p>
      </article>
    </div>
  </Section>

  <Section title="Weak points worth budgeting for" intro="These are not guaranteed failures. They are simply the areas most likely to matter in the real ownership budget.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Front brake refreshes deserve a realistic budget instead of the cheapest-possible parts plan.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Coolant seepage and the correct fluid spec matter more than owners usually expect.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Short-trip use makes battery replacement arrive earlier than a highway-driven Tiguan owner might expect.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Smaller front-end wear items are ordinary, but they still need to be handled before the SUV starts feeling rough and overdiagnosed.</li>
    </ul>
  </Section>

  <Section title="How owners overspend" intro="The most expensive Tiguan habits are usually diagnostic mistakes, not exotic failures.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Paying for brake work twice because the first job focused on price instead of hardware and fitment quality.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Topping up coolant for too long instead of confirming why the level is drifting.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Treating EPC and hesitation like a broad electronics problem before ruling out the repeat ignition-side suspects.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Letting minor front-end noises push the diagnosis straight to larger suspension parts.</li>
    </ul>
  </Section>

  <RelatedLinks title="Related problem guides" intro="Open these when the running-cost story is clearly being driven by one repeat complaint." items={relatedProblems} />
  <RelatedLinks title="Related best-parts guides" intro="Use these when the next step is turning the budget into the right parts shortlist." items={relatedBest} />
  <RelatedLinks title="Related comparison guides" intro="Use these when the ownership cost question changes with phase or drivetrain." items={relatedComparisons} />
</ContentLayout>
