---
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { editorialTeam, carTrustPoints } from "../../data/editorial";
import { quickOwnershipGuides } from "../../data/quick-ownership-guides";

export function getStaticPaths() {
  return quickOwnershipGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { slug: guide.slug }
  }));
}

const { slug } = Astro.props;
const guide = quickOwnershipGuides.find((item) => item.slug === slug);

if (!guide) {
  throw new Error(`Quick ownership guide not found for slug: ${slug}`);
}

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Guides", href: "/guides/" },
  { label: guide.title }
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.description,
    image: [new URL(guide.image, Astro.site).toString()],
    mainEntityOfPage: Astro.url.href,
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={guide.title}
  description={guide.description}
  intro="Use this page as the first ownership pass for the vehicle: what it suits, what to avoid, and which checks should happen before buying parts or buying the car."
  image={guide.image}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  editorialSummary="These ownership guides prioritize practical buyer and owner decisions: symptoms to respect, first checks to run, and the next pages worth opening."
  editorialByline={`By ${editorialTeam.name}`}
  editorialBadges={["Ownership guide", "Buyer checks", "Related repairs"]}
>
  <TrustBlock
    summary="This page gives the model a stronger ownership starting point, then links into the more specific problem and best-parts guides already available for the cluster."
    byline={`By ${editorialTeam.name}`}
    points={carTrustPoints}
  />

  <Section id="quick-verdict" title="Quick verdict" intro="Start here if you only need the practical ownership answer.">
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-3xl border border-orange-200/70 bg-orange-50/60 p-6">
        <p class="eyebrow">Verdict</p>
        <p class="mt-3 text-sm leading-6 text-ink">{guide.quickVerdict}</p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <p class="eyebrow">First check</p>
        <p class="mt-3 text-sm leading-6 text-ink">{guide.firstCheck}</p>
      </div>
    </div>
  </Section>

  <Section id="best-for" title="Best for" intro="These are the ownership cases where this model makes the most sense.">
    <ul class="grid gap-3 text-sm leading-6 text-steel sm:grid-cols-2">
      {guide.bestFor.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <Section id="avoid-if" title="Avoid if" intro="These are the shortcuts or condition issues that should change the buying decision.">
    <ul class="grid gap-3 text-sm leading-6 text-steel sm:grid-cols-2">
      {guide.avoidIf.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <Section id="key-checks" title="Key checks" intro="Work through these before accepting a vague explanation or ordering parts.">
    <ol class="space-y-3 text-sm leading-6 text-steel">
      {guide.keyChecks.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ol>
  </Section>

  <Section id="red-flags" title="Red flags" intro="These patterns usually mean the ownership story is riskier than the listing suggests.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {guide.redFlags.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <RelatedLinks
    title="Open next"
    intro="Use these pages when the quick ownership check points toward a specific symptom or repair area."
    items={guide.nextReads}
  />
</ContentLayout>
