---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { comparisonGuides } from "../../data/comparison-guides";
---

<BaseLayout title="Comparisons and Tools" description="Trim, powertrain, and drivetrain comparison guides, with calculators and utilities planned next.">
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Comparisons</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Trim, powertrain, and drivetrain guides</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Start here when the real question is not just the car, but which version of the car the advice actually applies to. Interactive tools and calculators can live here later.
      </p>
    </div>

    {
      comparisonGuides.length > 0 && (
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {comparisonGuides.map((guide) => (
            <a class="surface block p-6 transition hover:-translate-y-0.5" href={guide.href}>
              <p class="eyebrow">{guide.eyebrow}</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink">{guide.title}</h2>
              <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
            </a>
          ))}
        </div>
      )
    }

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <article class="surface p-6">
        <h2 class="text-2xl font-semibold text-ink">Planned utility pages</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>Brake replacement cost calculator</li>
          <li>Oil service interval guide by vehicle</li>
          <li>Tire size and compatibility helper</li>
        </ul>
      </article>
      <article class="surface p-6">
        <h2 class="text-2xl font-semibold text-ink">How to use this section</h2>
        <p class="mt-4 text-sm leading-6 text-steel">
          Use these guides when a normal year page is too broad and the real answer depends on engine choice, drivetrain, hybrid versus gas differences, or trim-level fitment.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
