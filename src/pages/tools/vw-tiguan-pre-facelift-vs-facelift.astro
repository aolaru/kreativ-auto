---
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { editorialTeam, problemTrustPoints } from "../../data/editorial";

const title = "VW Tiguan pre-facelift vs facelift";
const description =
  "A practical comparison of the earlier Mk2 VW Tiguan and the 2020-2024 facelift, including what actually changed for parts buying, diagnosis, and everyday ownership.";
const intro =
  "A lot of Tiguan advice gets repeated as if every Mk2 car is basically the same. That is close enough for broad ownership talk, but not close enough once you start buying parts, comparing trim packages, or assuming a facelifted 2020-2024 car behaves exactly like an earlier 2016-2019 example. This page is here to split those lines cleanly.";
const modifiedTime = new Date("2026-04-06");
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Comparisons", href: "/tools/" },
  { label: title }
];
const faqs = [
  {
    question: "Did the Tiguan facelift change everything mechanically?",
    answer:
      "No. The broad Mk2 ownership pattern still overlaps a lot, especially for the common brake, suspension, and coolant complaints. The facelift matters more for fitment confidence, trim interpretation, interior and front-end details, and keeping late-car advice from being mixed with earlier listings too casually."
  },
  {
    question: "Can I use pre-facelift parts advice on a facelift Tiguan?",
    answer:
      "Sometimes, but not blindly. A lot of the maintenance logic still overlaps, but trim packaging, front-end updates, and catalog split points make it safer to shop late-car pages for late cars and early-car pages for early cars."
  },
  {
    question: "Is the facelift Tiguan the better one to buy?",
    answer:
      "Usually yes if you want the cleaner later-update ownership path, but the right answer still depends on condition, service history, trim, and how careful the earlier owner was."
  }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    mainEntityOfPage: Astro.url.href,
    dateModified: modifiedTime.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];

const relatedProblems = [
  {
    href: "/problems/coolant-level-drops-with-no-visible-leak/",
    title: "Coolant level drops with no visible leak",
    description: "A good next read when facelift-era coolant complaints start getting mixed with older Tiguan advice too loosely.",
    eyebrow: "Problem guide"
  },
  {
    href: "/problems/epc-light-comes-on-under-acceleration/",
    title: "EPC light comes on under acceleration",
    description: "Useful when you want the facelift-era 2.0T diagnosis path without dragging in older generic turbo VW assumptions.",
    eyebrow: "Problem guide"
  },
  {
    href: "/problems/water-leaks-into-cabin-after-heavy-rain/",
    title: "Water leaks into cabin after heavy rain",
    description: "Worth opening if you are trying to separate platform-wide habits from a later-car ownership annoyance.",
    eyebrow: "Problem guide"
  }
];

const relatedBest = [
  {
    href: "/best/best-brake-pads-for-vw-tiguan-2020/",
    title: "Best brake pads for VW Tiguan 2020",
    description: "Useful if the comparison is pushing you toward a facelift-year parts shortlist rather than a generic Mk2 answer.",
    eyebrow: "Brake Pads"
  },
  {
    href: "/best/best-coolant-for-vw-tiguan-2020/",
    title: "Best coolant for VW Tiguan 2020",
    description: "A cleaner fit if you want the later-car coolant logic and VW-compatible fluid choices kept tight.",
    eyebrow: "Coolant"
  },
  {
    href: "/best/best-engine-oil-for-vw-tiguan-2020/",
    title: "Best engine oil for VW Tiguan 2020",
    description: "Useful when the real question is not just the engine family, but the facelift-era service and ownership path.",
    eyebrow: "Engine Oil"
  }
];
---

<ContentLayout
  title={title}
  description={description}
  intro={intro}
  modifiedTime={modifiedTime}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  image="/images/photos/cars/vw-tiguan-2020.webp"
  schemas={schemas}
  editorialSummary="This comparison is built to keep late-car Tiguan advice separate from earlier Mk2 overlap where parts-shopping and fitment assumptions start getting sloppy."
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={`Reviewed ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
  editorialBadges={["Comparison guide", "Generation split checked", "Related pages reviewed"]}
>
  <TrustBlock
    title="Why this comparison matters"
    summary="This page is written to stop late-car Tiguan owners from using broad Mk2 advice where facelift-era fitment, trim splits, and parts shopping need tighter boundaries."
    byline={`By ${editorialTeam.name}`}
    checkedLabel={`Checked ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`}
    points={problemTrustPoints}
  />

  <Section
    title="The short version"
    intro="If you only need the fast answer, this is the cleanest way to separate the earlier Mk2 Tiguan from the 2020-2024 facelift."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <p class="eyebrow">Pre-facelift Mk2</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Still useful if condition is strong and pricing is right</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>Usually the value play if the vehicle is well-kept and you are not chasing the later look or later-package feel.</li>
          <li>Still overlaps heavily with facelift-era diagnosis on the broad platform issues.</li>
          <li>Needs more care when you start borrowing later-year parts advice or facelift-specific assumptions.</li>
        </ul>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <p class="eyebrow">Facelift 2020-2024</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Usually the cleaner ownership path if you want later-car confidence</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>Usually easier to research cleanly because the later update window is closer to how current parts catalogs and owner questions are grouped.</li>
          <li>Better fit if you want later styling, clearer late-cycle model guidance, and less overlap with earlier-car confusion.</li>
          <li>Still not a reason to ignore condition, maintenance history, or trim-level fitment differences.</li>
        </ul>
      </article>
    </div>
  </Section>

  <Section
    title="What the split looks like in practice"
    intro="These visual checkpoints show where the phase change actually matters and where owners overstate it."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white">
        <img
          src="/images/photos/cars/vw-tiguan-2020.webp"
          alt="Volkswagen Tiguan facelift comparison"
          class="h-56 w-full object-cover"
          loading="lazy"
          width="960"
          height="640"
        />
        <div class="p-5">
          <p class="eyebrow">What still overlaps</p>
          <h2 class="mt-3 text-2xl font-semibold text-ink">The platform does not become a different car overnight</h2>
          <p class="mt-3 text-sm leading-6 text-steel">The common brake, coolant, and drivability complaints still live across the broader Mk2 story even when the facelift window is the cleaner research path.</p>
        </div>
      </article>
      <article class="overflow-hidden rounded-3xl border border-slate-200 bg-white">
        <img
          src="/images/photos/parts/bosch-quietcast-pads.jpg"
          alt="Volkswagen Tiguan facelift fitment and parts context"
          class="h-56 w-full object-cover"
          loading="lazy"
          width="960"
          height="640"
        />
        <div class="p-5">
          <p class="eyebrow">Where the split matters</p>
          <h2 class="mt-3 text-2xl font-semibold text-ink">Fitment and parts confidence get cleaner on the facelift side</h2>
          <p class="mt-3 text-sm leading-6 text-steel">The facelift matters most once the owner is shopping parts, sorting trim assumptions, and trying to avoid the broad lazy listings that blur the whole Mk2 run together.</p>
        </div>
      </article>
    </div>
  </Section>

  <Section
    title="Where the real differences show up"
    intro="This is the part that matters most once the conversation moves from broad ownership talk to actual shopping, diagnosis, and parts decisions."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-2xl font-semibold text-ink">Catalog and fitment clarity</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>Facelift cars are easier to keep inside a cleaner parts-shopping window because more late-cycle pages split them out directly.</li>
          <li>Earlier cars can overlap mechanically, but broad listings often blur phase boundaries in a way that creates more buying mistakes.</li>
          <li>If a listing looks lazy or overly broad, the facelift-era Tiguan usually benefits more from a stricter late-car filter.</li>
        </ul>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-2xl font-semibold text-ink">Ownership feel and expectations</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>The facelift does not erase the normal Tiguan complaint areas, but it does change how owners think about the car and what they expect from the later package.</li>
          <li>That matters because buyers often forgive more age-related wear on an earlier car than they will on a facelifted one priced as the newer choice.</li>
          <li>The later car should feel like the cleaner, tighter ownership path, so maintenance sloppiness stands out more sharply.</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section
    title="What still overlaps"
    intro="A lot of the Tiguan story still lives above the facelift split."
  >
    <ul class="grid gap-3 text-sm leading-6 text-steel">
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Coolant seepage, ordinary brake complaints, EPC issues, and normal short-trip battery frustration still overlap more than people expect.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">A good diagnosis still starts with the simple repeat offenders, not with a dramatic theory about the facelift changing everything.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">Where the split matters most is fitment confidence, trim interpretation, and avoiding the wrong earlier or later listing.</li>
      <li class="rounded-2xl bg-slate-50 px-4 py-3">If the car already has a clear brake, coolant, ignition, or battery complaint, disciplined diagnosis still beats overthinking the phase split.</li>
    </ul>
  </Section>

  <Section
    title="Who each one fits better"
    intro="This is the practical shortcut for someone deciding which Tiguan version is the cleaner long-term fit."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-2xl font-semibold text-ink">Choose pre-facelift if</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>The condition and price are strong enough to outweigh the appeal of the later update.</li>
          <li>You are comfortable checking fitment carefully and not assuming every later parts page applies cleanly.</li>
          <li>You want a good Mk2 Tiguan more than you want the later design window specifically.</li>
        </ul>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-2xl font-semibold text-ink">Choose facelift if</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          <li>You want the cleaner late-cycle ownership path with tighter late-year research and parts grouping.</li>
          <li>You prefer starting from the updated version instead of constantly checking where earlier overlap stops.</li>
          <li>You are willing to pay for the later update if the condition and equipment justify it.</li>
        </ul>
      </article>
    </div>
  </Section>

  <Section
    title="Where to go next"
    intro="Use these pages if the facelift split turns into a real diagnosis or buying decision."
  >
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <p class="eyebrow">Start with the late-generation hub</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">VW Tiguan II facelift 2020-2024</h2>
        <p class="mt-3 text-sm leading-6 text-steel">
          Use the facelift hub if you already know you are focused on the later cars and want the best next problem or parts pages from there.
        </p>
        <a class="mt-4 inline-flex text-sm font-semibold text-accent" href="/generations/volkswagen-tiguan-tiguan-ii-facelift-2020-2024/">Open generation hub</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <p class="eyebrow">Use the drivetrain split too</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">VW Tiguan FWD vs 4MOTION</h2>
        <p class="mt-3 text-sm leading-6 text-steel">
          Open the drivetrain guide if your next question is not early versus late, but how the facelift Tiguan changes once 4MOTION enters the picture.
        </p>
        <a class="mt-4 inline-flex text-sm font-semibold text-accent" href="/tools/vw-tiguan-fwd-vs-4motion/">Open drivetrain guide</a>
      </article>
    </div>
  </Section>

  <RelatedLinks
    title="Related problem guides"
    intro="These are the next problem pages worth reading if the facelift split turns into a real repair question."
    items={relatedProblems}
  />

  <RelatedLinks
    title="Related best-parts guides"
    intro="These are the best-parts pages that matter once you decide to stay inside the facelift Tiguan path."
    items={relatedBest}
  />
</ContentLayout>
