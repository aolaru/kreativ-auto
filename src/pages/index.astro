---
import CardIcon from "../components/CardIcon.astro";
import { primaryOwnershipTasks } from "../data/ownership-tasks";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toThumbnail } from "../utils/images";

const reviewedStartingPoints = [
  {
    eyebrow: "Used SUV guide",
    title: "Toyota RAV4 XA50: what to check before buying",
    description: "A source-led inspection path for condition, service records, tires, brakes, battery health, and recall status.",
    href: "/guides/toyota-rav4-xa50-what-to-check-before-buying/",
    image: "/images/photos/cars/toyota-rav4-2021.webp"
  },
  {
    eyebrow: "Ownership guide",
    title: "Toyota RAV4 XA50 common problems",
    description: "Start with the symptom pattern before replacing battery, brake, tire, or suspension parts.",
    href: "/guides/toyota-rav4-xa50-common-problems/",
    image: "/images/photos/cars/toyota-rav4-2021.webp"
  },
  {
    eyebrow: "Used compact-car guide",
    title: "Honda Civic 10th gen facelift: what to check before buying",
    description: "A practical inspection path for engine choice, A/C behavior, maintenance evidence, brakes, and front-end noise.",
    href: "/guides/honda-civic-10th-gen-facelift-what-to-check-before-buying/",
    image: "/images/photos/cars/honda-civic-2019.webp"
  },
  {
    eyebrow: "Used family-SUV guide",
    title: "Toyota Highlander 2020: what to check first",
    description: "Check maintenance records, recall status, brake condition, tires, and battery health before pricing a used Highlander.",
    href: "/cars/toyota-highlander-2020/",
    image: "/images/photos/cars/toyota-highlander-2020.webp"
  }
];
---

<BaseLayout
  enableAds={false}
  title="Used-Car Checks, Problem Diagnosis, and Ownership Guides"
  description="Source-led used-car checks, symptom guides, and ownership research for buyers and owners who need a clear next step."
>
  <section class="container-shell py-12 sm:py-16">
    <div class="surface surface-dark hero-frame p-8 sm:p-12">
      <div class="max-w-4xl">
        <p class="editorial-kicker">Kreativ Auto</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-6xl">Find the next check before you spend.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-steel">
          Search reviewed cars, symptoms, and guides, then follow a practical path for buying used, diagnosing a complaint, planning maintenance, or comparing powertrains.
        </p>
        <a class="mt-8 inline-flex rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:bg-white hover:text-ink" href="/browse/" data-ka-event="homepage_cta_click" data-ka-label="Browse reviewed cars" data-ka-section="hero">
          Browse reviewed cars
        </a>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Start here</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Choose the job in front of you</h2>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          primaryOwnershipTasks.map((task) => (
            <a class="mesh-card flex h-full flex-col p-6 transition hover:-translate-y-0.5 hover:bg-white" href={task.href} data-ka-event="homepage_cta_click" data-ka-label={task.title} data-ka-section="ownership_tasks">
              <CardIcon kind={task.kind} />
              <h3 class="mt-5 text-2xl font-semibold text-ink">{task.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-steel">{task.description}</p>
              <p class="mt-5 text-sm font-semibold text-accent">{task.cta}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Practical tools</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Bring a record, not a guess</h2>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <a class="mesh-card flex h-full flex-col p-6 transition hover:-translate-y-0.5 hover:bg-white" href="/checklists/used-car-viewing/" data-ka-event="tool_open" data-ka-label="Used-car viewing worksheet" data-ka-section="homepage_tools">
          <p class="eyebrow">Buying used</p><h3 class="mt-3 text-2xl font-semibold text-ink">Used-car viewing worksheet</h3><p class="mt-3 flex-1 text-sm leading-6 text-steel">Record VIN checks, documents, cold-start observations, road-test notes, and the price decision in one printable sheet.</p><p class="mt-5 text-sm font-semibold text-accent">Open the worksheet</p>
        </a>
        <a class="mesh-card flex h-full flex-col p-6 transition hover:-translate-y-0.5 hover:bg-white" href="/checklists/maintenance-record/" data-ka-event="tool_open" data-ka-label="Vehicle maintenance record" data-ka-section="homepage_tools">
          <p class="eyebrow">Ownership</p><h3 class="mt-3 text-2xl font-semibold text-ink">Vehicle maintenance record</h3><p class="mt-3 flex-1 text-sm leading-6 text-steel">Keep scheduled work, condition notes, recall checks, invoices, and the next workshop question together.</p><p class="mt-5 text-sm font-semibold text-accent">Open the record</p>
        </a>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface hero-frame p-6 sm:p-8">
      <div>
        <p class="eyebrow">Reviewed starting points</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Choose a vehicle, then a decision</h2>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          reviewedStartingPoints.map((guide) => (
            <a class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href} data-ka-event="homepage_cta_click" data-ka-label={guide.title} data-ka-section="reviewed_guides">
              <div class="image-frame image-frame-card">
                <img src={toThumbnail(guide.image)} alt={guide.title} loading="lazy" decoding="async" width="960" height="640" />
              </div>
              <div class="p-5">
                <p class="eyebrow">{guide.eyebrow}</p>
                <h3 class="mt-2 text-2xl font-semibold text-ink">{guide.title}</h3>
                <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
