---
import { getCollection } from "astro:content";
import CardIcon from "../components/CardIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const featuredCars = cars.slice(0, 3);
const featuredProblems = problems.slice(0, 3);
const featuredBest = bestPages.slice(0, 3);
---

<BaseLayout
  title="Car Problems, Best Parts, and Maintenance Guides"
  description="Kreativ Auto helps drivers diagnose car problems, compare the best replacement parts, and find practical maintenance guidance."
>
  <section class="container-shell py-12 sm:py-16">
    <div class="grid gap-8 xl:grid-cols-[1.2fr_0.8fr]">
      <div class="surface p-8 sm:p-10">
        <p class="eyebrow">Kreativ Auto</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
          Straight answers for car problems, parts, and maintenance.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-steel">
          Kreativ Auto is built for drivers who want to understand what is wrong, what usually fixes it, and which parts are actually worth buying. No filler, no vague advice, and no pretending every problem needs the most expensive option.
        </p>
        <p class="mt-4 max-w-2xl text-base leading-7 text-steel">
          Start with the symptom, the car, or the part category. The goal is always the same: help you get to a better decision faster.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a class="rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white hover:bg-accent" href="/cars/">
            Browse car hubs
          </a>
          <a class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-ink hover:border-accent hover:text-accent" href="/best/">
            Explore best parts
          </a>
          <a class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-ink hover:border-accent hover:text-accent" href="/brands/">
            Browse taxonomies
          </a>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-50 px-5 py-4 ring-1 ring-slate-200">
            <p class="text-2xl font-semibold text-ink">{cars.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Cars</p>
          </div>
          <div class="rounded-2xl bg-slate-50 px-5 py-4 ring-1 ring-slate-200">
            <p class="text-2xl font-semibold text-ink">{problems.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Problems</p>
          </div>
          <div class="rounded-2xl bg-slate-50 px-5 py-4 ring-1 ring-slate-200">
            <p class="text-2xl font-semibold text-ink">{bestPages.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Best Picks</p>
          </div>
        </div>
      </div>

      <div class="grid gap-6">
        <div class="surface p-7">
          <p class="eyebrow">Start Here</p>
          <div class="mt-5 grid gap-4">
            <a class="rounded-2xl border border-slate-200 bg-slate-50 p-4 transition hover:border-accent/40 hover:bg-white" href="/problems/">
              <div class="flex items-center gap-3">
                <CardIcon kind="problem" />
                <div>
                  <h2 class="text-lg font-semibold text-ink">Find a problem guide</h2>
                  <p class="mt-1 text-sm leading-6 text-steel">Start with what the car is doing wrong.</p>
                </div>
              </div>
            </a>
            <a class="rounded-2xl border border-slate-200 bg-slate-50 p-4 transition hover:border-accent/40 hover:bg-white" href="/cars/">
              <div class="flex items-center gap-3">
                <CardIcon kind="car" />
                <div>
                  <h2 class="text-lg font-semibold text-ink">Browse by car</h2>
                  <p class="mt-1 text-sm leading-6 text-steel">Go straight to the vehicle you own or are researching.</p>
                </div>
              </div>
            </a>
            <a class="rounded-2xl border border-slate-200 bg-slate-50 p-4 transition hover:border-accent/40 hover:bg-white" href="/best/">
              <div class="flex items-center gap-3">
                <CardIcon kind="parts" />
                <div>
                  <h2 class="text-lg font-semibold text-ink">Compare parts</h2>
                  <p class="mt-1 text-sm leading-6 text-steel">Use the parts guides when you already know the area you need to fix.</p>
                </div>
              </div>
            </a>
          </div>
        </div>

        <div class="surface p-7">
          <p class="eyebrow">What You Will Find</p>
          <ul class="mt-5 space-y-3 text-sm leading-6 text-steel">
            <li>Car pages with common issues, maintenance notes, and useful parts</li>
            <li>Problem guides that break symptoms into likely causes and realistic fixes</li>
            <li>Best-parts pages that compare options without sounding like a catalog</li>
            <li>More tools and calculators as the site grows</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
      <div class="surface p-6 sm:p-8">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="eyebrow">Featured Cars</p>
            <h2 class="mt-3 text-3xl font-semibold text-ink">Start with the vehicle</h2>
          </div>
          <a class="text-sm font-semibold text-accent underline decoration-accent/30 underline-offset-4" href="/cars/">
            See all cars
          </a>
        </div>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {
            featuredCars.map((car) => (
              <a class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition hover:-translate-y-0.5 hover:bg-white" href={`/cars/${car.id}/`}>
                {
                  car.data.image && (
                    <img
                      src={car.data.image}
                      alt={car.data.title}
                      class="h-40 w-full object-cover"
                      loading="lazy"
                      width="960"
                      height="640"
                    />
                  )
                }
                <div class="p-5">
                  <p class="eyebrow">{car.data.brand}</p>
                  <h3 class="mt-2 text-xl font-semibold text-ink">{car.data.title}</h3>
                  <p class="mt-3 text-sm leading-6 text-steel">{car.data.excerpt ?? car.data.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <div class="surface p-6 sm:p-8">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="eyebrow">Common Problems</p>
            <h2 class="mt-3 text-3xl font-semibold text-ink">Fix the symptom first</h2>
          </div>
          <a class="text-sm font-semibold text-accent underline decoration-accent/30 underline-offset-4" href="/problems/">
            See all problems
          </a>
        </div>
        <div class="mt-6 space-y-4">
          {
            featuredProblems.map((problem) => (
              <a class="block rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-0.5 hover:bg-white" href={`/problems/${problem.id}/`}>
                <div class="flex items-start gap-4">
                  <CardIcon kind="problem" />
                  <div>
                    <h3 class="text-lg font-semibold text-ink">{problem.data.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-steel">
                      {problem.data.excerpt ?? `${problem.data.causes.length} likely causes and ${problem.data.solutions.length} possible solutions.`}
                    </p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface p-6 sm:p-8">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="eyebrow">Best Parts</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Parts guides worth opening</h2>
        </div>
        <a class="text-sm font-semibold text-accent underline decoration-accent/30 underline-offset-4" href="/best/">
          See all parts guides
        </a>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {
          featuredBest.map((entry) => (
            <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-0.5 hover:bg-white" href={`/best/${entry.id}/`}>
              <div class="flex items-center gap-3">
                <CardIcon kind="parts" />
                <div>
                  <p class="eyebrow">{entry.data.category}</p>
                  <h3 class="mt-1 text-lg font-semibold text-ink">{entry.data.title}</h3>
                </div>
              </div>
              <p class="mt-4 text-sm leading-6 text-steel">
                {entry.data.excerpt ?? `${entry.data.products.length} parts compared for ${entry.data.car_model}.`}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-shell pb-12">
    <div class="grid gap-6 md:grid-cols-3">
      <a class="surface block p-6 transition hover:-translate-y-0.5" href="/brands/">
        <CardIcon kind="brand" />
        <p class="eyebrow">Browse</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Brands</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Browse by make if you want to stay inside one brand and compare patterns across models.</p>
      </a>
      <a class="surface block p-6 transition hover:-translate-y-0.5" href="/models/">
        <CardIcon kind="model" />
        <p class="eyebrow">Browse</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Models</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Model pages pull together the problems, maintenance points, and parts that matter for one vehicle.</p>
      </a>
      <a class="surface block p-6 transition hover:-translate-y-0.5" href="/categories/">
        <CardIcon kind="category" />
        <p class="eyebrow">Browse</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Part Categories</h2>
        <p class="mt-3 text-sm leading-6 text-steel">Use category pages when you already know the part type and want the best options by vehicle.</p>
      </a>
    </div>
  </section>
</BaseLayout>
