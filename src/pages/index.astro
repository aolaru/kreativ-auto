---
import { getCollection } from "astro:content";
import CardIcon from "../components/CardIcon.astro";
import { comparisonGuides } from "../data/comparison-guides";
import { ownershipGuides } from "../data/ownership-guides";
import { ownershipTasks } from "../data/ownership-tasks";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toThumbnail } from "../utils/images";

const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const newestProblems = [...problems].sort((a, b) => (b.data.updatedAt?.getTime() ?? 0) - (a.data.updatedAt?.getTime() ?? 0));
const newestBest = [...bestPages].sort((a, b) => (b.data.updatedAt?.getTime() ?? 0) - (a.data.updatedAt?.getTime() ?? 0));

const featuredVehicles = [
  {
    eyebrow: "Best first stop",
    title: "VW Tiguan II facelift",
    description: "Common problems, weak points, service intervals, buying advice, comparisons, and part checks for the facelift-era Tiguan.",
    href: "/guides/vw-tiguan-ii-facelift-common-problems/",
    image: "/images/photos/cars/vw-tiguan-2020.webp"
  },
  {
    eyebrow: "Hybrid and gas context",
    title: "Toyota RAV4 XA50",
    description: "Generation-level ownership guidance for RAV4 buyers comparing reliability, maintenance, and gas-versus-hybrid tradeoffs.",
    href: "/guides/toyota-rav4-xa50-common-problems/",
    image: "/images/photos/cars/toyota-rav4-2021.webp"
  },
  {
    eyebrow: "Daily-driver focus",
    title: "Honda Civic 10th gen facelift",
    description: "A practical entry point for Civic brake, A/C, battery, engine, trim, and used-buyer questions.",
    href: "/guides/honda-civic-10th-gen-facelift-common-problems/",
    image: "/images/photos/cars/honda-civic-2019.webp"
  }
];

const latestPages = [
  ...ownershipGuides.slice(0, 4).map((guide) => ({
    eyebrow: guide.eyebrow,
    title: guide.title,
    description: guide.description,
    href: guide.href,
    image: guide.image,
    kind: "car" as const
  })),
  ...newestProblems.slice(0, 2).map((problem) => ({
    eyebrow: "Problem guide",
    title: problem.data.title,
    description: problem.data.excerpt ?? problem.data.metaDescription,
    href: `/problems/${problem.id}/`,
    image: problem.data.heroImage,
    kind: "problem" as const
  })),
  ...newestBest.slice(0, 2).map((entry) => ({
    eyebrow: entry.data.category,
    title: entry.data.title,
    description: entry.data.excerpt ?? `${entry.data.products.length} parts compared for ${entry.data.car_model}.`,
    href: `/best/${entry.id}/`,
    image: entry.data.heroImage,
    kind: "parts" as const
  }))
].slice(0, 6);

const comparisonCards = comparisonGuides.slice(0, 3);
---

<BaseLayout enableAds={false}
  title="Car Problems, Best Parts, and Maintenance Guides"
  description="Kreativ Auto helps drivers diagnose car problems, compare useful replacement parts, and understand used-car ownership costs."
>
  <section class="container-shell py-12 sm:py-16">
    <div class="surface surface-dark hero-frame p-8 sm:p-12">
      <div class="grid gap-8 xl:grid-cols-[1.15fr_0.85fr] xl:items-end">
        <div>
          <p class="editorial-kicker">Kreativ Auto</p>
          <h1 class="mt-4 max-w-5xl text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
            Get to the right car answer faster.
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-steel">
            Start with what you are trying to decide: buying a used car, diagnosing a symptom, choosing a part, or understanding ownership costs. Each path goes straight to the checks that matter before money changes hands.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <a class="stat-tile stat-link block" href="/cars/" aria-label={`Browse ${cars.length} cars`} data-ka-event="homepage_stat_click" data-ka-label="Cars" data-ka-section="hero_stats">
            <p class="text-2xl font-semibold text-ink">{cars.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Cars</p>
          </a>
          <a class="stat-tile stat-link block" href="/problems/" aria-label={`Browse ${problems.length} problem guides`} data-ka-event="homepage_stat_click" data-ka-label="Problems" data-ka-section="hero_stats">
            <p class="text-2xl font-semibold text-ink">{problems.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Problems</p>
          </a>
          <a class="stat-tile stat-link block" href="/best/" aria-label={`Browse ${bestPages.length} parts guides`} data-ka-event="homepage_stat_click" data-ka-label="Parts guides" data-ka-section="hero_stats">
            <p class="text-2xl font-semibold text-ink">{bestPages.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Parts guides</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Start Here</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Choose the path that matches the job</h2>
        <p class="mt-3 text-base leading-7 text-steel">
          Pick the ownership task first, then narrow by vehicle, symptom, part group, or version.
        </p>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        {
          ownershipTasks.map((task) => (
            <a class="mesh-card flex h-full flex-col p-6 transition hover:-translate-y-0.5 hover:bg-white" href={task.href} data-ka-event="homepage_cta_click" data-ka-label={task.title} data-ka-section="ownership_tasks">
              <CardIcon kind={task.kind} />
              <h3 class="mt-5 text-2xl font-semibold text-ink">{task.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-steel">{task.description}</p>
              <p class="mt-5 text-sm font-semibold text-accent">{task.cta}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Before Money Changes Hands</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">The checks that prevent the most common wrong turns</h2>
        <p class="mt-3 text-base leading-7 text-steel">
          Most expensive ownership mistakes start with a loose assumption: a vibration becomes a wheel bearing, a weak start becomes a starter, or a cheap used car becomes cheap only until the first service visit.
        </p>
      </div>
      <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Buying used</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Match the model year to the generation, check service history, look for repeated tire or brake wear, and price the first maintenance reset before judging the deal.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Diagnosing symptoms</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Road noise, brake shake, coolant loss, warm A/C, and weak starts need a first check before any part gets blamed. The right repair starts with the symptom pattern.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Choosing parts</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Fitment, trim, engine, drivetrain, and normal driving style matter more than buying the most expensive option. A part should match the job, not just the catalog headline.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Comparing versions</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Gas versus hybrid, FWD versus AWD, facelift versus pre-facelift, and engine choices can change maintenance costs, diagnosis, and the parts that make sense.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="accent-panel p-6 sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <div>
          <p class="eyebrow">Fast Examples</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Start from the symptom, not the guess</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="soft-panel p-5">
            <h3 class="text-lg font-semibold text-ink">A shake at highway speed</h3>
            <p class="mt-3 text-sm leading-6 text-steel">Check tires, balance, wheel damage, and wear pattern before blaming hubs or suspension.</p>
          </div>
          <div class="soft-panel p-5">
            <h3 class="text-lg font-semibold text-ink">A battery that keeps dying</h3>
            <p class="mt-3 text-sm leading-6 text-steel">Separate short-trip use, age, reserve capacity, parasitic drain, and charging health before buying parts.</p>
          </div>
          <div class="soft-panel p-5">
            <h3 class="text-lg font-semibold text-ink">A used SUV with a good reputation</h3>
            <p class="mt-3 text-sm leading-6 text-steel">Reputation helps, but condition, service records, tires, brakes, and the first maintenance reset still set the real value.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="surface hero-frame p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Best Starting Points</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Start with these vehicles</h2>
        </div>
        <a class="text-sm font-semibold text-accent underline decoration-accent/30 underline-offset-4" href="/guides/" data-ka-event="homepage_cta_click" data-ka-label="See all guides" data-ka-section="strong_clusters">
          See all guides
        </a>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        {
          featuredVehicles.map((vehicle) => (
            <a class="overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-50 transition hover:-translate-y-0.5 hover:bg-white" href={vehicle.href} data-ka-event="homepage_cta_click" data-ka-label={vehicle.title} data-ka-section="strong_clusters">
              <div class="image-frame image-frame-card">
                <img
                  src={toThumbnail(vehicle.image)}
                  alt={vehicle.title}
                  loading="lazy"
                  decoding="async"
                  width="960"
                  height="640"
                />
              </div>
              <div class="p-5">
                <p class="eyebrow">{vehicle.eyebrow}</p>
                <h3 class="mt-2 text-2xl font-semibold text-ink">{vehicle.title}</h3>
                <p class="mt-3 text-sm leading-6 text-steel">{vehicle.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
      <div class="surface p-6 sm:p-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Useful Now</p>
            <h2 class="mt-3 text-3xl font-semibold text-ink">Newest practical checks</h2>
          </div>
          <a class="text-sm font-semibold text-accent underline decoration-accent/30 underline-offset-4" href="/updates/" data-ka-event="homepage_cta_click" data-ka-label="See updates" data-ka-section="latest_pages">
            See updates
          </a>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {
            latestPages.map((page) => (
              <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-0.5 hover:bg-white" href={page.href} data-ka-event="homepage_cta_click" data-ka-label={page.title} data-ka-section="latest_pages">
                <div class="flex items-start gap-4">
                  <CardIcon kind={page.kind} />
                  <div>
                    <p class="eyebrow">{page.eyebrow}</p>
                    <h3 class="mt-2 text-lg font-semibold text-ink">{page.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-steel">{page.description}</p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <div class="surface p-6 sm:p-8">
        <p class="eyebrow">When Details Matter</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Use comparisons when one answer does not fit every version</h2>
        <div class="mt-6 grid gap-4">
          {
            comparisonCards.map((guide) => (
              <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href} data-ka-event="homepage_cta_click" data-ka-label={guide.title} data-ka-section="comparisons">
                <p class="eyebrow">{guide.eyebrow}</p>
                <h3 class="mt-2 text-lg font-semibold text-ink">{guide.title}</h3>
                <p class="mt-2 text-sm leading-6 text-steel">{guide.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-12">
    <div class="accent-panel p-6 sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="eyebrow">Still Want To Browse?</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Browse when you already know the vehicle or part</h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          <a class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:text-accent" href="/browse/" data-ka-event="homepage_cta_click" data-ka-label="Browse" data-ka-section="browse_indexes">Browse</a>
          <a class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:text-accent" href="/brands/" data-ka-event="homepage_cta_click" data-ka-label="Brands" data-ka-section="browse_indexes">Brands</a>
          <a class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:text-accent" href="/models/" data-ka-event="homepage_cta_click" data-ka-label="Models" data-ka-section="browse_indexes">Models</a>
          <a class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:text-accent" href="/generations/" data-ka-event="homepage_cta_click" data-ka-label="Generations" data-ka-section="browse_indexes">Generations</a>
          <a class="rounded-2xl bg-white px-4 py-3 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:text-accent" href="/categories/" data-ka-event="homepage_cta_click" data-ka-label="Categories" data-ka-section="browse_indexes">Categories</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
