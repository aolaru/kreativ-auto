---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);
---

<BaseLayout
  title="Automotive Affiliate Content Platform"
  description="Kreativ Auto publishes fast, search-optimized car hubs, repair guides, and best-parts comparison pages."
>
  <section class="container-shell py-12 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="surface p-8 sm:p-10">
        <p class="eyebrow">SEO-first automotive publishing</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
          Build authority around vehicles, symptoms, and parts that solve real problems.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-steel">
          Kreativ Auto is structured for content-heavy automotive publishing: car-specific hubs, diagnostic articles, commercial comparison pages, and future utility tools.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a class="rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white hover:bg-accent" href="/cars/">
            Browse car hubs
          </a>
          <a class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-ink hover:border-accent hover:text-accent" href="/best/">
            Explore best parts
          </a>
        </div>
      </div>

      <div class="surface grid gap-5 p-8">
        <div>
          <p class="eyebrow">Content model</p>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
            <li>Car hub pages for model-specific maintenance and ownership topics</li>
            <li>Problem pages for symptoms, likely causes, and repair direction</li>
            <li>Best-parts pages with comparison tables and affiliate-ready product cards</li>
            <li>Expandable tools section for calculators and interactive helpers</li>
          </ul>
        </div>
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-2xl font-semibold text-ink">{cars.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Cars</p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-2xl font-semibold text-ink">{problems.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Problems</p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-2xl font-semibold text-ink">{bestPages.length}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.2em] text-steel">Best Picks</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8">
    <div class="grid gap-6 md:grid-cols-3">
      <article class="surface p-6">
        <p class="eyebrow">Cars</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Model-focused hubs</h2>
        <p class="mt-3 text-sm leading-6 text-steel">
          Create evergreen ownership pages with common problems, service tips, and internal links to supporting guides.
        </p>
      </article>
      <article class="surface p-6">
        <p class="eyebrow">Problems</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Diagnostic intent capture</h2>
        <p class="mt-3 text-sm leading-6 text-steel">
          Answer symptom searches directly with structured sections for symptoms, causes, solutions, and related parts.
        </p>
      </article>
      <article class="surface p-6">
        <p class="eyebrow">Best Parts</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Commercial comparison pages</h2>
        <p class="mt-3 text-sm leading-6 text-steel">
          Publish table-driven product roundups with affiliate disclosures and clear CTAs without sacrificing readability.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
