---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested could not be found on Kreativ Auto."
  noindex={true}
  enableAds={false}
>
  <div class="container-shell py-16 sm:py-24">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">That page does not exist</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        The URL may be outdated, the page may have moved, or the URL is not available yet.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white hover:bg-accent" href="/">
          Go to homepage
        </a>
        <a class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-ink hover:border-accent hover:text-accent" href="/cars/">
          Browse cars
        </a>
      </div>
    </div>

    <section class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Search</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Search by vehicle, symptom, or part</h2>
      <form id="missing-page-search" class="mt-6 flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="missing-page-search-input">Search Kreativ Auto</label>
        <input
          id="missing-page-search-input"
          class="min-h-12 flex-1 rounded-full border border-slate-300 bg-white px-5 text-sm text-ink outline-none transition focus:border-accent focus:ring-4 focus:ring-orange-100"
          type="search"
          placeholder="Try RAV4 battery, brake noise, Tiguan coolant, Civic A/C"
          autocomplete="off"
        />
        <button class="rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white hover:bg-accent" type="submit">
          Search
        </button>
      </form>
      <p class="mt-4 max-w-3xl text-sm leading-6 text-steel">
        Good recovery searches usually include one vehicle and one complaint, such as a model name plus battery, brakes, vibration, coolant, suspension, tires, or A/C.
      </p>
    </section>

    <section class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Find the closest page</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Start from the decision you were trying to make</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <a class="editorial-card block transition hover:-translate-y-0.5 hover:border-orange-300" href="/cars/">
          <h3 class="text-xl font-semibold text-ink">Vehicle pages</h3>
          <p class="mt-3 text-sm leading-6 text-steel">Open a car first when you need model-year context, common problems, maintenance notes, and related parts.</p>
        </a>
        <a class="editorial-card block transition hover:-translate-y-0.5 hover:border-orange-300" href="/problems/">
          <h3 class="text-xl font-semibold text-ink">Problem guides</h3>
          <p class="mt-3 text-sm leading-6 text-steel">Start here for brake noise, weak batteries, vibration, coolant loss, A/C behavior, and other symptoms.</p>
        </a>
        <a class="editorial-card block transition hover:-translate-y-0.5 hover:border-orange-300" href="/best/">
          <h3 class="text-xl font-semibold text-ink">Parts guides</h3>
          <p class="mt-3 text-sm leading-6 text-steel">Use these when the repair area is clear and you need to compare sensible replacement options.</p>
        </a>
        <a class="editorial-card block transition hover:-translate-y-0.5 hover:border-orange-300" href="/guides/">
          <h3 class="text-xl font-semibold text-ink">Ownership guides</h3>
          <p class="mt-3 text-sm leading-6 text-steel">Open broader buying, reliability, maintenance, service, and version guides when one symptom is not enough.</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const missingSearchForm = document.getElementById("missing-page-search");
  const missingSearchInput = document.getElementById("missing-page-search-input");

  missingSearchForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const headerSearch = document.getElementById("site-search");
    const query = missingSearchInput?.value?.trim();
    if (!(headerSearch instanceof HTMLInputElement) || !query) return;
    headerSearch.value = query;
    headerSearch.dispatchEvent(new Event("input", { bubbles: true }));
    headerSearch.focus();
    headerSearch.scrollIntoView({ block: "center", behavior: "smooth" });
  });
</script>
