---
import { getCollection, getEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import ProductCard from "../../components/ProductCard.astro";
import FitmentNotes from "../../components/FitmentNotes.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import DecisionPathBlock from "../../components/DecisionPathBlock.astro";
import EvidenceLimitsBlock from "../../components/EvidenceLimitsBlock.astro";
import { editorialTeam } from "../../data/editorial";
import { comparisonGuides } from "../../data/comparison-guides";
import { ownershipGuides } from "../../data/ownership-guides";
import { hondaCivicGuideQuality } from "../../data/honda-civic-quality";
import { rav4GuideQuality } from "../../data/toyota-rav4-quality";
import { getGenerationLabel, getGenerationRange, getGenerationSlug, includesPhrase, slugify, uniqueByHref } from "../../utils/taxonomy";
import { guideMatchesCar } from "../../utils/relationships";

export async function getStaticPaths() {
  const cars = await getCollection("cars");

  return cars.map((car) => ({
    params: { slug: car.id },
    props: { slug: car.id }
  }));
}

const { slug } = Astro.props;
const car = await getEntry("cars", slug);

if (!car) {
  throw new Error(`Car entry not found for slug: ${slug}`);
}

const [problemEntries, bestEntries] = await Promise.all([
  getCollection("problems"),
  getCollection("best")
]);

const relatedProblems = uniqueByHref(
  problemEntries
  .filter((entry) => {
    return (
      car.data.relatedProblems.includes(entry.id) ||
      car.data.commonProblems.some((problem) => includesPhrase(problem, entry.data.title)) ||
      includesPhrase(entry.data.title, `${car.data.brand} ${car.data.model}`) ||
      includesPhrase(entry.data.title, car.data.model)
    );
  })
  .map((entry) => ({
    href: `/problems/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.excerpt ?? entry.data.metaDescription ?? `Symptoms: ${entry.data.symptoms.slice(0, 2).join(", ")}.`,
    eyebrow: "Problem guide",
    image: entry.data.heroImage
  }))
);

const relatedBest = uniqueByHref(
  bestEntries
  .filter((entry) => {
    return (
      car.data.relatedBest.includes(entry.id) ||
      includesPhrase(entry.data.car_model, `${car.data.brand} ${car.data.model} ${car.data.year}`) ||
      includesPhrase(entry.data.car_model, `${car.data.model} ${car.data.year}`) ||
      includesPhrase(entry.data.car_model, car.data.model)
    );
  })
  .map((entry) => ({
    href: `/best/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.excerpt ?? entry.data.metaDescription ?? `${entry.data.products.length} parts worth comparing for this vehicle.`,
    eyebrow: entry.data.category,
    image: entry.data.heroImage
  }))
);

const relatedComparisons = uniqueByHref(
  comparisonGuides
    .filter((guide) =>
      guideMatchesCar(guide, { id: car.id, generationSlug: getGenerationSlug(car.data) }) ||
      guide.relatedModels?.some((model) => includesPhrase(model, `${car.data.brand} ${car.data.model}`))
    )
    .map((guide) => ({
      href: guide.href,
      title: guide.title,
      description: guide.description,
      eyebrow: guide.eyebrow,
      image: guide.image
    }))
);
const relatedOwnershipGuides = uniqueByHref(
  ownershipGuides
    .filter((guide) => guideMatchesCar(guide, { id: car.id, generationSlug: getGenerationSlug(car.data) }))
    .map((guide) => ({
      href: guide.href,
      title: guide.title,
      description: guide.description,
      eyebrow: guide.eyebrow,
      image: guide.image
    }))
);
const directRelatedLinks = car.data.relatedProblems.length + car.data.relatedBest.length;
const carAdsEnabled = directRelatedLinks >= 3;
const coverageTitle = directRelatedLinks >= 5
  ? "Detailed checks for this car"
  : directRelatedLinks >= 3
    ? "Connected ownership guide"
    : "Focused vehicle overview";
const coverageIntro = carAdsEnabled
  ? "Start with the overview, then move into more specific diagnosis, fitment, and parts decisions."
  : "Start with the vehicle basics, then check the matching sections before moving into broader generation details.";
const coverageCards = [
  {
    label: "Problem guides",
    value: relatedProblems.length,
    description: relatedProblems.length
      ? "Direct symptom and diagnosis pages connected to this car."
      : "The common-problems checklist narrows the first symptom area."
  },
  {
    label: "Parts guides",
    value: relatedBest.length,
    description: relatedBest.length
      ? "Parts comparisons that match this vehicle."
      : "Move to recommended parts only after the symptom points at that repair area."
  },
  {
    label: "Ownership guides",
    value: relatedOwnershipGuides.length,
    description: relatedOwnershipGuides.length
      ? "Longer buyer and maintenance pages for the platform."
      : "Maintenance and fitment notes come before broader model context."
  },
  {
    label: "Comparison guides",
    value: relatedComparisons.length,
    description: relatedComparisons.length
      ? "Trim, powertrain, or platform comparisons that help keep advice specific."
      : "Confirm trim, powertrain, and package differences before ordering parts."
  }
];

const generationHref = `/generations/${getGenerationSlug(car.data)}/`;
const buyingPath = relatedOwnershipGuides.find((guide) => guide.eyebrow === "Used buyer guide" || guide.eyebrow === "Avoid guide");
const maintenancePath = relatedOwnershipGuides.find((guide) => guide.eyebrow === "Maintenance guide" || guide.eyebrow === "Service guide");
const primaryCategoryHref = relatedBest[0]?.eyebrow ? `/categories/${slugify(relatedBest[0].eyebrow)}/` : "/categories/";
const comparisonPath = relatedComparisons[0];
const carStartPaths = [
  {
    eyebrow: "Buying used",
    title: "Check the buying risk",
    description: buyingPath
      ? "Start with the ownership page that covers weak examples, records, and the first repair budget."
      : "Start with the overview, service records, tire condition, and common problems before trusting the listing.",
    href: buyingPath?.href ?? "#overview"
  },
  {
    eyebrow: "Diagnosing problems",
    title: "Match symptoms first",
    description: relatedProblems.length
      ? "Go to the symptom pages before a noise, warning light, vibration, or weak start becomes a parts order."
      : "Start with the common-problems list and narrow the symptom before pricing parts.",
    href: relatedProblems[0]?.href ?? "#common-problems"
  },
  {
    eyebrow: "Maintenance costs",
    title: "Price the first service reset",
    description: maintenancePath
      ? "Check the longer cost or interval page before deciding whether the car is priced fairly."
      : "Review maintenance tips and immediate wear items before treating the price as final.",
    href: maintenancePath?.href ?? "#maintenance-tips"
  },
  {
    eyebrow: "Parts by category",
    title: "Narrow the repair family",
    description: relatedBest.length
      ? "Open the matching part category after the symptom points toward a specific repair area."
      : "Browse part categories only after the repair area is clear.",
    href: primaryCategoryHref
  },
  {
    eyebrow: "Model comparisons",
    title: "Compare the alternative",
    description: comparisonPath
      ? "Open the related comparison when the decision depends on another model, trim, drivetrain, or generation."
      : "Check the generation view when trim, phase, or platform differences matter before buying parts.",
    href: comparisonPath?.href ?? generationHref
  }
];

const carSeoTitleWithBrand = `${car.data.year} ${car.data.brand} ${car.data.model}: Problems & Maintenance`;
const carSeoTitleCompact = `${car.data.year} ${car.data.model}: Problems & Maintenance`;
const computedSeoTitle = carSeoTitleWithBrand.length <= 58 ? carSeoTitleWithBrand : carSeoTitleCompact;
const seoTitle = car.data.metaTitle && car.data.metaTitle.length <= 58 ? car.data.metaTitle : computedSeoTitle;
const seoDescription = car.data.metaDescription ?? car.data.description;
const socialImage = car.data.heroImage ?? car.data.image;
const rav4Quality = car.id === "toyota-rav4-2020" || car.id === "toyota-rav4-2021"
  ? rav4GuideQuality["toyota-rav4-xa50-common-problems"]
  : undefined;
const civicQuality = car.id === "honda-civic-2019"
  ? hondaCivicGuideQuality["honda-civic-10th-gen-facelift-common-problems"]
  : undefined;
const vehicleQuality = rav4Quality ?? civicQuality;
const carTrustPointsForPage = [
  car.data.commonProblems[0]
    ? `${car.data.title} coverage starts with ${car.data.commonProblems[0].toLowerCase()}.`
    : `${car.data.title} coverage starts with the model-year ownership basics.`,
  relatedBest[0]
    ? `${relatedBest[0].eyebrow} parts are linked after the symptom points toward that repair area.`
    : "Recommended parts stay secondary to the symptom and maintenance notes.",
  `${getGenerationLabel(car.data)} notes keep trim, phase, and powertrain differences visible before parts are ordered.`
];
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Cars", href: "/cars/" },
  { label: car.data.title }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: seoTitle,
    description: seoDescription,
    image: socialImage ? [new URL(socialImage, Astro.site).toString()] : undefined,
    mainEntityOfPage: Astro.url.href,
    dateModified: car.data.updatedAt?.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={seoTitle}
  description={seoDescription}
  intro={`${car.data.brand} ${car.data.model} ${car.data.year} ownership guide with common issues, recommended parts, and maintenance advice.`}
  faqs={car.data.faqs}
  image={socialImage}
  modifiedTime={car.data.updatedAt}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  enableAds={carAdsEnabled}
>
  <TrustBlock
    summary={`${car.data.title} is tied to its common issues, matching parts, and the generation notes that change the answer.`}
    byline={`By ${editorialTeam.name}`}
    checkedLabel={car.data.updatedAt ? `Checked ${car.data.updatedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}` : undefined}
    points={carTrustPointsForPage}
  />

  {vehicleQuality && <EvidenceLimitsBlock {...vehicleQuality.evidence} />}
  {vehicleQuality && <DecisionPathBlock title="Ownership decision path" intro="Keep the symptom tied to evidence before it turns into a parts order or a broad repair theory." steps={vehicleQuality.decisionPath} />}

  <section class="container-shell py-6">
    <div class="accent-panel p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Start Here</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Pick the path that matches the job</h2>
        <p class="mt-3 text-sm leading-6 text-steel">
          Pick the shortcut that matches the job before scrolling through every section.
        </p>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {
          carStartPaths.map((path) => (
            <a
              class="flex h-full flex-col rounded-3xl border border-orange-200/70 bg-white p-5 transition hover:-translate-y-0.5 hover:border-orange-300"
              href={path.href}
              data-ka-event="car_start_path_click"
              data-ka-label={path.title}
              data-ka-section={car.id}
            >
              <p class="eyebrow">{path.eyebrow}</p>
              <h3 class="mt-3 text-xl font-semibold text-ink">{path.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-steel">{path.description}</p>
              <p class="mt-5 text-sm font-semibold text-accent">Open path</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Section id="coverage-depth" title={coverageTitle} intro={coverageIntro}>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        coverageCards.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p class="eyebrow">{item.label}</p>
            <p class="mt-3 text-3xl font-semibold text-ink">{item.value}</p>
            <p class="mt-3 text-sm leading-6 text-steel">{item.description}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    id="overview"
    title="Overview"
    intro="A quick view of what owners and shoppers should know before diving into repairs or upgrades."
  >
    <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr]">
      <div>
        {
          car.data.image && (
            <div class="mb-5 overflow-hidden rounded-3xl border border-slate-200 bg-slate-50">
              <img
                src={car.data.image}
                alt={car.data.title}
                class="h-72 w-full object-cover sm:h-80"
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
        <div class="max-w-none text-base leading-7 text-steel">
          <p>{car.data.description}</p>
        </div>
      </div>
      <div class="rounded-3xl bg-slate-50 p-6">
        <dl class="grid gap-4 text-sm">
          <div>
            <dt class="font-semibold text-ink">Brand</dt>
            <dd class="mt-1 text-steel">{car.data.brand}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Model</dt>
            <dd class="mt-1 text-steel">{car.data.model}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Year</dt>
            <dd class="mt-1 text-steel">{car.data.year}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Generation</dt>
            <dd class="mt-1 text-steel">
              <a class="text-accent hover:underline" href={`/generations/${getGenerationSlug(car.data)}/`}>
                {getGenerationLabel(car.data)}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Generation range</dt>
            <dd class="mt-1 text-steel">{getGenerationRange(car.data)}</dd>
          </div>
          {
            car.data.phase && (
              <div>
                <dt class="font-semibold text-ink">Phase</dt>
                <dd class="mt-1 text-steel">
                  {car.data.phase}
                  {car.data.phaseYears ? ` (${car.data.phaseYears})` : ""}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </Section>

  <Section
    id="common-problems"
    title="Common problems"
    intro="These are the issues owners usually notice first before the repair turns into a bigger annoyance."
  >
    <ul class="grid gap-3 text-sm leading-6 text-steel sm:grid-cols-2">
      {car.data.commonProblems.map((problem) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{problem}</li>)}
    </ul>
  </Section>

  {
    (car.data.fitment.appliesTo.length > 0 ||
      car.data.fitment.doesNotApplyTo.length > 0 ||
      car.data.fitment.phaseDifferences.length > 0 ||
      car.data.fitment.powertrainDifferences.length > 0) && (
      <Section
        id="fitment-notes"
        title="Fitment and model notes"
        intro="Use these notes to avoid applying the same advice across trims, phases, or powertrains that behave differently."
      >
        <FitmentNotes fitment={car.data.fitment} />
      </Section>
    )
  }

  <Section
    id="recommended-parts"
    title="Recommended parts"
    intro="These are the parts worth looking at first if you are trying to solve a common issue or stay ahead of wear."
  >
    <div class="grid gap-6 md:grid-cols-2">
      {car.data.recommendedParts.map((product) => <ProductCard product={product} />)}
    </div>
  </Section>

  <Section
    id="maintenance-tips"
    title="Maintenance tips"
    intro="These are the maintenance habits most likely to keep the common complaints from getting expensive."
  >
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {car.data.maintenanceTips.map((tip) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{tip}</li>)}
    </ul>
  </Section>

  <RelatedLinks
    title="Related problem guides"
    intro="If one of the common issues below sounds familiar, these guides go deeper into what to check and what usually fixes it."
    items={relatedProblems}
    imageLimit={2}
  />

  <RelatedLinks
    title="Related best parts pages"
    intro="These parts guides are useful if you already know the area you are dealing with and want to compare options."
    items={relatedBest}
    imageLimit={0}
  />

  <RelatedLinks
    title="Flagship ownership guides"
    intro="Use these longer guides when you want the repeat-pattern view for the platform before narrowing down to one specific symptom."
    items={relatedOwnershipGuides}
    imageLimit={1}
  />

  <RelatedLinks
    title="Trim and powertrain guides"
    intro="Use these comparison guides when the next question is which version of the car the advice actually applies to."
    items={relatedComparisons}
    imageLimit={1}
  />
</ContentLayout>
