---
import { getCollection } from "astro:content";
import CardIcon from "../../components/CardIcon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toThumbnail } from "../../utils/images";

const cars = await getCollection("cars");
const newestCars = [...cars].sort((a, b) => (b.data.updatedAt?.getTime() ?? 0) - (a.data.updatedAt?.getTime() ?? 0));

const civicCars = newestCars.filter((car) => car.id === "honda-civic-2019");
const rav4Cars = newestCars.filter((car) => car.id === "toyota-rav4-2021" || car.id === "toyota-rav4-2020");
const tiguanCars = newestCars.filter((car) => car.id === "vw-tiguan-2020");

const featuredPaths = [
  {
    title: "Compare by generation",
    description: "Start here when multiple years share the same parts, problems, and facelift-era behavior.",
    href: "/generations/"
  },
  {
    title: "Browse by model",
    description: "Best when one vehicle line has several model years or generation changes to compare.",
    href: "/models/"
  },
  {
    title: "Browse by brand",
    description: "Best when you want to compare models from the same automaker.",
    href: "/brands/"
  }
];
---

<BaseLayout enableAds={false} title="Cars" description="Vehicle-specific ownership guides covering maintenance, common issues, and recommended parts.">
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Cars</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Find the right car first</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Start with a vehicle when you want the ownership picture before narrowing into a symptom, part, or used-buying check.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <section class="surface p-6">
        <p class="eyebrow">Civic focus</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Honda Civic 2019</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The cleanest starting point for Civic commuter problems, brake refinement, A/C behavior, and the parts that matter once the car starts feeling tired.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {civicCars.map((car) => <li><a class="hover:text-accent" href={`/cars/${car.id}/`}>{car.data.title}</a></li>)}
        </ul>
        <a class="mt-4 inline-flex text-sm font-semibold text-accent" href="/generations/honda-civic-fc-fk-facelift-2019-2021/">Open Civic generation</a>
      </section>
      <section class="surface p-6">
        <p class="eyebrow">RAV4 focus</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Toyota RAV4 XA50</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The best place to start for everyday RAV4 battery complaints, suspension noises, brake refinement, and gas-versus-hybrid ownership differences.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {rav4Cars.map((car) => <li><a class="hover:text-accent" href={`/cars/${car.id}/`}>{car.data.title}</a></li>)}
        </ul>
        <a class="mt-4 inline-flex text-sm font-semibold text-accent" href="/generations/toyota-rav4-xa50-2019-2021/">Open RAV4 generation</a>
      </section>
      <section class="surface p-6">
        <p class="eyebrow">Tiguan focus</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">VW Tiguan II facelift</h2>
        <p class="mt-3 text-sm leading-6 text-steel">The strongest late-model Tiguan entry point for coolant loss, EPC behavior, oil use, drivetrain comparisons, and facelift-era parts buying.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {tiguanCars.map((car) => <li><a class="hover:text-accent" href={`/cars/${car.id}/`}>{car.data.title}</a></li>)}
        </ul>
        <a class="mt-4 inline-flex text-sm font-semibold text-accent" href="/generations/volkswagen-tiguan-tiguan-ii-facelift-2020-2024/">Open Tiguan generation</a>
      </section>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        featuredPaths.map((path) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={path.href}>
            <div class="flex items-center gap-3">
              <CardIcon kind="car" />
              <div>
                <p class="eyebrow">Browse</p>
                <h2 class="mt-1 text-2xl font-semibold text-ink">{path.title}</h2>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-steel">{path.description}</p>
          </a>
        ))
      }
    </div>

    <section class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Choosing the right entry point</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Model year, generation, or symptom?</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Use the car page</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Best when you know the exact year and want one place for common issues, maintenance habits, and matching parts.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Use the generation page</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Better when several years share the same platform, facelift, engine family, or part behavior.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Use a problem page</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Better when the vehicle already has a complaint and the first job is separating likely causes from similar symptoms.
          </p>
        </article>
      </div>
      <p class="mt-6 text-sm leading-6 text-steel">
        If you are still deciding between vehicles, open the generation or comparison pages before the exact model year. If you already own the car, start with the symptom and come back to the car page for fitment and maintenance context.
      </p>
    </section>

    <div class="mt-10 grid gap-6">
      {
        newestCars.map((car, index) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/cars/${car.id}/`}>
            <div class="mb-4 flex items-center gap-3">
              <CardIcon kind="car" />
              <div>
                <p class="eyebrow">{car.data.brand}</p>
                <h2 class="mt-1 text-2xl font-semibold text-ink">{car.data.title}</h2>
              </div>
            </div>
            {
              car.data.image && index < 6 && (
                <div class="mb-5 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={toThumbnail(car.data.image)}
                    alt={car.data.title}
                    class="h-52 w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="text-sm leading-6 text-steel">{car.data.excerpt ?? car.data.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
