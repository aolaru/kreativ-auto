---
import ContentLayout from "../../layouts/ContentLayout.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { editorialTeam, problemTrustPoints } from "../../data/editorial";
import { comparisonGuideDetails } from "../../data/comparison-guide-details";

export function getStaticPaths() {
  return comparisonGuideDetails.map((guide) => ({
    params: { slug: guide.slug },
    props: { slug: guide.slug }
  }));
}

const { slug } = Astro.props;
const guide = comparisonGuideDetails.find((item) => item.slug === slug);

if (!guide) {
  throw new Error(`Comparison guide not found for slug: ${slug}`);
}

const modifiedTime = new Date(guide.modifiedTime);
const reviewedLabel = `Reviewed ${modifiedTime.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}`;
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Comparisons", href: "/comparisons/" },
  { label: guide.title }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.description,
    image: [new URL(guide.image, Astro.site).toString()],
    mainEntityOfPage: Astro.url.href,
    dateModified: modifiedTime.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={guide.title}
  description={guide.description}
  intro={guide.intro}
  image={guide.image}
  modifiedTime={modifiedTime}
  breadcrumbs={breadcrumbs}
  faqs={guide.faqs}
  schemas={schemas}
  editorialSummary={guide.editorialSummary}
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={reviewedLabel}
  editorialBadges={guide.badges}
>
  <TrustBlock
    title="Best starting point"
    summary={guide.trustSummary}
    byline={`By ${editorialTeam.name}`}
    checkedLabel={reviewedLabel}
    points={problemTrustPoints}
  />

  <Section id="decision-summary" title="Decision summary" intro="Start with the buying answer, then check the sections below for the details that change the decision.">
    <ul class="grid gap-3 text-sm leading-6 text-steel">
      {guide.summaryPoints.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  {
    guide.sections.map((section) => (
      <Section id={section.id} title={section.title} intro={section.intro}>
        {section.cards && (
          <div class="grid gap-6 lg:grid-cols-2">
            {section.cards.map((item) => (
              <article class="rounded-3xl border border-slate-200 bg-white p-6">
                <p class="eyebrow">{item.eyebrow}</p>
                <h2 class="mt-3 text-2xl font-semibold text-ink">{item.title}</h2>
                <p class="mt-3 text-sm leading-6 text-steel">{item.text}</p>
              </article>
            ))}
          </div>
        )}

        {section.list && (
          <ul class="space-y-3 text-sm leading-6 text-steel">
            {section.list.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
          </ul>
        )}

        {section.ordered && (
          <ol class="space-y-3 text-sm leading-6 text-steel">
            {section.ordered.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
          </ol>
        )}

        {section.paragraphs && (
          <div class="space-y-4 text-sm leading-6 text-steel">
            {section.paragraphs.map((item) => <p>{item}</p>)}
          </div>
        )}
      </Section>
    ))
  }

  <RelatedLinks
    title="Open next"
    intro="Move into the matching ownership page once one vehicle is the stronger candidate."
    items={guide.relatedReads}
  />
</ContentLayout>
