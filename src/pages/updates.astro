---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type UpdateKind = "NEW" | "UPDATE" | "FIX";

interface UpdateEntry {
  date: string;
  kind: UpdateKind;
  title: string;
  detail: string;
  href?: string;
  linkLabel?: string;
}

const highlights: UpdateEntry[] = [
  {
    date: "2026-08-20",
    kind: "NEW",
    title: "2020 Toyota Highlander research",
    detail:
      "Added a reviewed Highlander vehicle page, a used-buyer inspection, a model-specific brake-noise diagnosis, and a sourced parts shortlist.",
    href: "/guides/toyota-highlander-xu70-what-to-check-before-buying/",
    linkLabel: "Read the Highlander buyer guide"
  },
  {
    date: "2026-08-20",
    kind: "UPDATE",
    title: "Clearer vehicle discovery",
    detail:
      "The homepage and header now lead to reviewed cars more directly, with a vehicle directory available on desktop and mobile.",
    href: "/browse/",
    linkLabel: "Browse reviewed cars"
  },
  {
    date: "2026-08-20",
    kind: "FIX",
    title: "Stronger publishing controls",
    detail:
      "Noindex pages remain crawlable through links, unverified parts prices stay hidden, and reviewed pages now expose their model-specific notes.",
    href: "/editorial-review/",
    linkLabel: "Read the editorial review"
  }
];

const recentUpdates: UpdateEntry[] = [
  {
    date: "2026-08-25",
    kind: "NEW",
    title: "Used-car viewing worksheet",
    detail:
      "Added a printable inspection record for documents, cold-start checks, road-test notes, and price decisions, including RAV4 XA50 and Civic facelift addenda with manufacturer and regulator references.",
    href: "/checklists/used-car-viewing/",
    linkLabel: "Open the worksheet"
  },
  {
    date: "2026-08-25",
    kind: "FIX",
    title: "Privacy and price-verification safeguards",
    detail:
      "Optional analytics now waits for an explicit visitor choice, advertising remains disabled, and parts prices stay hidden unless a dated product-level price source is available."
  },
  {
    date: "2026-08-20",
    kind: "UPDATE",
    title: "Content and discovery review",
    detail:
      "Removed repeated template framing from vehicle, diagnosis, and parts pages; refreshed the homepage; made the vehicle directory indexable; and expanded the public editorial accountability record."
  },
  {
    date: "2026-08-20",
    kind: "NEW",
    title: "2020 Toyota Highlander coverage",
    detail:
      "Added evidence and scope records for the 2020 Highlander, a used-buyer inspection, related vehicle and brake-noise pages, and updated internal search coverage."
  },
  {
    date: "2026-08-20",
    kind: "UPDATE",
    title: "New-car publishing workflow",
    detail:
      "New vehicle drafts now require an evidence record, stated scope, a decision path, source links, product-selection criteria, alternatives, and optimized vehicle photography before publication."
  },
  {
    date: "2026-08-19",
    kind: "UPDATE",
    title: "Search quality and deployment checks",
    detail:
      "Improved source-led ownership pages, search discovery, analytics coverage, Pages deployment efficiency, and the local review workflow used before a change is published."
  },
  {
    date: "2026-08-18",
    kind: "UPDATE",
    title: "Brand and analytics refresh",
    detail:
      "Replaced the header and site-mark logo assets and added Cloudflare Web Analytics alongside the existing site measurement setup."
  },
  {
    date: "2026-07-15",
    kind: "FIX",
    title: "Content-quality and AdSense safeguards",
    detail:
      "Removed thin or self-referential copy, strengthened source and scope rules, improved page navigation, and kept commercial pages out of search until they provide enough useful detail."
  },
  {
    date: "2026-06-27",
    kind: "NEW",
    title: "Ownership guides and task navigation",
    detail:
      "Added more buying, maintenance, diagnosis, and comparison entry points so visitors can begin with the job they need to complete."
  },
  {
    date: "2026-06-18",
    kind: "NEW",
    title: "More vehicle research and real imagery",
    detail:
      "Expanded the vehicle and ownership-guide library, added real car photography, and improved links between model, generation, problem, and parts research."
  },
  {
    date: "2026-06-16",
    kind: "FIX",
    title: "Generated-sounding copy cleanup",
    detail:
      "Removed language about the publication process, category structure, and internal coverage so pages focus on the vehicle, symptom, or buying decision."
  },
  {
    date: "2026-06-12",
    kind: "UPDATE",
    title: "Publishing safeguards",
    detail:
      "Added checks for sitemap accuracy, image references, page depth, advertising eligibility, and source-and-scope sections on indexable research pages."
  },
  {
    date: "2026-06-07",
    kind: "NEW",
    title: "Four additional vehicle topics",
    detail:
      "Added new vehicle, problem, and parts research for additional mainstream used-car decisions, then connected the entries to internal search and browse routes."
  },
  {
    date: "2026-06-07",
    kind: "FIX",
    title: "Google Analytics rendering",
    detail:
      "Corrected the Google Analytics tag so measurement can load on the published domain."
  }
];

const archiveUpdates: UpdateEntry[] = [
  {
    date: "2026-05-30",
    kind: "UPDATE",
    title: "Early AdSense readiness work",
    detail:
      "Added ads.txt, expanded trust and policy information, improved source links, and reduced thin-content risk across the first public guides."
  },
  {
    date: "2026-05-26",
    kind: "UPDATE",
    title: "Image and identity refresh",
    detail:
      "Added missing optimized car images and refined the Kreativ Auto logo used across the website."
  },
  {
    date: "2026-05-13",
    kind: "UPDATE",
    title: "Health checks and second-tier coverage",
    detail:
      "Added repository checks for image quality and broken references while expanding useful ownership topics beyond the first core models."
  },
  {
    date: "2026-03-01",
    kind: "NEW",
    title: "Kreativ Auto launch",
    detail:
      "Published the first vehicle, problem, and parts research; added public navigation, search metadata, trust pages, and the kreativauto.com domain."
  }
];

const kindClass: Record<UpdateKind, string> = {
  NEW: "bg-emerald-100 text-emerald-800",
  UPDATE: "bg-sky-100 text-sky-800",
  FIX: "bg-amber-100 text-amber-900"
};
---

<BaseLayout
  enableAds={false}
  title="Updates"
  description="A chronological record of meaningful Kreativ Auto additions, improvements, and fixes."
>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Updates" }]} />

    <section class="surface hero-frame p-8 sm:p-10">
      <p class="eyebrow">Product updates</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold text-ink sm:text-5xl">Latest updates</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        A chronological record of meaningful additions, improvements, and fixes. Vehicle research belongs in the car and guide directories; this log explains what changed and when.
      </p>
      <div class="mt-6 flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-[0.16em]">
        <span class="rounded-full bg-emerald-100 px-3 py-2 text-emerald-800">NEW: added for the first time</span>
        <span class="rounded-full bg-sky-100 px-3 py-2 text-sky-800">UPDATE: materially improved</span>
        <span class="rounded-full bg-amber-100 px-3 py-2 text-amber-900">FIX: corrected or repaired</span>
      </div>
    </section>

    <section class="mt-10 grid gap-5 md:grid-cols-3" aria-label="Recent update highlights">
      {
        highlights.map((item) => (
          <article class="editorial-card flex flex-col p-6">
            <div class="flex items-center justify-between gap-3">
              <span class={`rounded-full px-3 py-1 text-xs font-bold tracking-[0.12em] ${kindClass[item.kind]}`}>{item.kind}</span>
              <time class="text-xs font-semibold text-steel" datetime={item.date}>{item.date}</time>
            </div>
            <h2 class="mt-5 text-xl font-semibold text-ink">{item.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-6 text-steel">{item.detail}</p>
            {item.href && <a class="mt-5 text-sm font-semibold text-accent hover:text-ink" href={item.href}>{item.linkLabel}</a>}
          </article>
        ))
      }
    </section>

    <section class="mt-12">
      <div class="max-w-3xl">
        <p class="eyebrow">Recent log</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">What changed most recently</h2>
      </div>
      <ol class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
        {
          recentUpdates.map((item) => (
            <li class="grid gap-4 py-6 sm:grid-cols-[9rem_1fr]">
              <div class="flex items-center gap-3 sm:block">
                <time class="block text-sm font-semibold text-ink" datetime={item.date}>{item.date}</time>
                <span class={`mt-2 inline-flex rounded-full px-3 py-1 text-xs font-bold tracking-[0.12em] ${kindClass[item.kind]}`}>{item.kind}</span>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-steel">{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <details class="mt-10 border-y border-slate-200 py-5">
      <summary class="cursor-pointer text-lg font-semibold text-ink marker:text-accent">Earlier updates</summary>
      <ol class="mt-4 divide-y divide-slate-200">
        {
          archiveUpdates.map((item) => (
            <li class="grid gap-4 py-6 sm:grid-cols-[9rem_1fr]">
              <div class="flex items-center gap-3 sm:block">
                <time class="block text-sm font-semibold text-ink" datetime={item.date}>{item.date}</time>
                <span class={`mt-2 inline-flex rounded-full px-3 py-1 text-xs font-bold tracking-[0.12em] ${kindClass[item.kind]}`}>{item.kind}</span>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-steel">{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </details>
  </div>
</BaseLayout>
