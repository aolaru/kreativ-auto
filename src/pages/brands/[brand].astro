---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import { ownershipGuides } from "../../data/ownership-guides";
import { generationHubContent } from "../../data/generation-hubs";
import { toThumbnail } from "../../utils/images";
import { getGenerationKey, getGenerationLabel, getGenerationRange, getGenerationSlug, slugify, uniqueByHref } from "../../utils/taxonomy";

export async function getStaticPaths() {
  const cars = await getCollection("cars");
  const brands = Array.from(new Set(cars.map((car) => car.data.brand)));

  return brands.map((brand) => ({
    params: { brand: slugify(brand) },
    props: { brand }
  }));
}

const { brand } = Astro.props;
const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const brandCars = cars.filter((car) => car.data.brand === brand);
const linkedProblems = uniqueByHref(
  problems
    .filter((problem) =>
      brandCars.some((car) => car.data.relatedProblems.includes(problem.id))
    )
    .map((problem) => ({
      href: `/problems/${problem.id}/`,
      title: problem.data.title,
      description: problem.data.excerpt ?? problem.data.metaDescription,
      eyebrow: "Problem guide"
    }))
);
const linkedBest = uniqueByHref(
  bestPages
    .filter((entry) =>
      brandCars.some((car) => car.data.relatedBest.includes(entry.id))
    )
    .map((entry) => ({
      href: `/best/${entry.id}/`,
      title: entry.data.title,
      description: entry.data.excerpt ?? entry.data.metaDescription,
      eyebrow: entry.data.category
    }))
);
const linkedOwnershipGuides = uniqueByHref(
  ownershipGuides
    .filter((guide) => brandCars.some((car) => guide.relatedCars?.includes(car.id)))
    .map((guide) => ({
      href: guide.href,
      title: guide.title,
      description: guide.description,
      eyebrow: guide.eyebrow,
      image: guide.image
    }))
);
const generationGroups = Array.from(
  brandCars.reduce((map, car) => {
    const key = getGenerationKey(car.data);
    const current = map.get(key) ?? [];
    current.push(car);
    map.set(key, current);
    return map;
  }, new Map<string, typeof brandCars>())
).map(([, entries]) => {
  const lead = entries[0];
  const generationSlug = getGenerationSlug(lead.data);
  const relatedProblems = linkedProblems.filter((item) =>
    entries.some((car) => car.data.relatedProblems.some((slug) => item.href === `/problems/${slug}/`))
  );
  const relatedBest = linkedBest.filter((item) =>
    entries.some((car) => car.data.relatedBest.some((slug) => item.href === `/best/${slug}/`))
  );

  return {
    lead,
    entries: [...entries].sort((a, b) => a.data.year - b.data.year),
    generationSlug,
    hasEditorialHub: Boolean(generationHubContent[generationSlug]),
    relatedProblems,
    relatedBest
  };
});

const featuredGenerations = [...generationGroups]
  .sort(
    (a, b) =>
      Number(b.hasEditorialHub) - Number(a.hasEditorialHub) ||
      b.relatedProblems.length + b.relatedBest.length - (a.relatedProblems.length + a.relatedBest.length)
  )
  .slice(0, 3);

const modelGroups = Array.from(
  brandCars.reduce((map, car) => {
    const key = car.data.model;
    const current = map.get(key) ?? [];
    current.push(car);
    map.set(key, current);
    return map;
  }, new Map<string, typeof brandCars>())
)
  .map(([model, entries]) => ({
    model,
    entries,
    featuredGeneration: featuredGenerations.find((group) => group.entries.some((entry) => entry.data.model === model))
  }))
  .sort((a, b) => b.entries.length - a.entries.length || a.model.localeCompare(b.model));

const startHere = featuredGenerations[0];
const linkedCoverageCount = linkedProblems.length + linkedBest.length + linkedOwnershipGuides.length;
const shouldNoindex = brandCars.length < 2 && linkedCoverageCount < 4;

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Brands", href: "/brands/" },
  { label: brand }
];
---

<BaseLayout enableAds={false} noindex={shouldNoindex} title={`${brand} Cars`} description={`Browse ${brand} car hub pages, linked problems, and best-parts comparisons.`}>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Brand Hub</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{brand}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Start with the strongest generation hub for {brand}, then drill into the model years, problem guides, and parts pages that already have the best coverage.
      </p>
    </div>

    {
      startHere && (
        <div class="mt-10">
          <Section
            title={`Start here with ${getGenerationLabel(startHere.lead.data)}`}
            intro={`This is the clearest way into the strongest ${brand} coverage currently on the site.`}
          >
            <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
              <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={`/generations/${startHere.generationSlug}/`}>
                <p class="eyebrow">Featured generation hub</p>
                <h3 class="mt-3 text-2xl font-semibold text-ink">{getGenerationLabel(startHere.lead.data)}</h3>
                {
                  (startHere.lead.data.heroImage ?? startHere.lead.data.image) && (
                    <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                      <img
                        src={toThumbnail(startHere.lead.data.heroImage ?? startHere.lead.data.image)}
                        alt={getGenerationLabel(startHere.lead.data)}
                        class="h-56 w-full object-cover"
                        loading="lazy"
                        decoding="async"
                        width="960"
                        height="640"
                      />
                    </div>
                  )
                }
                <p class="mt-3 text-sm leading-6 text-steel">
                  Covers the {getGenerationRange(startHere.lead.data)} window with linked year pages, common problems, and best-parts guides.
                </p>
                <p class="mt-4 text-sm font-semibold text-accent">Open generation hub</p>
              </a>
              <div class="grid gap-4">
                {startHere.relatedProblems.slice(0, 2).map((item) => (
                  <a class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-accent/40" href={item.href}>
                    <p class="eyebrow">{item.eyebrow}</p>
                    <h3 class="mt-2 text-lg font-semibold text-ink">{item.title}</h3>
                    {item.description && <p class="mt-2 text-sm leading-6 text-steel">{item.description}</p>}
                  </a>
                ))}
              </div>
            </div>
          </Section>
        </div>
      )
    }

    <div class="mt-10 space-y-8">
      <Section
        title="Best generation hubs in this brand"
        intro={`These are the ${brand} generation clusters with the clearest path into deeper troubleshooting and parts content.`}
      >
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {featuredGenerations.map((group) => (
            <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={`/generations/${group.generationSlug}/`}>
              <p class="eyebrow">Generation hub</p>
              <h3 class="mt-3 text-2xl font-semibold text-ink">{getGenerationLabel(group.lead.data)}</h3>
              {
                (group.lead.data.heroImage ?? group.lead.data.image) && (
                  <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                    <img
                      src={toThumbnail(group.lead.data.heroImage ?? group.lead.data.image)}
                      alt={getGenerationLabel(group.lead.data)}
                      class="h-48 w-full object-cover"
                      loading="lazy"
                      decoding="async"
                      width="960"
                      height="640"
                    />
                  </div>
                )
              }
              <p class="mt-3 text-sm leading-6 text-steel">
                {getGenerationRange(group.lead.data)} with {group.relatedProblems.length} problem guide{group.relatedProblems.length === 1 ? "" : "s"} and {group.relatedBest.length} parts page{group.relatedBest.length === 1 ? "" : "s"}.
              </p>
            </a>
          ))}
        </div>
      </Section>

      <Section title="Models in this brand" intro="Use the model hubs if you want the full year-by-year picture before narrowing down to a generation.">
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {modelGroups.map((group) => (
            <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={`/models/${slugify(`${brand} ${group.model}`)}/`}>
              <p class="eyebrow">Model hub</p>
              <h3 class="mt-3 text-2xl font-semibold text-ink">{brand} {group.model}</h3>
              {
                (group.featuredGeneration?.lead.data.heroImage ?? group.featuredGeneration?.lead.data.image) && (
                  <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                    <img
                      src={toThumbnail(group.featuredGeneration?.lead.data.heroImage ?? group.featuredGeneration?.lead.data.image)}
                      alt={`${brand} ${group.model}`}
                      class="h-48 w-full object-cover"
                      loading="lazy"
                      decoding="async"
                      width="960"
                      height="640"
                    />
                  </div>
                )
              }
              <p class="mt-3 text-sm leading-6 text-steel">
                {group.entries.length} year-specific hub page{group.entries.length === 1 ? "" : "s"} published.
              </p>
              {group.featuredGeneration && (
                <p class="mt-4 text-sm font-semibold text-accent">
                  Start with {getGenerationLabel(group.featuredGeneration.lead.data)}
                </p>
              )}
            </a>
          ))}
        </div>
      </Section>

      <Section title="Published car hubs" intro="These are the individual model-year pages currently available for this brand.">
        <div class="grid gap-6">
          {
            brandCars.map((car) => (
              <a class="rounded-3xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5" href={`/cars/${car.id}/`}>
                <p class="eyebrow">Car hub</p>
                <h2 class="mt-3 text-2xl font-semibold text-ink">{car.data.title}</h2>
                {
                  (car.data.heroImage ?? car.data.image) && (
                    <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                      <img
                        src={toThumbnail(car.data.heroImage ?? car.data.image)}
                        alt={car.data.title}
                        class="h-52 w-full object-cover"
                        loading="lazy"
                        decoding="async"
                        width="960"
                        height="640"
                      />
                    </div>
                  )
                }
                <p class="mt-3 text-sm leading-6 text-steel">{car.data.excerpt ?? car.data.description}</p>
              </a>
            ))
          }
        </div>
      </Section>
    </div>

    <div class="mt-8 space-y-8">
      <RelatedLinks title="Flagship guides for this brand" intro={`Use these if you want the strongest ${brand} ownership and buying guides before dropping into one symptom or parts page.`} items={linkedOwnershipGuides} />
      <RelatedLinks title="Related problem guides" intro={`These are the most relevant ${brand} problem pages already connected to the published car hubs.`} items={linkedProblems} />
      <RelatedLinks title="Related best-parts guides" intro={`These are the current ${brand} parts-comparison pages linked from the model and generation hubs.`} items={linkedBest} />
    </div>
  </div>
</BaseLayout>
