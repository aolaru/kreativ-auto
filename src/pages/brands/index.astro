---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { generationHubContent } from "../../data/generation-hubs";
import { ownershipGuides } from "../../data/ownership-guides";
import { toThumbnail } from "../../utils/images";
import { getGenerationKey, getGenerationSlug, slugify } from "../../utils/taxonomy";

const cars = await getCollection("cars");
const brands = Array.from(
  cars.reduce((map, car) => {
    const key = car.data.brand;
    const current = map.get(key) ?? [];
    current.push(car);
    map.set(key, current);
    return map;
  }, new Map<string, typeof cars>())
).map(([brand, entries]) => {
  const generationCount = new Set(entries.map((entry) => getGenerationKey(entry.data))).size;
  const featuredGeneration = entries.find((entry) => generationHubContent[getGenerationSlug(entry.data)]);

  return {
    brand,
    entries,
    generationCount,
    featuredGeneration
  };
});

const featuredBrands = [...brands]
  .filter((item) => item.featuredGeneration)
  .sort((a, b) => b.entries.length - a.entries.length || a.brand.localeCompare(b.brand))
  .slice(0, 3);

const allBrands = [...brands].sort((a, b) => a.brand.localeCompare(b.brand));
const featuredGuides = ownershipGuides.slice(0, 3);
---

<BaseLayout enableAds={false}
  title="Brands"
  description="Browse the site by vehicle brand, with the strongest generation hubs and best starting points surfaced first."
>
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Brands</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Browse by brand</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Start with the brands where the site already has real depth, then drill into the models and generation hubs that have the strongest ownership coverage.
      </p>
    </div>

    {
      featuredBrands.length > 0 && (
        <div class="mt-10">
          <Section
            title="Start with the strongest brand hubs"
            intro="These brands already have clearer generation-level coverage and are the fastest way into the deepest parts of the site."
          >
            <div class="grid gap-6 lg:grid-cols-3">
              {featuredBrands.map((item) => (
                <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={`/brands/${slugify(item.brand)}/`}>
                  <p class="eyebrow">Brand hub</p>
                  <h2 class="mt-3 text-2xl font-semibold text-ink">{item.brand}</h2>
                  {
                    (item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image) && (
                      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                        <img
                          src={toThumbnail(item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image)}
                          alt={item.brand}
                          class="h-48 w-full object-cover"
                          loading="lazy"
                          decoding="async"
                          width="960"
                          height="640"
                        />
                      </div>
                    )
                  }
                  <p class="mt-3 text-sm leading-6 text-steel">
                    {item.entries.length} car hub page{item.entries.length === 1 ? "" : "s"} across {item.generationCount} generation group{item.generationCount === 1 ? "" : "s"}.
                  </p>
                  {item.featuredGeneration && (
                    <p class="mt-4 text-sm font-semibold text-accent">
                      Start with {item.featuredGeneration.data.model} {item.featuredGeneration.data.generationCode ?? item.featuredGeneration.data.generation}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </Section>
        </div>
      )
    }

    {
      featuredGuides.length > 0 && (
        <div class="mt-10">
          <Section
            title="Flagship ownership guides"
            intro="Use these if you want the bigger picture first, then work down into one brand, generation, or repair page."
          >
            <div class="grid gap-6 lg:grid-cols-3">
              {featuredGuides.map((guide) => (
                <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href}>
                  {
                    guide.image && (
                      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
                        <img
                          src={toThumbnail(guide.image)}
                          alt={guide.title}
                          class="h-48 w-full object-cover"
                          loading="lazy"
                          decoding="async"
                          width="960"
                          height="640"
                        />
                      </div>
                    )
                  }
                  <p class="eyebrow mt-4">{guide.eyebrow}</p>
                  <h2 class="mt-3 text-2xl font-semibold text-ink">{guide.title}</h2>
                  <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
                </a>
              ))}
            </div>
          </Section>
        </div>
      )
    }

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        allBrands.map((item) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/brands/${slugify(item.brand)}/`}>
            <p class="eyebrow">Brand</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink">{item.brand}</h2>
            {
              (item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image) && (
                <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={toThumbnail(item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image)}
                    alt={item.brand}
                    class="h-48 w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="mt-3 text-sm leading-6 text-steel">
              {item.entries.length} car hub page{item.entries.length === 1 ? "" : "s"} across {item.generationCount} generation group{item.generationCount === 1 ? "" : "s"}.
            </p>
            {item.featuredGeneration && (
              <p class="mt-4 text-sm font-semibold text-accent">
                Featured generation: {item.featuredGeneration.data.model} {item.featuredGeneration.data.generationCode ?? item.featuredGeneration.data.generation}
              </p>
            )}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
