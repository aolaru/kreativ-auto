---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Section from "../../components/Section.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Vehicle maintenance record";
const description = "A printable maintenance record for a Toyota RAV4 XA50, Honda Civic facelift, Toyota Highlander 2020, or another vehicle with its official service source.";
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Vehicle maintenance record" }];
const fields = ["Vehicle, year, trim, and VIN", "Current mileage and date", "Workshop or service provider", "Invoice or work-order number"];
const records = ["Scheduled service completed", "Tires, pressure, rotation, and tread notes", "Brake condition or measurements", "Battery test or charging result", "Fluids, filters, and parts used", "Warning lights, symptoms, or diagnosis", "Recall or campaign check by VIN", "Next due date, mileage, or workshop question"];
const modelSources = [
  { model: "Toyota RAV4 XA50", detail: "Confirm gas or hybrid and model year before using the maintenance guide.", href: "https://assets.sia.toyota.com/publications/en/omms-s/T-MMS-21RAV4/pdf/T-MMS-21RAV4.pdf", label: "Toyota 2021 RAV4 warranty and maintenance guide" },
  { model: "Honda Civic 2019 facelift", detail: "Record the Maintenance Minder main and sub-item codes shown on the vehicle.", href: "https://owners.honda.com/utility/download?path=%2Fstatic%2Fpdfs%2F2019%2FCivic+Sedan%2F2019_Civic_4D_Maintenance_Minder.pdf", label: "Honda Civic Maintenance Minder" },
  { model: "Toyota Highlander 2020", detail: "Confirm gas or hybrid before using the matching Toyota maintenance guide.", href: "https://assets.sia.toyota.com/publications/en/omms-s/T-MMS-20Highlander/pdf/T-MMS-20Highlander.pdf", label: "Toyota 2020 Highlander warranty and maintenance guide" }
];
---

<BaseLayout title={title} description={description} modifiedTime={new Date("2026-09-01")} enableAds={false}>
  <div class="container-shell py-10 sm:py-14">
    <Breadcrumbs items={breadcrumbs} />
    <div class="max-w-3xl">
      <p class="eyebrow">Ownership tool</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Vehicle maintenance record</h1>
      <p class="mt-5 text-lg leading-8 text-steel">Keep completed work, condition notes, recall checks, and the next decision together. Use the vehicle's official maintenance source for intervals and codes.</p>
      <button class="mt-6 inline-flex items-center border border-ink bg-ink px-5 py-3 text-sm font-semibold text-white transition hover:border-accent hover:bg-accent print:hidden" type="button" onclick="window.kaTrackEvent?.('tool_print', { event_label: 'maintenance record', section: 'maintenance_record' }); window.print()">Print maintenance record</button>
    </div>

    <div class="worksheet mt-10 space-y-6">
      <Section title="Vehicle details" intro="Copy details directly from the vehicle and the current paperwork.">
        <div class="grid gap-4 sm:grid-cols-2">{fields.map((label) => <label class="block text-sm font-semibold text-ink">{label}<span class="worksheet-line mt-3 block" aria-hidden="true"></span></label>)}</div>
      </Section>

      <Section title="Service and condition record" intro="Write what was confirmed, not what is merely assumed from mileage or a seller statement.">
        <ul class="space-y-4">{records.map((item) => <li class="worksheet-item"><span class="worksheet-box" aria-hidden="true"></span><span>{item}</span><span class="worksheet-note" aria-hidden="true"></span></li>)}</ul>
      </Section>

      <Section title="Core-model references" intro="Choose the source that matches the exact vehicle. The source is the schedule; this sheet is the record of how that vehicle was maintained.">
        <div class="grid gap-5 md:grid-cols-3">
          {modelSources.map((source) => <article class="rounded-2xl border border-slate-200 bg-white p-5"><h2 class="text-xl font-semibold text-ink">{source.model}</h2><p class="mt-3 text-sm leading-6 text-steel">{source.detail}</p><a class="mt-4 inline-block text-sm font-semibold text-accent hover:text-ink" href={source.href} rel="noopener" target="_blank">{source.label}</a></article>)}
        </div>
      </Section>

      <Section title="Next workshop visit" intro="Use the record to make the next question specific and the resulting quote comparable.">
        <label class="block text-sm font-semibold text-ink">Symptoms to reproduce, records to bring, and the exact work to quote<span class="worksheet-area mt-3 block" aria-hidden="true"></span></label>
      </Section>
    </div>
  </div>
</BaseLayout>

<style>
  .worksheet-item { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: 0.75rem; align-items: start; color: rgb(71 85 105); font-size: 0.875rem; line-height: 1.5rem; }
  .worksheet-box { width: 1rem; height: 1rem; margin-top: 0.25rem; border: 1px solid rgb(71 85 105); }
  .worksheet-line { height: 1.5rem; border-bottom: 1px solid rgb(148 163 184); }
  .worksheet-note { grid-column: 2; height: 1.5rem; border-bottom: 1px solid rgb(203 213 225); }
  .worksheet-area { height: 10.5rem; border: 1px solid rgb(203 213 225); background-image: linear-gradient(to bottom, transparent 1.75rem, rgb(226 232 240) 1.75rem, rgb(226 232 240) calc(1.75rem + 1px), transparent calc(1.75rem + 1px)); background-size: 100% 1.75rem; }
  @media print { :global(header), :global(footer), :global(.consent-banner), :global(.print\\:hidden) { display: none !important; } :global(body) { background: white; } .worksheet { margin-top: 1.5rem; } }
</style>
