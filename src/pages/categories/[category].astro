---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { getCategoryHub } from "../../data/category-hubs";
import { toThumbnail } from "../../utils/images";
import { slugify, uniqueByHref } from "../../utils/taxonomy";

export async function getStaticPaths() {
  const bestPages = await getCollection("best");
  const categories = Array.from(new Set(bestPages.map((entry) => entry.data.category)));

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { category }
  }));
}

const { category } = Astro.props;
const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const categoryPages = bestPages.filter((entry) => entry.data.category === category);
const linkedCars = uniqueByHref(
  cars
    .filter((car) => categoryPages.some((entry) => car.data.relatedBest.includes(entry.id)))
    .map((car) => ({
      href: `/cars/${car.id}/`,
      title: car.data.title,
      description: car.data.excerpt ?? car.data.metaDescription ?? car.data.description,
      eyebrow: "Car"
    }))
);

const linkedProblems = uniqueByHref(
  problems
    .filter((problem) => categoryPages.some((entry) => entry.data.relatedProblems.includes(problem.id)))
    .map((problem) => ({
      href: `/problems/${problem.id}/`,
      title: problem.data.title,
      description: problem.data.excerpt ?? problem.data.metaDescription,
      eyebrow: "Problem guide"
    }))
);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Categories", href: "/categories/" },
  { label: category }
];
const categoryHub = getCategoryHub(category);
const categoryDecisionCards = [
  {
    title: "Confirm the repair area first",
    description: `Use these ${category.toLowerCase()} comparisons after the symptom already points at this part family, not as a shortcut around diagnosis.`
  },
  {
    title: "Start from the matching vehicle",
    description: "Open the car-specific guide first when trim, year, or powertrain differences can change the right shortlist."
  },
  {
    title: "Check symptoms before buying",
    description: "If a related problem guide exists, use it to confirm the cause before turning a comparison page into a parts order."
  }
];
---

<BaseLayout enableAds={false} noindex={true} title={`${category} Guides`} description={`Browse ${category.toLowerCase()} comparison pages and related vehicle guides.`}>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Part category</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{category}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">{categoryHub.intro}</p>
    </div>

    <section class="mt-10 surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Best Fit</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">When {category.toLowerCase()} shopping makes sense</h2>
      </div>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          categoryHub.whenItMatters.map((item) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <p class="text-sm leading-6 text-steel">{item}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="mt-10 grid gap-6">
      {
        categoryPages.map((entry) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/best/${entry.id}/`}>
            <p class="eyebrow">{entry.data.car_model}</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink">{entry.data.title}</h2>
            {
              entry.data.heroImage && (
                <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={toThumbnail(entry.data.heroImage)}
                    alt={entry.data.title}
                    class="h-52 w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="mt-3 text-sm leading-6 text-steel">{entry.data.excerpt ?? entry.data.metaDescription}</p>
          </a>
        ))
      }
    </div>

    <section class="mt-8 surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Part category checklist</h2>
        <p class="mt-3 text-base leading-7 text-steel">
          Compare the right family of parts after the vehicle and symptom checks have narrowed the job.
        </p>
      </div>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          categoryDecisionCards.map((item) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-steel">{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="surface p-6 sm:p-8">
        <p class="eyebrow">Before Buying</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Checks that protect the parts order</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-steel">
          {categoryHub.checksBeforeBuying.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
        </ul>
      </div>
      <div class="surface p-6 sm:p-8">
        <p class="eyebrow">Pause</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">When to diagnose more first</h2>
        <ul class="mt-5 space-y-3 text-sm leading-6 text-steel">
          {categoryHub.avoidWhen.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mt-8 surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Diagnosis Notes</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Keep the part choice tied to evidence</h2>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          categoryHub.diagnosisNotes.map((item) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 text-sm leading-6 text-steel">{item}</div>
          ))
        }
      </div>
    </section>

    <div class="mt-8 space-y-8">
      <RelatedLinks title="Related cars" items={linkedCars} />
      <RelatedLinks title="Related problem guides" items={linkedProblems} />
    </div>
  </div>
</BaseLayout>
