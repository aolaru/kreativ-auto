---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategoryHub } from "../../data/category-hubs";
import { toThumbnail } from "../../utils/images";
import { slugify } from "../../utils/taxonomy";

const bestPages = await getCollection("best");
const categories = Array.from(
  bestPages.reduce((map, entry) => {
    const key = entry.data.category;
    const current = map.get(key) ?? [];
    current.push(entry);
    map.set(key, current);
    return map;
  }, new Map<string, typeof bestPages>())
).sort(([a], [b]) => a.localeCompare(b));

const completeCategories = [...categories]
  .map(([category, entries]) => ({
    category,
    entries,
    vehicleCount: new Set(entries.flatMap((entry) => entry.data.relatedCars)).size,
    problemCount: new Set(entries.flatMap((entry) => entry.data.relatedProblems)).size
  }))
  .sort((a, b) => b.entries.length - a.entries.length || b.vehicleCount - a.vehicleCount)
  .slice(0, 4);

const categoryUseCases = [
  {
    title: "When the symptom is already clear",
    description: "Use categories after a problem guide has narrowed the repair area. That keeps parts shopping from replacing the diagnosis."
  },
  {
    title: "When several vehicles share a repair family",
    description: "Open a category to compare how the same part type is handled across different vehicles and ownership patterns."
  },
  {
    title: "When you need fitment reminders",
    description: "Every comparison still needs year, trim, engine, and package checks before ordering. Use the category as the starting map."
  }
];
---

<BaseLayout enableAds={false}
  noindex={true}
  title="Part Categories"
  description="Browse best-parts guides by category."
>
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Taxonomy</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Browse by part category</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Start with the repair family after the symptom and vehicle checks point in the same direction. Each category keeps fitment, diagnosis, and buying checks close to the matching parts pages.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        categories.map(([category, entries]) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/categories/${slugify(category)}/`}>
            <p class="eyebrow">Category</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink">{category}</h2>
            {
              entries[0]?.data.heroImage && (
                <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={toThumbnail(entries[0].data.heroImage)}
                    alt={category}
                    class="h-48 w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="mt-3 text-sm leading-6 text-steel">{getCategoryHub(category).intro}</p>
            <p class="mt-4 text-sm font-semibold text-accent">{entries.length} comparison{entries.length === 1 ? "" : "s"}</p>
          </a>
        ))
      }
    </div>

    <section class="mt-10 surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Use Categories Carefully</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Categories are for narrowing the shortlist, not skipping diagnosis</h2>
        <p class="mt-3 text-base leading-7 text-steel">
          A category works best after the vehicle and symptom checks point at the right repair area. That keeps parts shopping tied to a real problem instead of a generic product list.
        </p>
      </div>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          categoryUseCases.map((item) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-steel">{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-10 surface p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="eyebrow">Strongest Categories</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">Start with the most useful part families</h2>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          completeCategories.map((item) => (
            <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-accent/40 hover:bg-white" href={`/categories/${slugify(item.category)}/`}>
              <p class="eyebrow">{item.entries.length} comparison{item.entries.length === 1 ? "" : "s"}</p>
              <h3 class="mt-2 text-xl font-semibold text-ink">{item.category}</h3>
              <p class="mt-3 text-sm leading-6 text-steel">
                Covers {item.vehicleCount} vehicle{item.vehicleCount === 1 ? "" : "s"} and {item.problemCount} related problem guide{item.problemCount === 1 ? "" : "s"}.
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
