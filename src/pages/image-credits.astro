---
import BaseLayout from "../layouts/BaseLayout.astro";
import { imageCredits } from "../data/image-credits";
---

<BaseLayout
  title="Image Credits"
  description="Photo credits, source links, and license information for Kreativ Auto vehicle images."
  enableAds={false}
>
  <div class="container-shell py-12 sm:py-16">
    <div class="surface hero-frame p-8 sm:p-10">
      <p class="eyebrow">Image credits</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Photo sources and licenses</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Vehicle photos are credited here with source pages, authors, license terms, and a note when files were resized or converted for faster loading.
      </p>
    </div>

    <section class="mt-10 grid gap-6">
      {
        imageCredits.map((credit) => (
          <article class="surface p-6 sm:p-8">
            <div class="grid gap-6 lg:grid-cols-[0.45fr_1fr] lg:items-start">
              <div class="image-frame image-frame-card bg-slate-50">
                <img src={credit.localPath} alt={credit.title} width="640" height="427" loading="lazy" />
              </div>
              <div>
                <p class="eyebrow">{credit.license}</p>
                <h2 class="mt-3 text-2xl font-semibold text-ink">{credit.title}</h2>
                <dl class="mt-5 grid gap-4 text-sm leading-6 text-steel sm:grid-cols-2">
                  <div>
                    <dt class="font-semibold text-ink">Source</dt>
                    <dd class="mt-1">
                      <a class="text-accent hover:underline" href={credit.sourceUrl}>{credit.sourceName}</a>
                    </dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-ink">Author</dt>
                    <dd class="mt-1">{credit.author}</dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-ink">License</dt>
                    <dd class="mt-1">
                      <a class="text-accent hover:underline" href={credit.licenseUrl}>{credit.license}</a>
                    </dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-ink">Local file</dt>
                    <dd class="mt-1">{credit.localPath}</dd>
                  </div>
                  <div class="sm:col-span-2">
                    <dt class="font-semibold text-ink">Modifications</dt>
                    <dd class="mt-1">{credit.modifications}</dd>
                  </div>
                </dl>
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>
