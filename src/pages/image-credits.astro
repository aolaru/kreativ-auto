---
import BaseLayout from "../layouts/BaseLayout.astro";
import { imageCredits } from "../data/image-credits";
---

<BaseLayout
  title="Image Credits"
  description="Photo credits, source links, and license information for Kreativ Auto vehicle images."
  enableAds={false}
>
  <div class="container-shell py-12 sm:py-16">
    <div class="surface hero-frame p-8 sm:p-10">
      <p class="eyebrow">Image credits</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Photo sources and licenses</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Vehicle photos are credited here with source pages, authors, license terms, and a note when files were resized or converted for faster loading.
      </p>
    </div>

    <section class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">Image handling</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">How visual assets are prepared</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Source retained</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Each credited image keeps a source link, author name, license label, and license URL so the origin can be checked later.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Web formats</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Public photos are resized, converted, and paired with thumbnails where needed so list pages do not load oversized source files.
          </p>
        </article>
        <article class="editorial-card">
          <h3 class="text-xl font-semibold text-ink">Corrections</h3>
          <p class="mt-3 text-sm leading-6 text-steel">
            Image-credit corrections can be sent through the contact email with the page URL, image title, source, and the detail that should be changed.
          </p>
        </article>
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-6 text-steel">Vehicle photographs provide visual context for the model and are not presented as photos of the individual vehicle, fault, repair, or product discussed in a guide. Diagnostic and maintenance claims are supported separately by the cited sources on the relevant page.</p>
    </section>

    <section class="mt-10 surface p-6 sm:p-8">
      <p class="eyebrow">License notes</p>
      <h2 class="mt-3 text-3xl font-semibold text-ink">Attribution and removal requests</h2>
      <div class="mt-6 space-y-4 text-sm leading-6 text-steel">
        <p>
          Credited images may be cropped, resized, converted to WebP, or paired with a smaller thumbnail for page speed. The credit list keeps the local file path visible so each public image can be matched back to its source entry.
        </p>
        <p>
          If an author, license holder, or source representative believes a credit is incomplete or an image should be removed, the contact page can be used to send the image title, source URL, and requested correction.
        </p>
        <p>
          Some pages also use product or part images supplied by manufacturers, retailers, or brand media pages. Those are handled separately from the vehicle-photo credits below and should be reviewed against the linked product or manufacturer source when a correction is requested.
        </p>
      </div>
    </section>

    <section class="mt-10 grid gap-6">
      {
        imageCredits.map((credit) => (
          <article class="surface p-6 sm:p-8">
            <div class="grid gap-6 lg:grid-cols-[0.45fr_1fr] lg:items-start">
              <div class="image-frame image-frame-card bg-slate-50">
                <img src={credit.localPath} alt={credit.title} width="640" height="427" loading="lazy" />
              </div>
              <div>
                <p class="eyebrow">{credit.license}</p>
                <h2 class="mt-3 text-2xl font-semibold text-ink">{credit.title}</h2>
                <dl class="mt-5 grid gap-4 text-sm leading-6 text-steel sm:grid-cols-2">
                  <div>
                    <dt class="font-semibold text-ink">Source</dt>
                    <dd class="mt-1">
                      <a class="text-accent hover:underline" href={credit.sourceUrl}>{credit.sourceName}</a>
                    </dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-ink">Author</dt>
                    <dd class="mt-1">{credit.author}</dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-ink">License</dt>
                    <dd class="mt-1">
                      <a class="text-accent hover:underline" href={credit.licenseUrl}>{credit.license}</a>
                    </dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-ink">Local file</dt>
                    <dd class="mt-1">{credit.localPath}</dd>
                  </div>
                  <div class="sm:col-span-2">
                    <dt class="font-semibold text-ink">Modifications</dt>
                    <dd class="mt-1">{credit.modifications}</dd>
                  </div>
                </dl>
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>
