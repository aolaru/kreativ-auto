---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import { generationHubContent } from "../../data/generation-hubs";
import { ownershipGuides } from "../../data/ownership-guides";
import { toThumbnail } from "../../utils/images";
import {
  getGenerationKey,
  getGenerationLabel,
  getGenerationRange,
  getGenerationSlug,
  slugify,
  includesPhrase,
  uniqueByHref
} from "../../utils/taxonomy";

export async function getStaticPaths() {
  const cars = await getCollection("cars");
  const models = Array.from(new Set(cars.map((car) => `${car.data.brand} ${car.data.model}`)));

  return models.map((model) => ({
    params: { model: slugify(model) },
    props: { model }
  }));
}

const { model } = Astro.props;
const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const modelCars = cars.filter((car) => `${car.data.brand} ${car.data.model}` === model);
const linkedProblems = uniqueByHref(
  problems
    .filter((problem) =>
      modelCars.some(
        (car) =>
          car.data.relatedProblems.includes(problem.id) ||
          car.data.commonProblems.some((item) => includesPhrase(item, problem.data.title))
      )
    )
    .map((problem) => ({
      href: `/problems/${problem.id}/`,
      title: problem.data.title,
      description: problem.data.excerpt ?? problem.data.metaDescription,
      eyebrow: "Problem guide"
    }))
);

const linkedBest = uniqueByHref(
  bestPages
    .filter((entry) => modelCars.some((car) => includesPhrase(entry.data.car_model, car.data.model)))
    .map((entry) => ({
      href: `/best/${entry.id}/`,
      title: entry.data.title,
      description: entry.data.excerpt ?? entry.data.metaDescription,
      eyebrow: entry.data.category
    }))
);
const linkedOwnershipGuides = uniqueByHref(
  ownershipGuides
    .filter((guide) => modelCars.some((car) => guide.relatedCars?.includes(car.id)))
    .map((guide) => ({
      href: guide.href,
      title: guide.title,
      description: guide.description,
      eyebrow: guide.eyebrow,
      image: guide.image
    }))
);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Models", href: "/models/" },
  { label: model }
];
const generationGroups = Array.from(
  modelCars.reduce((map, car) => {
    const key = getGenerationKey(car.data);
    const current = map.get(key) ?? [];
    current.push(car);
    map.set(key, current);
    return map;
  }, new Map<string, typeof modelCars>())
).map(([, entries]) => {
  const lead = entries[0];
  const generationSlug = getGenerationSlug(lead.data);
  const relatedProblems = linkedProblems.filter((item) =>
    entries.some((car) => car.data.relatedProblems.some((slug) => item.href === `/problems/${slug}/`))
  );
  const relatedBest = linkedBest.filter((item) =>
    entries.some((car) => car.data.relatedBest.some((slug) => item.href === `/best/${slug}/`))
  );

  return {
    lead,
    entries: [...entries].sort((a, b) => a.data.year - b.data.year),
    generationSlug,
    hasEditorialHub: Boolean(generationHubContent[generationSlug]),
    relatedProblems,
    relatedBest
  };
});
const featuredGenerationGroups = [...generationGroups].sort(
  (a, b) =>
    Number(b.hasEditorialHub) - Number(a.hasEditorialHub) ||
    b.relatedProblems.length + b.relatedBest.length - (a.relatedProblems.length + a.relatedBest.length)
);
const startHere = featuredGenerationGroups[0];
const shouldNoindex = !featuredGenerationGroups.some((group) => group.hasEditorialHub);
---

<BaseLayout enableAds={false} noindex={shouldNoindex} title={`${model} Guides`} description={`Browse ${model} model years, problem guides, and best-parts comparisons.`}>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Model</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{model}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Start with the most relevant generation for {model}, then use the model-year and repair guides when you need something narrower.
      </p>
    </div>

    {
      startHere && (
        <div class="mt-10">
          <Section
            title={`Start here with ${getGenerationLabel(startHere.lead.data)}`}
            intro={`This is the clearest first stop for ${model} ownership questions.`}
          >
            <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
              <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={`/generations/${startHere.generationSlug}/`}>
                <p class="eyebrow">Featured generation</p>
                <h2 class="mt-3 text-2xl font-semibold text-ink">{getGenerationLabel(startHere.lead.data)}</h2>
                {
                  (startHere.lead.data.heroImage ?? startHere.lead.data.image) && (
                    <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                      <img
                        src={toThumbnail(startHere.lead.data.heroImage ?? startHere.lead.data.image)}
                        alt={getGenerationLabel(startHere.lead.data)}
                        class="h-56 w-full object-cover"
                        loading="lazy"
                        decoding="async"
                        width="960"
                        height="640"
                      />
                    </div>
                  )
                }
                <p class="mt-3 text-sm leading-6 text-steel">
                  Covers the {getGenerationRange(startHere.lead.data)} window with problem checks, parts guides, and model years.
                </p>
                <p class="mt-4 text-sm font-semibold text-accent">Open generation</p>
              </a>
              <div class="grid gap-4">
                {startHere.relatedProblems.slice(0, 2).map((item) => (
                  <a class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-accent/40" href={item.href}>
                    <p class="eyebrow">{item.eyebrow}</p>
                    <h3 class="mt-2 text-lg font-semibold text-ink">{item.title}</h3>
                    {item.description && <p class="mt-2 text-sm leading-6 text-steel">{item.description}</p>}
                  </a>
                ))}
              </div>
            </div>
          </Section>
        </div>
      )
    }

    <div class="mt-10 space-y-8">
      <Section
        title="Generations"
        intro="Use generations first when the ownership pattern or parts overlap matters more than the exact model year."
      >
        <div class="grid gap-6">
          {featuredGenerationGroups.map((group) => (
            <div class="rounded-3xl border border-slate-200 bg-white p-6">
              <div class="flex flex-col gap-3 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="eyebrow">Generation</p>
                  <h2 class="mt-3 text-2xl font-semibold text-ink">{getGenerationLabel(group.lead.data)}</h2>
                  <p class="mt-3 text-sm leading-6 text-steel">
                    Covers the {getGenerationRange(group.lead.data)} window for {model}.
                  </p>
                </div>
                <a class="text-sm font-semibold text-accent" href={`/generations/${group.generationSlug}/`}>
                  View generation
                </a>
              </div>

              {
                (group.lead.data.heroImage ?? group.lead.data.image) && (
                  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                    <img
                      src={toThumbnail(group.lead.data.heroImage ?? group.lead.data.image)}
                      alt={getGenerationLabel(group.lead.data)}
                      class="h-56 w-full object-cover"
                      loading="lazy"
                      decoding="async"
                      width="960"
                      height="640"
                    />
                  </div>
                )
              }

              <div class="mt-6 grid gap-4 md:grid-cols-2">
                {group.relatedProblems.slice(0, 2).map((item) => (
                  <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:bg-white" href={item.href}>
                    <p class="eyebrow">{item.eyebrow}</p>
                    <h3 class="mt-2 text-lg font-semibold text-ink">{item.title}</h3>
                    {item.description && <p class="mt-2 text-sm leading-6 text-steel">{item.description}</p>}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Section>

      <Section title="Model years" intro="Drop to the model-year pages when you want the narrower ownership summary for a specific year.">
      {
        generationGroups.map((group) => {
          const lead = group.lead;

          return (
            <section class="surface p-6 sm:p-8">
              <div class="flex flex-col gap-3 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="eyebrow">Generation</p>
                  <h2 class="mt-3 text-2xl font-semibold text-ink">{getGenerationLabel(lead.data)}</h2>
                  <p class="mt-3 text-sm leading-6 text-steel">
                    Covers the {getGenerationRange(lead.data)} window for {model}.
                  </p>
                </div>
                <a class="text-sm font-semibold text-accent" href={`/generations/${getGenerationSlug(lead.data)}/`}>
                  View generation
                </a>
              </div>

              <div class="mt-6 grid gap-6">
                {group.entries.map((car) => (
                    <a class="rounded-3xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5" href={`/cars/${car.id}/`}>
                      <p class="eyebrow">{car.data.year}</p>
                      <h3 class="mt-3 text-2xl font-semibold text-ink">{car.data.title}</h3>
                      {
                        (car.data.heroImage ?? car.data.image) && (
                          <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                            <img
                              src={toThumbnail(car.data.heroImage ?? car.data.image)}
                              alt={car.data.title}
                              class="h-52 w-full object-cover"
                              loading="lazy"
                              decoding="async"
                              width="960"
                              height="640"
                            />
                          </div>
                        )
                      }
                      <p class="mt-3 text-sm leading-6 text-steel">{car.data.excerpt ?? car.data.description}</p>
                    </a>
                  ))}
              </div>
            </section>
          );
        })
      }
      </Section>
    </div>

    <div class="mt-8 space-y-8">
      <RelatedLinks title="Flagship guides for this model" intro={`Use these if you want the bigger ${model} ownership picture before narrowing down to one specific symptom or part.`} items={linkedOwnershipGuides} imageLimit={1} />
      <RelatedLinks title="Related problem guides" intro={`These checks cover symptoms that come up often on the listed ${model} years.`} items={linkedProblems} imageLimit={0} />
      <RelatedLinks title="Related best-parts guides" intro={`These part comparisons help once the repair area is clear for this ${model}.`} items={linkedBest} imageLimit={0} />
    </div>
  </div>
</BaseLayout>
