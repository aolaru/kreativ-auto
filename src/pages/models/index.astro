---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { generationHubContent } from "../../data/generation-hubs";
import { ownershipGuides } from "../../data/ownership-guides";
import { toThumbnail } from "../../utils/images";
import { getGenerationKey, getGenerationSlug, slugify } from "../../utils/taxonomy";

const cars = await getCollection("cars");
const models = Array.from(
  cars.reduce((map, car) => {
    const key = `${car.data.brand} ${car.data.model}`;
    const current = map.get(key) ?? [];
    current.push(car);
        map.set(key, current);
        return map;
  }, new Map<string, typeof cars>())
).map(([model, entries]) => {
  const generationCount = new Set(entries.map((entry) => getGenerationKey(entry.data))).size;
  const featuredGeneration = entries.find((entry) => generationHubContent[getGenerationSlug(entry.data)]);

  return {
    model,
    entries,
    generationCount,
    featuredGeneration
  };
});

const featuredModels = [...models]
  .filter((item) => item.featuredGeneration)
  .sort((a, b) => b.entries.length - a.entries.length || a.model.localeCompare(b.model))
  .slice(0, 3);

const allModels = [...models].sort((a, b) => a.model.localeCompare(b.model));
const featuredGuides = ownershipGuides.slice(0, 3);
---

<BaseLayout enableAds={false}
  noindex={true}
  title="Models"
  description="Browse Kreativ Auto by make, model, generation, and model year."
>
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Models</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Browse by model</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Pick a model first when you need to compare model years, generations, weak points, or parts that change over time.
      </p>
    </div>

    {
      featuredModels.length > 0 && (
        <div class="mt-10">
          <Section
            title="Start with the most complete models"
            intro="These models have multiple years or generations, so they are useful when one model year is too narrow."
          >
            <div class="grid gap-6 lg:grid-cols-3">
              {featuredModels.map((item) => (
                <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={`/models/${slugify(item.model)}/`}>
                  <p class="eyebrow">Model</p>
                  <h2 class="mt-3 text-2xl font-semibold text-ink">{item.model}</h2>
                  {
                    (item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image) && (
                      <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white">
                        <img
                          src={toThumbnail(item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image)}
                          alt={item.model}
                          class="h-48 w-full object-cover"
                          loading="lazy"
                          decoding="async"
                          width="960"
                          height="640"
                        />
                      </div>
                    )
                  }
                  <p class="mt-3 text-sm leading-6 text-steel">
                    {item.entries.length} model year{item.entries.length === 1 ? "" : "s"} across {item.generationCount} generation group{item.generationCount === 1 ? "" : "s"}.
                  </p>
                  {item.featuredGeneration && (
                    <p class="mt-4 text-sm font-semibold text-accent">
                      Featured generation available
                    </p>
                  )}
                </a>
              ))}
            </div>
          </Section>
        </div>
      )
    }

    {
      featuredGuides.length > 0 && (
        <div class="mt-10">
          <Section
            title="Flagship ownership guides"
            intro="Use these first when your next question is bigger than one model year."
          >
            <div class="grid gap-6 lg:grid-cols-3">
              {featuredGuides.map((guide) => (
                <a class="rounded-3xl border border-slate-200 bg-slate-50 p-6 transition hover:-translate-y-0.5 hover:bg-white" href={guide.href}>
                  {
                    guide.image && (
                      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
                        <img
                          src={toThumbnail(guide.image)}
                          alt={guide.title}
                          class="h-48 w-full object-cover"
                          loading="lazy"
                          decoding="async"
                          width="960"
                          height="640"
                        />
                      </div>
                    )
                  }
                  <p class="eyebrow mt-4">{guide.eyebrow}</p>
                  <h2 class="mt-3 text-2xl font-semibold text-ink">{guide.title}</h2>
                  <p class="mt-3 text-sm leading-6 text-steel">{guide.description}</p>
                </a>
              ))}
            </div>
          </Section>
        </div>
      )
    }

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        allModels.map((item) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/models/${slugify(item.model)}/`}>
            <p class="eyebrow">Model</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink">{item.model}</h2>
            {
              (item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image) && (
                <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={toThumbnail(item.featuredGeneration?.data.heroImage ?? item.featuredGeneration?.data.image)}
                    alt={item.model}
                    class="h-48 w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="mt-3 text-sm leading-6 text-steel">
              {item.entries.length} model year{item.entries.length === 1 ? "" : "s"} across {item.generationCount} generation group{item.generationCount === 1 ? "" : "s"}.
            </p>
            {item.featuredGeneration && <p class="mt-4 text-sm font-semibold text-accent">Featured generation available</p>}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
