---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGenerationKey, slugify } from "../../utils/taxonomy";

const cars = await getCollection("cars");
const models = Array.from(
  cars.reduce((map, car) => {
    const key = `${car.data.brand} ${car.data.model}`;
    const current = map.get(key) ?? [];
    current.push(car);
        map.set(key, current);
        return map;
      }, new Map<string, typeof cars>())
).sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout
  title="Models"
  description="Browse car hub content by make and model."
>
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Taxonomy</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Browse by model</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        Model pages group the published years first, then break them down by generation and facelift phase where the underlying car really changes.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        models.map(([model, entries]) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/models/${slugify(model)}/`}>
            <p class="eyebrow">Model</p>
            <h2 class="mt-3 text-2xl font-semibold text-ink">{model}</h2>
            <p class="mt-3 text-sm leading-6 text-steel">
              {entries.length} published year-specific hub page{entries.length === 1 ? "" : "s"} across{" "}
              {new Set(entries.map((entry) => getGenerationKey(entry.data))).size} generation group
              {new Set(entries.map((entry) => getGenerationKey(entry.data))).size === 1 ? "" : "s"}.
            </p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
