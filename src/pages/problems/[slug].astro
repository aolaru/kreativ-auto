---
import { getCollection, getEntry, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import FitmentNotes from "../../components/FitmentNotes.astro";
import ProblemTriageBlock from "../../components/ProblemTriageBlock.astro";
import DecisionPathBlock from "../../components/DecisionPathBlock.astro";
import EvidenceLimitsBlock from "../../components/EvidenceLimitsBlock.astro";
import { editorialTeam } from "../../data/editorial";
import { hondaCivicProblemQuality } from "../../data/honda-civic-quality";
import { highlanderProblemQuality } from "../../data/toyota-highlander-quality";
import { rav4ProblemQuality } from "../../data/toyota-rav4-quality";
import { isReviewReadyProblem } from "../../data/review-readiness";
import { includesPhrase, uniqueByHref } from "../../utils/taxonomy";

export async function getStaticPaths() {
  const problems = await getCollection("problems");

  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { slug: problem.id }
  }));
}

const { slug } = Astro.props;
const problem = await getEntry("problems", slug);

if (!problem) {
  throw new Error(`Problem entry not found for slug: ${slug}`);
}

const { Content } = await render(problem);

const [carEntries, bestEntries] = await Promise.all([
  getCollection("cars"),
  getCollection("best")
]);

const relatedCars = uniqueByHref(
  carEntries
  .filter((entry) => {
    return (
      problem.data.relatedCars.includes(entry.id) ||
      entry.data.commonProblems.some((item) => includesPhrase(item, problem.data.title)) ||
      includesPhrase(problem.data.title, entry.data.model)
    );
  })
  .map((entry) => ({
    href: `/cars/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.excerpt ?? entry.data.metaDescription ?? entry.data.description,
    eyebrow: "Car"
  }))
);

const relatedBest = uniqueByHref(
  bestEntries
  .filter((entry) => {
    return (
      problem.data.relatedBest.includes(entry.id) ||
      includesPhrase(entry.data.title, problem.data.title) ||
      includesPhrase(problem.data.title, entry.data.category) ||
      problem.data.solutions.some((item) => includesPhrase(item, entry.data.category))
    );
  })
  .map((entry) => ({
    href: `/best/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.excerpt ?? entry.data.metaDescription ?? `${entry.data.products.length} product picks for ${entry.data.car_model}.`,
    eyebrow: entry.data.category
  }))
);

const symptomTitleShortcuts: Record<string, string> = {
  "brake pedal pulsates when slowing": "Brake pedal pulsation",
  "front-end clunk when pulling into driveways": "Driveway front-end clunk",
  "rear brakes squeak after rain": "Rear brake squeak after rain",
  "steering wheel vibrates at highway speed": "Highway steering vibration"
};
const formatSentenceStart = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const compactSymptom = (value: string) => symptomTitleShortcuts[value.toLowerCase()] ?? formatSentenceStart(value);
const compactProblemTitle = (() => {
  const [symptom, vehicle] = problem.data.title.split(/\s+on\s+/i);
  if (vehicle && symptom) {
    const compactVehicle = vehicle.replace(/\s+20\d{2}$/i, "");
    const withVehicle = `${vehicle}: ${compactSymptom(symptom)}`;
    const withCompactVehicle = `${compactVehicle}: ${compactSymptom(symptom)}`;

    return withVehicle.length <= 58 ? withVehicle : withCompactVehicle;
  }

  const genericTitle = `${compactSymptom(problem.data.title)}: Diagnosis and Fixes`;
  return genericTitle.length <= 58 ? genericTitle : `${compactSymptom(problem.data.title)}: Fixes`;
})();
const rawSeoTitle = problem.data.metaTitle ?? problem.data.title;
const seoTitle = rawSeoTitle.length <= 58 ? rawSeoTitle : compactProblemTitle;
const seoDescription =
  problem.data.metaDescription ??
  `Diagnostic guide covering symptoms, likely causes, and repair solutions for: ${problem.data.title.toLowerCase()}.`;
const socialImage = problem.data.heroImage ?? problem.data.recommendedParts[0]?.image;
const triageVerdict = problem.data.quickVerdict ?? problem.data.excerpt;
const triageFirstCheck = problem.data.firstCheck ?? problem.data.solutions[0];
const triageConfusedWith = problem.data.confusedWith;
const triageStopDrivingIf =
  problem.data.stopDrivingIf.length > 0 ? problem.data.stopDrivingIf : problem.data.whenToSeeMechanic.slice(0, 2);
const vehicleQuality = rav4ProblemQuality[problem.id] ?? hondaCivicProblemQuality[problem.id] ?? highlanderProblemQuality[problem.id];
const reviewReady = isReviewReadyProblem(problem.id) && Boolean(vehicleQuality);
const primaryCause = problem.data.causes[0];
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Problems", href: "/problems/" },
  { label: problem.data.title }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: seoTitle,
    description: seoDescription,
    image: socialImage ? [new URL(socialImage, Astro.site).toString()] : undefined,
    mainEntityOfPage: Astro.url.href,
    dateModified: problem.data.updatedAt?.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={seoTitle}
  description={seoDescription}
  intro={problem.data.excerpt ?? seoDescription}
  faqs={problem.data.faqs}
  image={socialImage}
  modifiedTime={problem.data.updatedAt}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  enableAds={reviewReady}
  noindex={!reviewReady}
>
  {vehicleQuality && <EvidenceLimitsBlock {...vehicleQuality.evidence} />}

  {
    reviewReady && (
      <Section id="model-context" title="Model-specific context">
        <div class="max-w-none space-y-4 text-base leading-7 text-steel [&_p]:leading-7">
          <Content />
        </div>
      </Section>
    )
  }

  <Section id="triage" title="First check" intro={triageFirstCheck ? `Start with ${triageFirstCheck.toLowerCase()}.` : "Start with the checks that can confirm the complaint before parts are ordered."}>
    <ProblemTriageBlock
      quickVerdict={triageVerdict}
      firstCheck={triageFirstCheck}
      canYouDrive={problem.data.canYouDrive}
      estimatedCost={problem.data.estimatedCost}
      diyDifficulty={problem.data.diyDifficulty}
      confusedWith={triageConfusedWith}
      stopDrivingIf={triageStopDrivingIf}
    />
  </Section>

  {vehicleQuality && <DecisionPathBlock title="Vehicle-specific decision path" intro={`Keep ${problem.data.title.toLowerCase()} tied to checks you can confirm before escalating the repair.`} steps={vehicleQuality.decisionPath} />}

  <Section id="symptoms" title="Symptoms to confirm" intro={`Look for the details that separate ${problem.data.title.toLowerCase()} from nearby complaints.`}>
    <ul class="grid gap-3 text-sm leading-6 text-steel sm:grid-cols-2">
      {problem.data.symptoms.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <Section id="causes" title="Likely causes" intro={primaryCause ? `${primaryCause} is the first cause to rule out before moving deeper.` : "Work from the common causes toward the less common ones."}>
    <ol class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.causes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ol>
  </Section>

  <Section id="solutions" title="What usually fixes it" intro={`Work through these fixes only after the checks match ${problem.data.title.toLowerCase()}.`}>
    <ol class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.solutions.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ol>
  </Section>

  <Section id="when-to-see-mechanic" title="When to involve a mechanic" intro={`Escalate ${problem.data.title.toLowerCase()} when the symptom points beyond a simple inspection.`}>
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.whenToSeeMechanic.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <Section id="common-mistakes" title="Common mistakes" intro={`Avoid these shortcuts when chasing ${problem.data.title.toLowerCase()}.`}>
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.commonMistakes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  {
    (problem.data.fitment.appliesTo.length > 0 ||
      problem.data.fitment.doesNotApplyTo.length > 0 ||
      problem.data.fitment.phaseDifferences.length > 0 ||
      problem.data.fitment.powertrainDifferences.length > 0) && (
      <Section
        id="fitment-notes"
        title="Fitment and model notes"
        intro="Before you order parts or assume the diagnosis is universal, check the trim, phase, and powertrain notes below."
      >
        <FitmentNotes fitment={problem.data.fitment} />
      </Section>
    )
  }

  <Section id="recommended-parts" title="Parts worth checking" intro={`These parts make sense only if the checks for ${problem.data.title.toLowerCase()} point here.`}>
    <div class="grid gap-6 md:grid-cols-2">
      {problem.data.recommendedParts.map((product) => <ProductCard product={product} />)}
    </div>
  </Section>

  <RelatedLinks
    title="Related cars"
    intro={`Open the matching vehicle pages when ${problem.data.title.toLowerCase()} needs model-year context.`}
    items={relatedCars}
  />

  <RelatedLinks
    title="Related best-parts guides"
    intro={`These parts guides are useful once ${problem.data.title.toLowerCase()} has a confirmed repair area.`}
    items={relatedBest}
  />
</ContentLayout>
