---
import { getCollection, getEntry } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import FitmentNotes from "../../components/FitmentNotes.astro";
import ProblemTriageBlock from "../../components/ProblemTriageBlock.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import DecisionPathBlock from "../../components/DecisionPathBlock.astro";
import EvidenceLimitsBlock from "../../components/EvidenceLimitsBlock.astro";
import { editorialTeam, problemTrustPoints } from "../../data/editorial";
import { hondaCivicProblemQuality } from "../../data/honda-civic-quality";
import { rav4ProblemQuality } from "../../data/toyota-rav4-quality";
import { includesPhrase, uniqueByHref } from "../../utils/taxonomy";

export async function getStaticPaths() {
  const problems = await getCollection("problems");

  return problems.map((problem) => ({
    params: { slug: problem.id },
    props: { slug: problem.id }
  }));
}

const { slug } = Astro.props;
const problem = await getEntry("problems", slug);

if (!problem) {
  throw new Error(`Problem entry not found for slug: ${slug}`);
}

const [carEntries, bestEntries] = await Promise.all([
  getCollection("cars"),
  getCollection("best")
]);

const relatedCars = uniqueByHref(
  carEntries
  .filter((entry) => {
    return (
      problem.data.relatedCars.includes(entry.id) ||
      entry.data.commonProblems.some((item) => includesPhrase(item, problem.data.title)) ||
      includesPhrase(problem.data.title, entry.data.model)
    );
  })
  .map((entry) => ({
    href: `/cars/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.excerpt ?? entry.data.metaDescription ?? entry.data.description,
    eyebrow: "Car hub"
  }))
);

const relatedBest = uniqueByHref(
  bestEntries
  .filter((entry) => {
    return (
      problem.data.relatedBest.includes(entry.id) ||
      includesPhrase(entry.data.title, problem.data.title) ||
      includesPhrase(problem.data.title, entry.data.category) ||
      problem.data.solutions.some((item) => includesPhrase(item, entry.data.category))
    );
  })
  .map((entry) => ({
    href: `/best/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.excerpt ?? entry.data.metaDescription ?? `${entry.data.products.length} product picks for ${entry.data.car_model}.`,
    eyebrow: entry.data.category
  }))
);

const seoTitle = problem.data.metaTitle ?? problem.data.title;
const seoDescription =
  problem.data.metaDescription ??
  `Diagnostic guide covering symptoms, likely causes, and repair solutions for: ${problem.data.title.toLowerCase()}.`;
const socialImage = problem.data.heroImage ?? problem.data.recommendedParts[0]?.image;
const quickFacts = [
  { label: "Repair urgency", value: problem.data.urgency },
  { label: "Can you drive it?", value: problem.data.canYouDrive },
  { label: "Estimated cost", value: problem.data.estimatedCost },
  { label: "DIY difficulty", value: problem.data.diyDifficulty }
].filter((item) => item.value);
const triageVerdict = problem.data.quickVerdict ?? problem.data.excerpt;
const triageFirstCheck = problem.data.firstCheck ?? problem.data.solutions[0];
const triageConfusedWith = problem.data.confusedWith;
const triageStopDrivingIf =
  problem.data.stopDrivingIf.length > 0 ? problem.data.stopDrivingIf : problem.data.whenToSeeMechanic.slice(0, 2);
const vehicleQuality = rav4ProblemQuality[problem.id] ?? hondaCivicProblemQuality[problem.id];
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Problems", href: "/problems/" },
  { label: problem.data.title }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: seoTitle,
    description: seoDescription,
    image: socialImage ? [new URL(socialImage, Astro.site).toString()] : undefined,
    mainEntityOfPage: Astro.url.href,
    dateModified: problem.data.updatedAt?.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={seoTitle}
  description={seoDescription}
  intro="Use this guide to figure out what the symptom usually means, how urgent it is, and what to check before buying parts or booking the repair."
  faqs={problem.data.faqs}
  image={socialImage}
  modifiedTime={problem.data.updatedAt}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  editorialSummary="These problem guides are written to help drivers identify the most likely cause, make a sensible first check, and avoid wasting money on the wrong repair."
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={problem.data.updatedAt ? `Reviewed ${problem.data.updatedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}` : undefined}
  editorialBadges={["Problem guide", "Fitment notes checked", "Parts links reviewed"]}
>
  <TrustBlock
    summary="Problem guides here are built to help a driver decide what is most likely, how urgent it is, and which repairs are worth checking before money goes in the wrong direction."
    byline={`By ${editorialTeam.name}`}
    checkedLabel={problem.data.updatedAt ? `Checked ${problem.data.updatedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}` : undefined}
    points={problemTrustPoints}
  />

  {vehicleQuality && <EvidenceLimitsBlock {...vehicleQuality.evidence} />}

  <Section id="quick-answer" title="What to know first" intro="This is the short version if you want to decide how serious the problem is before digging deeper.">
    <div class="grid gap-4 md:grid-cols-2">
      {
        quickFacts.map((item) => (
          <div class="rounded-2xl bg-slate-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-steel">{item.label}</p>
            <p class="mt-3 text-sm leading-6 text-ink">{item.value}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="triage" title="Quick triage" intro="Use this section if you want the shortest path from symptom to the first sensible check.">
    <ProblemTriageBlock
      quickVerdict={triageVerdict}
      firstCheck={triageFirstCheck}
      canYouDrive={problem.data.canYouDrive}
      estimatedCost={problem.data.estimatedCost}
      diyDifficulty={problem.data.diyDifficulty}
      confusedWith={triageConfusedWith}
      stopDrivingIf={triageStopDrivingIf}
    />
  </Section>

  {vehicleQuality && <DecisionPathBlock title="Vehicle-specific decision path" intro="Use this to keep the diagnosis focused before buying parts or escalating the repair." steps={vehicleQuality.decisionPath} />}

  <Section id="symptoms" title="Symptoms" intro="These are the signs drivers usually notice before the real cause is confirmed.">
    <ul class="grid gap-3 text-sm leading-6 text-steel sm:grid-cols-2">
      {problem.data.symptoms.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <Section id="causes" title="Likely causes" intro="Start with the common causes first so diagnosis stays efficient and the wrong parts do not get ordered too early.">
    <ol class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.causes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ol>
  </Section>

  <Section id="solutions" title="What usually fixes it" intro="Work through these in order so you can confirm the problem before spending money on parts.">
    <ol class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.solutions.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ol>
  </Section>

  <Section id="when-to-see-mechanic" title="When to involve a mechanic" intro="These are the signs that the problem is moving past a basic driveway diagnosis.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.whenToSeeMechanic.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <Section id="common-mistakes" title="Common mistakes" intro="These are the errors that usually waste time, money, or both.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {problem.data.commonMistakes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  {
    (problem.data.fitment.appliesTo.length > 0 ||
      problem.data.fitment.doesNotApplyTo.length > 0 ||
      problem.data.fitment.phaseDifferences.length > 0 ||
      problem.data.fitment.powertrainDifferences.length > 0) && (
      <Section
        id="fitment-notes"
        title="Fitment and model notes"
        intro="Before you order parts or assume the diagnosis is universal, check the trim, phase, and powertrain notes below."
      >
        <FitmentNotes fitment={problem.data.fitment} />
      </Section>
    )
  }

  <Section id="recommended-parts" title="Parts worth checking" intro="These are the parts most likely to matter once the diagnosis is pointing in the right direction.">
    <div class="grid gap-6 md:grid-cols-2">
      {problem.data.recommendedParts.map((product) => <ProductCard product={product} />)}
    </div>
  </Section>

  <RelatedLinks
    title="Related car pages"
    intro="These vehicle pages give you more context if the same symptom shows up on a specific model."
    items={relatedCars}
  />

  <RelatedLinks
    title="Related best-parts guides"
    intro="If you already know the likely repair area, these guides can help you compare the next parts to look at."
    items={relatedBest}
  />
</ContentLayout>
