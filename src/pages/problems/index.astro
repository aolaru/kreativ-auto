---
import { getCollection } from "astro:content";
import CardIcon from "../../components/CardIcon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const problems = await getCollection("problems");
const newestProblems = [...problems].sort((a, b) => (b.data.updatedAt?.getTime() ?? 0) - (a.data.updatedAt?.getTime() ?? 0));
const civicProblems = newestProblems.filter((problem) => problem.data.relatedCars.includes("honda-civic-2019")).slice(0, 3);
const rav4Problems = newestProblems.filter((problem) => problem.data.relatedCars.includes("toyota-rav4-2021") || problem.data.relatedCars.includes("toyota-rav4-2020")).slice(0, 3);
const tiguanProblems = newestProblems.filter((problem) => problem.data.relatedCars.includes("vw-tiguan-2020")).slice(0, 3);
---

<BaseLayout title="Problem Guides" description="Automotive diagnostic pages focused on symptoms, causes, solutions, and recommended parts.">
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Problems</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Problem guides that start with the symptom</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        If a car shakes, clicks, squeals, hums, or misfires, these guides are here to help you narrow down the likely cause before you spend money in the wrong place.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <section class="surface p-6">
        <p class="eyebrow">Civic cluster</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Honda Civic 2019</h2>
        {
          civicProblems[0]?.data.heroImage && (
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img
                src={civicProblems[0].data.heroImage}
                alt="Honda Civic problem guide"
                class="h-44 w-full object-cover"
                loading="lazy"
                width="960"
                height="640"
              />
            </div>
          )
        }
        <p class="mt-3 text-sm leading-6 text-steel">Brake noise, idle cooling complaints, charging behavior, and the everyday commuter issues owners actually run into.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {civicProblems.map((problem) => <li><a class="hover:text-accent" href={`/problems/${problem.id}/`}>{problem.data.title}</a></li>)}
        </ul>
      </section>
      <section class="surface p-6">
        <p class="eyebrow">RAV4 cluster</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Toyota RAV4 XA50</h2>
        {
          rav4Problems[0]?.data.heroImage && (
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img
                src={rav4Problems[0].data.heroImage}
                alt="Toyota RAV4 problem guide"
                class="h-44 w-full object-cover"
                loading="lazy"
                width="960"
                height="640"
              />
            </div>
          )
        }
        <p class="mt-3 text-sm leading-6 text-steel">Battery complaints, suspension noises, rear brake refinement issues, and the problems that show up in normal daily use.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {rav4Problems.map((problem) => <li><a class="hover:text-accent" href={`/problems/${problem.id}/`}>{problem.data.title}</a></li>)}
        </ul>
      </section>
      <section class="surface p-6">
        <p class="eyebrow">Tiguan cluster</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">VW Tiguan II facelift</h2>
        {
          tiguanProblems[0]?.data.heroImage && (
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img
                src={tiguanProblems[0].data.heroImage}
                alt="Volkswagen Tiguan problem guide"
                class="h-44 w-full object-cover"
                loading="lazy"
                width="960"
                height="640"
              />
            </div>
          )
        }
        <p class="mt-3 text-sm leading-6 text-steel">Coolant loss, EPC warnings, oil use, and the late-model Tiguan problems most likely to waste time if you diagnose them loosely.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {tiguanProblems.map((problem) => <li><a class="hover:text-accent" href={`/problems/${problem.id}/`}>{problem.data.title}</a></li>)}
        </ul>
      </section>
    </div>

    <div class="mt-10 grid gap-6">
      {
        newestProblems.map((problem) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/problems/${problem.id}/`}>
            <div class="mb-4 flex items-center gap-3">
              <CardIcon kind="problem" />
              <div>
                <p class="eyebrow">Diagnostic guide</p>
                <h2 class="mt-1 text-2xl font-semibold text-ink">{problem.data.title}</h2>
              </div>
            </div>
            {
              problem.data.heroImage && (
                <div class="mb-5 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={problem.data.heroImage}
                    alt={problem.data.title}
                    class="h-52 w-full object-cover"
                    loading="lazy"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="mt-3 text-sm leading-6 text-steel">
              Covers {problem.data.symptoms.length} symptoms, {problem.data.causes.length} likely causes, and {problem.data.solutions.length} possible solutions.
            </p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
