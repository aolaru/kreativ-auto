---
import { getCollection, getEntry } from "astro:content";
import ComparisonTable from "../../components/ComparisonTable.astro";
import ProductCard from "../../components/ProductCard.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import FitmentNotes from "../../components/FitmentNotes.astro";
import BestDecisionBlock from "../../components/BestDecisionBlock.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { bestMethodologyPoints, editorialTeam } from "../../data/editorial";
import { withAffiliateTag } from "../../utils/affiliate";
import { includesPhrase, uniqueByHref } from "../../utils/taxonomy";

export async function getStaticPaths() {
  const entries = await getCollection("best");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id }
  }));
}

const { slug } = Astro.props;
const entry = await getEntry("best", slug);

if (!entry) {
  throw new Error(`Best entry not found for slug: ${slug}`);
}

const [carEntries, problemEntries] = await Promise.all([
  getCollection("cars"),
  getCollection("problems")
]);

const relatedCars = uniqueByHref(
  carEntries
  .filter((car) => {
    return (
      entry.data.relatedCars.includes(car.id) ||
      includesPhrase(entry.data.car_model, `${car.data.brand} ${car.data.model} ${car.data.year}`) ||
      includesPhrase(entry.data.car_model, car.data.model)
    );
  })
  .map((car) => ({
    href: `/cars/${car.id}/`,
    title: car.data.title,
    description: car.data.excerpt ?? car.data.metaDescription ?? car.data.description,
    eyebrow: "Car hub"
  }))
);

const relatedProblems = uniqueByHref(
  problemEntries
  .filter((problem) => {
    return (
      entry.data.relatedProblems.includes(problem.id) ||
      includesPhrase(problem.data.title, entry.data.category) ||
      problem.data.symptoms.some((item) => includesPhrase(item, entry.data.category)) ||
      problem.data.causes.some((item) => includesPhrase(item, entry.data.category))
    );
  })
  .map((problem) => ({
    href: `/problems/${problem.id}/`,
    title: problem.data.title,
    description:
      problem.data.excerpt ?? problem.data.metaDescription ?? `Solutions: ${problem.data.solutions.slice(0, 2).join(", ")}.`,
    eyebrow: "Problem guide"
  }))
);

const seoTitle = entry.data.metaTitle ?? entry.data.title;
const seoDescription =
  entry.data.metaDescription ?? `Comparison guide for the best ${entry.data.category.toLowerCase()} for ${entry.data.car_model}.`;
const socialImage = entry.data.heroImage ?? entry.data.products[0]?.image;
const quickVerdict = entry.data.quickVerdict ?? entry.data.excerpt;
const bestFor = entry.data.bestFor.length > 0 ? entry.data.bestFor : entry.data.products.slice(0, 2).map((product) => product.summary ?? product.name).filter(Boolean);
const avoidIf = entry.data.avoidIf;
const buyingTiers = entry.data.buyingTiers;
const fitmentCaveat =
  entry.data.fitment.doesNotApplyTo[0] ??
  entry.data.fitment.phaseDifferences[0] ??
  entry.data.fitment.powertrainDifferences[0];
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Best Parts", href: "/best/" },
  { label: entry.data.title }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: seoTitle,
    itemListElement: entry.data.products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        image: product.image ? new URL(product.image, Astro.site).toString() : undefined,
        offers: {
          "@type": "Offer",
          url: withAffiliateTag(product.affiliate_url),
          priceCurrency: "USD",
          price: product.price.replace(/[^0-9.]/g, "")
        }
      }
    })),
    dateModified: entry.data.updatedAt?.toISOString()
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: seoTitle,
    description: seoDescription,
    image: socialImage ? [new URL(socialImage, Astro.site).toString()] : undefined,
    mainEntityOfPage: Astro.url.href,
    dateModified: entry.data.updatedAt?.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={seoTitle}
  description={seoDescription}
  intro="This guide is here to help you compare the strongest options quickly, understand the tradeoffs, and choose the part that makes the most sense for your car."
  faqs={entry.data.faqs}
  image={socialImage}
  modifiedTime={entry.data.updatedAt}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  editorialSummary="These best-parts guides prioritize fitment confidence, normal daily use, and parts that make sense for real ownership instead of inflated spec-sheet hype."
  editorialByline={`By ${editorialTeam.name}`}
  editorialReviewedLabel={entry.data.updatedAt ? `Reviewed ${entry.data.updatedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}` : undefined}
  editorialBadges={["Comparison guide", "Methodology applied", "Fitment notes checked"]}
>
  <TrustBlock
    title="How these picks are chosen"
    summary="These recommendations prioritize fitment confidence, predictable daily use, and brands with a solid aftermarket reputation. The goal is to help narrow the field quickly, not pad the page with parts that do the same job."
    byline={`By ${editorialTeam.name}`}
    checkedLabel={entry.data.updatedAt ? `Checked ${entry.data.updatedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}` : undefined}
    points={bestMethodologyPoints}
  />

  <Section id="decision-block" title="Quick decision" intro="Use this section if you want the shortlist logic before digging through the full comparison.">
    <BestDecisionBlock
      quickVerdict={quickVerdict}
      bestFor={bestFor}
      avoidIf={avoidIf}
      buyingTiers={buyingTiers}
      products={entry.data.products}
      fitmentCaveat={fitmentCaveat}
    />
  </Section>

  <Section id="comparison-table" title="Comparison table" intro="Start with the table if you want the fast version before digging into the details.">
    <ComparisonTable products={entry.data.products} />
  </Section>

  <Section id="product-cards" title="Product cards" intro="The cards below give a little more context on where each option makes sense.">
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {entry.data.products.map((product) => <ProductCard product={product} />)}
    </div>
  </Section>

  <Section id="buying-advice" title="Buying advice" intro="The right part depends on how the car is driven, how much refinement you want, and how much compromise you are willing to accept.">
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {entry.data.buyingAdvice.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  {
    (entry.data.fitment.appliesTo.length > 0 ||
      entry.data.fitment.doesNotApplyTo.length > 0 ||
      entry.data.fitment.phaseDifferences.length > 0 ||
      entry.data.fitment.powertrainDifferences.length > 0) && (
      <Section
        id="fitment-notes"
        title="Fitment and model notes"
        intro="Check these notes before ordering so the shortlist matches the trim, generation phase, and powertrain you actually have."
      >
        <FitmentNotes fitment={entry.data.fitment} />
      </Section>
    )
  }

  <Section
    id="methodology"
    title="Methodology"
    intro="The shortlist is built around parts that are easy to recommend to a normal owner, not just the most expensive or most aggressively marketed option."
  >
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {bestMethodologyPoints.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  <RelatedLinks
    title="Related car hubs"
    intro="These vehicle pages help confirm fitment context, common issues, and the maintenance picture around the part."
    items={relatedCars}
  />

  <RelatedLinks
    title="Related problem guides"
    intro="These guides are useful if you are still confirming the symptom or trying to make sure you are solving the right problem."
    items={relatedProblems}
  />
</ContentLayout>
