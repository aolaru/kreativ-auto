---
import { getCollection, getEntry, render } from "astro:content";
import ComparisonTable from "../../components/ComparisonTable.astro";
import ProductCard from "../../components/ProductCard.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import FitmentNotes from "../../components/FitmentNotes.astro";
import BestDecisionBlock from "../../components/BestDecisionBlock.astro";
import DecisionPathBlock from "../../components/DecisionPathBlock.astro";
import EvidenceLimitsBlock from "../../components/EvidenceLimitsBlock.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { editorialTeam } from "../../data/editorial";
import { hondaCivicBestQuality } from "../../data/honda-civic-quality";
import { highlanderBestQuality } from "../../data/toyota-highlander-quality";
import { rav4BestQuality } from "../../data/toyota-rav4-quality";
import { withAffiliateTag } from "../../utils/affiliate";
import { includesPhrase, uniqueByHref } from "../../utils/taxonomy";

export async function getStaticPaths() {
  const entries = await getCollection("best");

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id }
  }));
}

const { slug } = Astro.props;
const entry = await getEntry("best", slug);

if (!entry) {
  throw new Error(`Best entry not found for slug: ${slug}`);
}

const { Content } = await render(entry);

const [carEntries, problemEntries] = await Promise.all([
  getCollection("cars"),
  getCollection("problems")
]);

const relatedCars = uniqueByHref(
  carEntries
  .filter((car) => {
    return (
      entry.data.relatedCars.includes(car.id) ||
      includesPhrase(entry.data.car_model, `${car.data.brand} ${car.data.model} ${car.data.year}`) ||
      includesPhrase(entry.data.car_model, car.data.model)
    );
  })
  .map((car) => ({
    href: `/cars/${car.id}/`,
    title: car.data.title,
    description: car.data.excerpt ?? car.data.metaDescription ?? car.data.description,
    eyebrow: "Car"
  }))
);

const relatedProblems = uniqueByHref(
  problemEntries
  .filter((problem) => {
    return (
      entry.data.relatedProblems.includes(problem.id) ||
      includesPhrase(problem.data.title, entry.data.category) ||
      problem.data.symptoms.some((item) => includesPhrase(item, entry.data.category)) ||
      problem.data.causes.some((item) => includesPhrase(item, entry.data.category))
    );
  })
  .sort((a, b) => Number(entry.data.relatedProblems.includes(b.id)) - Number(entry.data.relatedProblems.includes(a.id)))
  .map((problem) => ({
    href: `/problems/${problem.id}/`,
    title: problem.data.title,
    description:
      problem.data.excerpt ?? problem.data.metaDescription ?? `Solutions: ${problem.data.solutions.slice(0, 2).join(", ")}.`,
    eyebrow: "Problem guide"
  }))
);

const seoTitle = entry.data.metaTitle ?? entry.data.title;
const seoDescription =
  entry.data.metaDescription ?? `Comparison guide for the best ${entry.data.category.toLowerCase()} for ${entry.data.car_model}.`;
const socialImage = entry.data.heroImage ?? entry.data.products[0]?.image;
const quickVerdict = entry.data.quickVerdict ?? entry.data.excerpt;
const bestFor = entry.data.bestFor.length > 0 ? entry.data.bestFor : entry.data.products.slice(0, 2).map((product) => product.summary ?? product.name).filter(Boolean);
const avoidIf = entry.data.avoidIf;
const buyingTiers = entry.data.buyingTiers;
const categoryTerm = entry.data.category.toLowerCase();
const vehicleLabel = entry.data.car_model;
const vehicleQuality = rav4BestQuality[entry.id] ?? hondaCivicBestQuality[entry.id] ?? highlanderBestQuality[entry.id];
const priceIsVerified = entry.data.priceVerified === true && entry.data.priceSourceLinks.length > 0;
const fitmentCaveat =
  entry.data.fitment.doesNotApplyTo[0] ??
  entry.data.fitment.phaseDifferences[0] ??
  entry.data.fitment.powertrainDifferences[0];
const topProduct = entry.data.products[0];
const mainRelatedProblem = relatedProblems[0];
const beforeBuyingChecks = [
  {
    label: "Confirm the symptom",
    description: mainRelatedProblem
      ? `If the car still has an unclear symptom, open ${mainRelatedProblem.title} before treating this ${categoryTerm} shortlist as the fix.`
      : `Make sure the problem really points at ${categoryTerm} before replacing parts. Similar symptoms can come from adjacent systems.`
  },
  {
    label: "Check exact fitment",
    description: fitmentCaveat
      ? `Do not order until this note is resolved: ${fitmentCaveat}`
      : `Match the vehicle year, trim, engine, and generation notes before choosing between the options for ${entry.data.car_model}.`
  },
  {
    label: "Choose for the job",
    description: topProduct
      ? `${topProduct.name} is the first shortlist option, but the right pick still depends on driving style, budget, and how long you plan to keep the car.`
      : "The best choice depends on driving style, budget, and how long you plan to keep the car."
  }
];
const methodologyPointsForPage = [
  topProduct
    ? `${topProduct.name} starts the ${vehicleLabel} shortlist because it fits the main daily-use case for ${categoryTerm}.`
    : `${vehicleLabel} ${categoryTerm} picks are limited to options with enough detail to compare cleanly.`,
  fitmentCaveat
    ? `The fitment warning is kept visible before the product notes: ${fitmentCaveat}`
    : `Year, trim, engine, and generation notes are checked before a ${categoryTerm} option is treated as a match.`,
  bestFor[0]
    ? `The final choice should support ${bestFor[0].toLowerCase()}, not just the strongest marketing claim.`
    : `The final choice should match the car's normal use, the confirmed repair area, and the owner's budget.`
];
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Best Parts", href: "/best/" },
  { label: entry.data.title }
];
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.label,
      item: item.href ? new URL(item.href, Astro.site).toString() : Astro.url.href
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: seoTitle,
    itemListElement: entry.data.products.map((product, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        image: product.image ? new URL(product.image, Astro.site).toString() : undefined,
        offers: {
          "@type": "Offer",
          url: withAffiliateTag(product.affiliate_url),
          ...(priceIsVerified
            ? {
                priceCurrency: "USD",
                price: product.price.replace(/[^0-9.]/g, "")
              }
            : {})
        }
      }
    })),
    dateModified: entry.data.updatedAt?.toISOString()
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: seoTitle,
    description: seoDescription,
    image: socialImage ? [new URL(socialImage, Astro.site).toString()] : undefined,
    mainEntityOfPage: Astro.url.href,
    dateModified: entry.data.updatedAt?.toISOString(),
    author: {
      "@type": "Organization",
      name: editorialTeam.name
    },
    publisher: {
      "@type": "Organization",
      name: editorialTeam.publisher
    }
  }
];
---

<ContentLayout
  title={seoTitle}
  description={seoDescription}
  intro={entry.data.excerpt ?? seoDescription}
  faqs={entry.data.faqs}
  image={socialImage}
  modifiedTime={entry.data.updatedAt}
  breadcrumbs={breadcrumbs}
  schemas={schemas}
  enableAds={false}
  noindex={true}
>
  {vehicleQuality && <EvidenceLimitsBlock {...vehicleQuality.evidence} />}

  {entry.data.hasResearchBody && (
    <Section id="model-context" title="Model-specific research">
      <div class="max-w-none space-y-4 text-base leading-7 text-steel [&_p]:leading-7 [&_h2]:text-xl [&_h2]:font-semibold [&_a]:underline [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6">
        <Content />
      </div>
    </Section>
  )}

  <Section
    id="research-notes"
    title="Research and price status"
    intro="Fitment and source material come before price. Retailer prices stay hidden until a dated verification is recorded."
  >
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <p class="eyebrow">Price status</p>
        <p class="mt-3 text-sm leading-6 text-steel">
          {priceIsVerified && entry.data.pricingCheckedAt
            ? `Prices checked ${entry.data.pricingCheckedAt.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}.`
            : "No current product-level price source is recorded. Check the retailer directly before treating a listed product as a budget estimate."}
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <p class="eyebrow">Selection criteria</p>
        <ul class="mt-3 space-y-2 text-sm leading-6 text-steel">
          {(entry.data.selectionCriteria.length > 0 ? entry.data.selectionCriteria : methodologyPointsForPage).map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <p class="eyebrow">Alternatives</p>
        <ul class="mt-3 space-y-2 text-sm leading-6 text-steel">
          {(entry.data.alternatives.length > 0 ? entry.data.alternatives : ["Compare the exact OEM specification with at least one equivalent from a catalog that supports your VIN or engine code."]).map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
    {
      entry.data.sourceLinks.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-3">
          {entry.data.sourceLinks.map((source) => (
            <a class="rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-steel transition hover:border-accent hover:text-accent" href={source.href} rel="nofollow noopener" target="_blank">
              {source.label}
            </a>
          ))}
        </div>
      )
    }
    {
      priceIsVerified && entry.data.priceSourceLinks.length > 0 && (
        <div class="mt-5 border-t border-slate-200 pt-5">
          <p class="eyebrow">Price sources</p>
          <div class="mt-3 flex flex-wrap gap-3">
            {entry.data.priceSourceLinks.map((source) => (
              <a class="rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-steel transition hover:border-accent hover:text-accent" href={source.href} rel="nofollow noopener" target="_blank">
                {source.label}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </Section>

  <Section id="decision-block" title={`${entry.data.category} shortlist`} intro={`Start with the ${vehicleLabel} use case and the ${categoryTerm} problem you are trying to solve.`}>
    <BestDecisionBlock
      quickVerdict={quickVerdict}
      bestFor={bestFor}
      avoidIf={avoidIf}
      buyingTiers={buyingTiers}
      products={entry.data.products}
      fitmentCaveat={fitmentCaveat}
      showPrice={priceIsVerified}
    />
  </Section>

  <Section id="before-you-buy" title="Before you buy" intro={`Confirm the symptom, the trim, and the part family before ordering ${categoryTerm} for ${vehicleLabel}.`}>
    <div class="grid gap-4 lg:grid-cols-3">
      {
        beforeBuyingChecks.map((item) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p class="eyebrow">{item.label}</p>
            <p class="mt-3 text-sm leading-6 text-steel">{item.description}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {vehicleQuality && <DecisionPathBlock title="Check before purchase" intro="Confirm the symptom and exact configuration before ordering a part." steps={vehicleQuality.decisionPath} />}

  <Section id="comparison-table" title={`${entry.data.category} comparison`} intro={`Compare the main ${categoryTerm} tradeoffs before reading each product note.`}>
    <ComparisonTable products={entry.data.products} showPrice={priceIsVerified} />
  </Section>

  <Section id="product-cards" title="Shortlist details" intro={`Each option below is framed around where it makes sense on ${vehicleLabel}.`}>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {entry.data.products.map((product) => <ProductCard product={product} showPrice={priceIsVerified} />)}
    </div>
  </Section>

  <Section id="buying-advice" title={`${entry.data.category} buying notes`} intro={`The right ${categoryTerm} depends on how ${vehicleLabel} is driven, how much refinement matters, and how much compromise is acceptable.`}>
    <ul class="space-y-3 text-sm leading-6 text-steel">
      {entry.data.buyingAdvice.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
    </ul>
  </Section>

  {
    (entry.data.fitment.appliesTo.length > 0 ||
      entry.data.fitment.doesNotApplyTo.length > 0 ||
      entry.data.fitment.phaseDifferences.length > 0 ||
      entry.data.fitment.powertrainDifferences.length > 0) && (
      <Section
        id="fitment-notes"
        title="Fitment and model notes"
        intro={`Check these notes before ordering so the ${categoryTerm} shortlist matches the trim, generation phase, and powertrain you actually have.`}
      >
        <FitmentNotes fitment={entry.data.fitment} />
      </Section>
    )
  }

  <RelatedLinks
    title="Related cars"
    intro={`Open these vehicle pages if the ${categoryTerm} choice depends on year, trim, or platform details.`}
    items={relatedCars}
    imageLimit={0}
  />

  <RelatedLinks
    title="Related problem guides"
    intro={`Use these diagnostics if the symptom is not clearly solved by ${categoryTerm} yet.`}
    items={relatedProblems}
    imageLimit={0}
  />
</ContentLayout>
