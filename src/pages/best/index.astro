---
import { getCollection } from "astro:content";
import CardIcon from "../../components/CardIcon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const bestPages = await getCollection("best");
---

<BaseLayout title="Best Parts" description="Comparison pages for the best automotive parts by vehicle and category.">
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Best Parts</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Parts guides with clear recommendations</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        These pages are built to help you compare solid options quickly, understand the differences, and choose the part that fits your car and your budget.
      </p>
    </div>

    <div class="mt-10 grid gap-6">
      {
        bestPages.map((entry) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/best/${entry.id}/`}>
            <div class="mb-4 flex items-center gap-3">
              <CardIcon kind="parts" />
              <div>
                <p class="eyebrow">{entry.data.category}</p>
                <h2 class="mt-1 text-2xl font-semibold text-ink">{entry.data.title}</h2>
              </div>
            </div>
            <p class="mt-3 text-sm leading-6 text-steel">
              {entry.data.products.length} curated products for {entry.data.car_model}.
            </p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
