---
import { getCollection } from "astro:content";
import CardIcon from "../../components/CardIcon.astro";
import FilterToolbar from "../../components/FilterToolbar.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { toThumbnail } from "../../utils/images";

const bestPages = await getCollection("best");
const newestBest = [...bestPages].sort((a, b) => (b.data.updatedAt?.getTime() ?? 0) - (a.data.updatedAt?.getTime() ?? 0));

const civicBest = newestBest.filter((entry) => entry.data.relatedCars.includes("honda-civic-2019")).slice(0, 4);
const rav4Best = newestBest.filter((entry) => entry.data.relatedCars.includes("toyota-rav4-2021") || entry.data.relatedCars.includes("toyota-rav4-2020")).slice(0, 4);
const tiguanBest = newestBest.filter((entry) => entry.data.relatedCars.includes("vw-tiguan-2020")).slice(0, 4);

const getBestCluster = (entry: (typeof newestBest)[number]) => {
  if (entry.data.relatedCars.includes("honda-civic-2019")) return "civic";
  if (entry.data.relatedCars.includes("toyota-rav4-2020") || entry.data.relatedCars.includes("toyota-rav4-2021")) return "rav4";
  if (entry.data.relatedCars.includes("vw-tiguan-2020")) return "tiguan";
  return "other";
};

const categoryOptions = [...new Set(newestBest.map((entry) => entry.data.category))]
  .sort((a, b) => a.localeCompare(b))
  .map((category) => ({
    value: category.toLowerCase().replace(/[^a-z0-9]+/g, "-"),
    label: category
  }));

const bestFilters = [
  {
    name: "cluster",
    label: "Cluster",
    options: [
      { value: "civic", label: "Honda Civic" },
      { value: "rav4", label: "Toyota RAV4" },
      { value: "tiguan", label: "VW Tiguan" },
      { value: "other", label: "Other vehicles" }
    ]
  },
  {
    name: "category",
    label: "Part category",
    options: categoryOptions
  }
];

const featuredCategories = [
  {
    title: "Brake parts",
    description: "Start here for brake pads, rotors, and the parts that solve squeal, shake, and uneven braking behavior.",
    href: "/categories/brake-pads/"
  },
  {
    title: "Battery and charging",
    description: "Use these guides when the real issue is weak starts, short-trip use, or reserve capacity that is fading.",
    href: "/categories/batteries/"
  },
  {
    title: "Ignition and drivability",
    description: "Useful for misfires, EPC behavior, hesitation, and the parts that keep turbo and daily-driver engines clean.",
    href: "/categories/ignition-coils/"
  }
];
---

<BaseLayout enableAds={false} title="Best Parts" description="Comparison pages for the best automotive parts by vehicle and category.">
  <div class="container-shell py-12 sm:py-16">
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">Best Parts</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Start with the strongest parts clusters</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        These guides are meant to help you compare the parts that actually solve common ownership problems, not just skim a generic product list. Start with the deepest car clusters first, then drop into the full guide list if you already know the exact part area.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <section class="surface p-6">
        <p class="eyebrow">Civic cluster</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Honda Civic 2019</h2>
        {
          civicBest[0]?.data.heroImage && (
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img
                src={toThumbnail(civicBest[0].data.heroImage)}
                alt="Honda Civic best-parts guide"
                class="h-44 w-full object-cover"
                loading="lazy"
                decoding="async"
                width="960"
                height="640"
              />
            </div>
          )
        }
        <p class="mt-3 text-sm leading-6 text-steel">Brake pads, A/C condensers, batteries, spark plugs, and the parts that matter once a normal Civic starts acting like a tired commuter.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {civicBest.map((entry) => <li><a class="hover:text-accent" href={`/best/${entry.id}/`}>{entry.data.title}</a></li>)}
        </ul>
      </section>
      <section class="surface p-6">
        <p class="eyebrow">RAV4 cluster</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">Toyota RAV4 XA50</h2>
        {
          rav4Best[0]?.data.heroImage && (
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img
                src={toThumbnail(rav4Best[0].data.heroImage)}
                alt="Toyota RAV4 best-parts guide"
                class="h-44 w-full object-cover"
                loading="lazy"
                decoding="async"
                width="960"
                height="640"
              />
            </div>
          )
        }
        <p class="mt-3 text-sm leading-6 text-steel">Brake refinement, batteries, sway-bar links, tires, and the parts most likely to come up in normal daily RAV4 ownership.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {rav4Best.map((entry) => <li><a class="hover:text-accent" href={`/best/${entry.id}/`}>{entry.data.title}</a></li>)}
        </ul>
      </section>
      <section class="surface p-6">
        <p class="eyebrow">Tiguan cluster</p>
        <h2 class="mt-3 text-2xl font-semibold text-ink">VW Tiguan II facelift</h2>
        {
          tiguanBest[0]?.data.heroImage && (
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img
                src={toThumbnail(tiguanBest[0].data.heroImage)}
                alt="Volkswagen Tiguan best-parts guide"
                class="h-44 w-full object-cover"
                loading="lazy"
                decoding="async"
                width="960"
                height="640"
              />
            </div>
          )
        }
        <p class="mt-3 text-sm leading-6 text-steel">Brake parts, coolant, ignition, oil, batteries, and the late-model Tiguan parts that matter when diagnosis gets more specific.</p>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-steel">
          {tiguanBest.map((entry) => <li><a class="hover:text-accent" href={`/best/${entry.id}/`}>{entry.data.title}</a></li>)}
        </ul>
      </section>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        featuredCategories.map((category) => (
          <a class="surface block p-6 transition hover:-translate-y-0.5" href={category.href}>
            <div class="flex items-center gap-3">
              <CardIcon kind="parts" />
              <div>
                <p class="eyebrow">Category</p>
                <h2 class="mt-1 text-2xl font-semibold text-ink">{category.title}</h2>
              </div>
            </div>
            <p class="mt-4 text-sm leading-6 text-steel">{category.description}</p>
          </a>
        ))
      }
    </div>

    <section class="mt-10 surface p-6 sm:p-8" data-filter-root>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Browse all</p>
          <h2 class="mt-3 text-3xl font-semibold text-ink">Filter every best-parts guide</h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-steel">
            Narrow the shortlist by vehicle cluster and part category when you already know the repair area and want the fastest path to the right guide.
          </p>
        </div>
        <p class="text-sm text-steel">
          <span class="font-semibold text-ink" data-filter-count></span> guides
        </p>
      </div>

      <div class="mt-6">
        <FilterToolbar filters={bestFilters} searchPlaceholder="Search best-parts guides by car, part, or problem" />
      </div>

      <div class="mt-8 grid gap-6">
      {
        newestBest.map((entry) => (
          <a
            class="surface block p-6 transition hover:-translate-y-0.5"
            href={`/best/${entry.id}/`}
            data-filter-item
            data-filter-cluster={getBestCluster(entry)}
            data-filter-category={entry.data.category.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
            data-filter-search-text={`${entry.data.title} ${entry.data.car_model} ${entry.data.category} ${entry.data.excerpt ?? ""}`}
          >
            <div class="mb-4 flex items-center gap-3">
              <CardIcon kind="parts" />
              <div>
                <p class="eyebrow">{entry.data.category}</p>
                <h2 class="mt-1 text-2xl font-semibold text-ink">{entry.data.title}</h2>
              </div>
            </div>
            {
              entry.data.heroImage && (
                <div class="mb-5 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
                  <img
                    src={toThumbnail(entry.data.heroImage)}
                    alt={entry.data.title}
                    class="h-52 w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="960"
                    height="640"
                  />
                </div>
              )
            }
            <p class="mt-3 text-sm leading-6 text-steel">
              {entry.data.products.length} curated products for {entry.data.car_model}.
            </p>
          </a>
        ))
      }
      </div>

      <div class="mt-6 rounded-2xl border border-dashed border-slate-300 px-4 py-5 text-sm leading-6 text-steel" data-empty-state hidden>
        No best-parts guides match the current filters.
      </div>
    </section>
  </div>
</BaseLayout>
