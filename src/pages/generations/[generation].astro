---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import { comparisonGuides } from "../../data/comparison-guides";
import { generationHubContent } from "../../data/generation-hubs";
import {
  getGenerationKey,
  getGenerationLabel,
  getGenerationRange,
  getGenerationSlug,
  includesPhrase,
  uniqueByHref
} from "../../utils/taxonomy";

export async function getStaticPaths() {
  const cars = await getCollection("cars");
  const seen = new Set<string>();

  return cars.flatMap((car) => {
    const slug = getGenerationSlug(car.data);

    if (seen.has(slug)) {
      return [];
    }

    seen.add(slug);

    return {
      params: { generation: slug },
      props: { generationKey: getGenerationKey(car.data) }
    };
  });
}

const { generationKey } = Astro.props;
const [cars, problems, bestPages] = await Promise.all([
  getCollection("cars"),
  getCollection("problems"),
  getCollection("best")
]);

const generationCars = cars.filter((car) => getGenerationKey(car.data) === generationKey);
const leadCar = generationCars[0];

if (!leadCar) {
  throw new Error(`Generation entry not found for key: ${generationKey}`);
}

const linkedProblems = uniqueByHref(
  problems
    .filter((problem) =>
      generationCars.some(
        (car) =>
          car.data.relatedProblems.includes(problem.id) ||
          car.data.commonProblems.some((item) => includesPhrase(item, problem.data.title))
      )
    )
    .map((problem) => ({
      href: `/problems/${problem.id}/`,
      title: problem.data.title,
      description: problem.data.excerpt ?? problem.data.metaDescription,
      eyebrow: "Problem guide"
    }))
);

const linkedBest = uniqueByHref(
  bestPages
    .filter((entry) =>
      generationCars.some(
        (car) =>
          car.data.relatedBest.includes(entry.id) ||
          includesPhrase(entry.data.car_model, `${car.data.brand} ${car.data.model}`)
      )
    )
    .map((entry) => ({
      href: `/best/${entry.id}/`,
      title: entry.data.title,
      description: entry.data.excerpt ?? entry.data.metaDescription,
      eyebrow: entry.data.category
    }))
);

const generationLabel = getGenerationLabel(leadCar.data);
const generationRange = getGenerationRange(leadCar.data);
const generationSlug = getGenerationSlug(leadCar.data);
const hubContent = generationHubContent[generationSlug];
const relatedComparisons = uniqueByHref(
  comparisonGuides
    .filter((guide) => guide.relatedGenerations?.includes(generationSlug))
    .map((guide) => ({
      href: guide.href,
      title: guide.title,
      description: guide.description,
      eyebrow: guide.eyebrow
    }))
);
const featuredProblems = hubContent?.featuredProblems?.length
  ? linkedProblems.filter((item) => hubContent.featuredProblems?.some((slug) => item.href === `/problems/${slug}/`))
  : linkedProblems;
const featuredBest = hubContent?.featuredBest?.length
  ? linkedBest.filter((item) => hubContent.featuredBest?.some((slug) => item.href === `/best/${slug}/`))
  : linkedBest;
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Generations", href: "/generations/" },
  { label: generationLabel }
];
---

<BaseLayout
  title={`${generationLabel} Guides`}
  description={
    hubContent?.intro ?? `Browse ${generationLabel} pages, grouped by generation range and facelift phase.`
  }
  image={leadCar.data.heroImage ?? leadCar.data.image}
>
  <div class="container-shell py-12 sm:py-16">
    <Breadcrumbs items={breadcrumbs} />
    <div class="surface p-8 sm:p-10">
      <p class="eyebrow">{hubContent?.eyebrow ?? "Generation Hub"}</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{generationLabel}</h1>
      <p class="mt-4 text-sm font-semibold uppercase tracking-[0.18em] text-steel">{generationRange}</p>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-steel">
        {hubContent?.intro ??
          "This page groups model-year guides that share the same generation or facelift window, which is usually the level where problems and parts overlap the most."}
      </p>
    </div>

    {
      hubContent && (
        <div class="mt-10 space-y-8">
          {
            hubContent.startHere && hubContent.startHere.length > 0 && (
              <Section
                title="Start here"
                intro="If this is your first stop on the generation, use these paths to get to the most useful problem, parts, and comparison pages faster."
              >
                <div class="grid gap-4 md:grid-cols-3">
                  {hubContent.startHere.map((item) => (
                    <a class="rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-0.5 hover:border-sand-300" href={item.href}>
                      <p class="eyebrow">Best next read</p>
                      <h3 class="mt-3 text-lg font-semibold text-ink">{item.title}</h3>
                      <p class="mt-3 text-sm leading-6 text-steel">{item.description}</p>
                    </a>
                  ))}
                </div>
              </Section>
            )
          }

          <Section
            title="Why this generation matters"
            intro="These are the ownership patterns that repeat often enough to make the generation hub more useful than a single model-year page."
          >
            <ul class="space-y-3 text-sm leading-6 text-steel">
              {hubContent.overview.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
            </ul>
          </Section>

          <Section
            title="Common trouble spots"
            intro="These are the areas worth checking first when this generation starts feeling rougher, noisier, or less sorted."
          >
            <ul class="grid gap-3 text-sm leading-6 text-steel md:grid-cols-2">
              {hubContent.painPoints.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
            </ul>
          </Section>

          {
            hubContent.firstPartsToCheck && hubContent.firstPartsToCheck.length > 0 && (
              <Section
                title="Best first parts to check"
                intro="These are the first repair areas worth checking before the diagnosis gets more expensive than it needs to be."
              >
                <ul class="grid gap-3 text-sm leading-6 text-steel md:grid-cols-2">
                  {hubContent.firstPartsToCheck.map((item) => (
                    <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>
                  ))}
                </ul>
              </Section>
            )
          }

          <Section
            title="Ownership notes"
            intro="Use these notes to keep diagnosis and parts buying grounded in how this generation is actually used."
          >
            <ul class="space-y-3 text-sm leading-6 text-steel">
              {hubContent.ownershipNotes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
            </ul>
          </Section>

          {
            hubContent.phaseNotes && hubContent.phaseNotes.length > 0 && (
              <Section
                title="Pre-facelift vs facelift"
                intro="These notes help keep the current generation window separate from earlier overlap where the parts and ownership pattern start to drift."
              >
                <ul class="space-y-3 text-sm leading-6 text-steel">
                  {hubContent.phaseNotes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
                </ul>
              </Section>
            )
          }

          {
            hubContent.cautionNotes && hubContent.cautionNotes.length > 0 && (
              <Section
                title="Which trims or years need extra care"
                intro="These are the places where advice starts drifting if you treat the whole generation like one identical car."
              >
                <ul class="space-y-3 text-sm leading-6 text-steel">
                  {hubContent.cautionNotes.map((item) => <li class="rounded-2xl bg-slate-50 px-4 py-3">{item}</li>)}
                </ul>
              </Section>
            )
          }
        </div>
      )
    }

    <div class="mt-10 grid gap-6">
      {
        generationCars
          .sort((a, b) => a.data.year - b.data.year)
          .map((car) => (
            <a class="surface block p-6 transition hover:-translate-y-0.5" href={`/cars/${car.id}/`}>
              <p class="eyebrow">{car.data.year}</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink">{car.data.title}</h2>
              <p class="mt-3 text-sm leading-6 text-steel">{car.data.excerpt ?? car.data.description}</p>
            </a>
          ))
      }
    </div>

    <div class="mt-8 space-y-8">
      <RelatedLinks
        title="Problem guides for this generation"
        intro="Start with these if the car is showing the symptoms owners in this generation range run into most often."
        items={featuredProblems}
      />
      <RelatedLinks
        title="Best-parts guides for this generation"
        intro="These parts pages are the fastest way to narrow the shortlist once you know the repair area."
        items={featuredBest}
      />
      <RelatedLinks
        title="Comparison guides for this generation"
        intro="Use these when the next question is which engine, drivetrain, or powertrain version the advice actually applies to."
        items={relatedComparisons}
      />
    </div>
  </div>
</BaseLayout>
